---
import type { Image as SanityImage } from "sanity";
import { fetchSiteSettings } from "../lib/sanity.queries";
import { getOGImageUrl } from "../utils/image";

import "../styles/global.css";

interface Props {
  author?: string;
  bodyStyle?: string;
  description?: string;
  image?: SanityImage;
  title?: string;
}

const { author, bodyStyle, description, image, title } = Astro.props;

const siteSettings = await fetchSiteSettings();

const baseUrl = `https://${siteSettings.hostname}`;
const siteName = siteSettings.title;
const siteDescription = siteSettings.description;
const canonical = baseUrl + Astro.url.pathname;

const siteImage = image
  ? getOGImageUrl(image)
  : `${baseUrl}/images/og-image-white.png`;
const siteTitle = title ? `${title} – ${siteName}` : siteName;
---

<!doctype html>
<html lang="nb">
  <head>
    <title>{siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta content={description || siteDescription} name="description" />
    <link rel="canonical" href={canonical} />
    <meta content="#fcf6ee" name="theme-color" />
    <meta content="summary_large_image" name="twitter:card" />

    <meta content={siteTitle} property="og:title" />
    <meta content={description || siteDescription} property="og:description" />
    <meta content={siteName} property="og:site_name" />
    <meta content={siteImage} property="og:image" />
    <meta content={canonical} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content="nb_NO" property="og:locale" />

    {author && <meta content={author} name="author" />}

    <style is:global>
      @import "../styles/fonts.css";
    </style>
  </head>
  <body style={bodyStyle}>
    <slot />
  </body>

  {
    siteSettings.analytics && (
      <script
        defer
        data-domain={siteSettings.analyticsHostname}
        src="https://plausible.io/js/script.js"
      />
    )
  }
</html>
