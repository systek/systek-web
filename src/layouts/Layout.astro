---
import "../styles/global.css";

interface Props {
  author?: string;
  bodyStyle?: string;
  description?: string;
  image?: string;
  title?: string;
}

const { author, bodyStyle, description, image, title } = Astro.props;

const baseUrl = "https://purple-sand-022b01203.6.azurestaticapps.net"; // todo: use env variable?
const siteTitle = "Systek";
const siteDescription =
  "Hos oss møter du fagfolk som både kan og vil. Vi utforsker, samarbeider og skaper muligheter som gjør en forskjell for mennesker, virksomheter og samfunnet.";
---

<!doctype html>
<html lang="nb">
  <head>
    <title>{title ? `${title} – ${siteTitle}` : siteTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta content={description || siteDescription} name="description" />
    <meta content="#fcf6ee" name="theme-color" />
    <meta content="summary" name="twitter:card" />

    <meta content={title || siteTitle} property="og:title" />
    <meta content={description || siteDescription} property="og:description" />
    <meta content={siteTitle} property="og:site_name" />
    <meta content={image || `${baseUrl}/images/temp.png`} property="og:image" />
    <meta content="website" property="og:type" />
    <meta content="nb_NO" property="og:locale" />

    {author && <meta content={author} name="author" />}

    <style is:global>
      @import "../styles/fonts.css";
    </style>
  </head>
  <body style={bodyStyle}>
    <slot />
  </body>

  <!-- 
  <script
    defer
    data-domain="systek.no"
    src="https://plausible.io/js/script.js"></script>
  -->
</html>
