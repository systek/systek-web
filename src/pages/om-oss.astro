---
import Image from "../components/Image.astro";
import CardLayout from "../components/card/layout/CardLayout.astro";
import CardRightColumn from "../components/card/layout/CardRightColumn.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import Layout from "../layouts/Layout.astro";
import { fetchAboutPage, fetchLocations } from "../lib/sanity.queries";
import { fullWidth, oneHalf, threeFourth } from "../utils/number";
import PortableText from "../components/PortableText.astro";
import WorkHere from "../components/card/WorkHere.astro";
import Article from "../components/Article.astro";
import ImageGallery from "../components/image/ImageGallery.astro";

const about = await fetchAboutPage();
const locations = await fetchLocations();
---

<Layout>
  <Header active="/om-oss" />
  <PageHeader title={about.title} />
  {
    locations && (
      <CardLayout class="border-t border-stroke mx-grid pt-grid mt-section">
        <CardRightColumn title="Kontorer">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
            {locations.map((item) => (
              <div class="group">
                <picture>
                  <Image
                    class="w-full rounded-md object-cover aspect-[4/3]"
                    image={item.image}
                    mode="cover"
                    alt={item.image.alt}
                    width={603}
                    height={452}
                    sizes={`(min-width: 105rem) calc(${oneHalf("lg", threeFourth("lg"))}), (min-width: 50rem) calc(${oneHalf("md")}), calc(${fullWidth("sm")})`}
                  />
                </picture>
                <p class="text-sm-fluid mt-gutter">
                  <>
                    <span class="font-bold">{item.name}</span>
                    <br />
                  </>
                  <>
                    <a
                      class="link-underline"
                      href={item.mapLink}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {item.address}
                    </a>
                    <br />
                  </>
                  {item.address2}
                  <br />
                  {item.phone}
                  <br />
                  <a class="link-underline" href={`mailto:${item.email}}`}>
                    {item.email}
                  </a>
                </p>
              </div>
            ))}
          </div>
        </CardRightColumn>
      </CardLayout>
    )
  }

  <Article class="border-t border-stroke pt-grid mt-page">
    <h2 class="font-light text-2xl-fluid">{about.contentTitle}</h2>
    <PortableText value={about.content} />
  </Article>

  <CardLayout class="border-t border-stroke pt-grid mt-page mx-grid">
    <CardRightColumn title={about.summaryLabel}>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-xl-fluid"
      >
        {about.summaryTitle}
      </p>
    </CardRightColumn>

    <ImageGallery node={about.imageGallery as unknown as any} />
  </CardLayout>

  {
    about.workHere && (
      <WorkHere
        title={about.workHere.title}
        label={about.workHere.label}
        text={about.workHere.description}
        points={about.workHere.points}
        image={about.workHere.image}
      />
    )
  }
  <Footer />
</Layout>
