---
import Arrow from "../../components/Arrow.astro";
import Button from "../../components/Button.astro";
import CardHeader from "../../components/card-layout/CardHeader.astro";
import CardLayout from "../../components/card-layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import CheckIcon from "../../assets/icons/check.svg";
import { mockStaff } from "../../lib/mockStaff";

const staffItems = mockStaff.map((item) => ({
  ...item,
  slug: { current: item.name.toLowerCase().replace(/\s+/g, "-") },
}));

const staffFirstLetter = staffItems
  .map((item) => item.name[0].toUpperCase())
  .filter((value, index, self) => self.indexOf(value) === index);

// See of we can share this with sanity schemaTypes
const staffLocations = [
  { value: "oslo", title: "Oslo" },
  { value: "hamar", title: "Hamar" },
  { value: "grimstad", title: "Grimstad" },
];
const departments = [
  { value: "administration", title: "Administrasjon" },
  { value: "arkitektur", title: "Arkitektur" },
  { value: "analyse", title: "Data og analyse" },
  { value: "design", title: "Design" },
  { value: "plattform", title: "Plattform og sky" },
  { value: "prosjektledelse", title: "Prosjektledelse" },
  { value: "test", title: "Test" },
  { value: "utvikling", title: "Utvikling" },
];
---

<Layout>
  <Header active="/folka" />

  <div class="flex flex-col m-grid gap-section">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <CardLayout>
      <CardHeader title="Folka">
        <p
          class="max-w-[72rem] lg:max-w-[68.6vw] md:pr-20 font-light text-3xl-fluid"
        >
          Møt gjengen vår – den perfekte miksen av flinke folk, nysgjerrige
          eksperter og ekte lagspillere med sans for gode løsninger
        </p>
      </CardHeader>
    </CardLayout>

    <div class="flex justify-between">
      <Arrow position="middleLeft" />
      <Arrow position="middleRight" />
    </div>

    <picture>
      <img
        class="w-full rounded-md aspect-[4/3] lg:aspect-[2/1] object-cover"
        src="/images/temp.png"
        draggable="false"
      />
    </picture>
    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </div>

  <CardLayout class="border-t mt-section mx-grid border-stroke pb-section">
    <div class="lg:col-span-1">
      <div class="flex flex-row gap-6 sticky top-[100px]">
        <dib class="text-3xl-fluid font-light w-30 staff-letter">A</dib>
        <div class="flex flex-col gap-2">
          <p class="font-bold text-sm-fluid">Lokasjon</p>
          <label>
            <input name="location" type="radio" value="" checked /> Alle
          </label>
          {
            staffLocations.map(({ value, title }) => (
              <label>
                <input name="location" type="radio" value={value} /> {title}
              </label>
            ))
          }
          <p class="font-bold text-sm-fluid">Avdeling</p>
          <label>
            <input name="department" type="radio" value="" checked /> Alle
          </label>
          {
            departments.map(({ value, title }) => (
              <label>
                <input name="department" type="radio" value={value} /> {title}
              </label>
            ))
          }
        </div>
      </div>
    </div>
    <div class="lg:col-span-3 flex flex-row gap-4 flex-wrap staff-list">
      {
        staffFirstLetter.map((letter) => (
          <div class="grid grid-cols-4 gap-gutter" data-letter={letter}>
            {staffItems
              .filter((item) => item.name.toUpperCase().startsWith(letter))
              .map((item) => (
                <div
                  class="flex flex-col"
                  data-department={item.department}
                  data-location={item.location}
                >
                  <img
                    class="aspect-[4/3] object-cover rounded-md mb-2"
                    src="/images/temp.png"
                    draggable="false"
                    alt={item.name}
                  />
                  <h3 class="text-base font-bold">{item.name}</h3>
                  <p class="text-sm">{item.position}</p>
                  <p>
                    {item.location} - {item.department}
                  </p>
                </div>
              ))}
          </div>
        ))
      }
    </div>
  </CardLayout>

  <CardLayout class="mt-page mx-grid">
    <CardHeader>
      <p
        class="max-w-[65rem] lg:max-w-[61.9vw] md:pr-20 font-light text-2xl-fluid"
      >
        Vi arrangerer fellesturer, sommerfester, fagdager, sosiale samlinger,
        turneringer og spillkvelder
      </p>
    </CardHeader>

    <div
      class="grid grid-cols-2 gap-gutter mt-section lg:grid-cols-2 lg:col-span-4"
    >
      <div class="flex flex-col gap-gutter lg:flex-row">
        <picture>
          <img
            class="object-cover w-full rounded-md aspect-square"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>

        <picture>
          <img
            class="w-full object-cover rounded-md aspect-square lg:aspect-[4/5]"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>
      </div>

      <div class="flex flex-col gap-gutter lg:flex-row">
        <picture>
          <img
            class="w-full object-cover rounded-md aspect-[4/5] lg:aspect-[4/3]"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>

        <picture>
          <img
            class="w-full object-cover rounded-md aspect-[4/3] lg:aspect-square"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <div class="flex flex-col lg:col-span-2">
      <p class="font-bold text-sm-fluid">Ledige stillinger</p>
      <div class="mt-auto max-w-[37rem] lg:max-w-[35.2vw]">
        <p class="mt-2 font-light text-2xl-fluid">Jobbe i Systek?</p>
        <p class="mt-5 text-md-fluid md:mt-6">
          Vi er interessert å komme i kontakt med hyggelige og kunnskapsrike
          folk som passer til profilen vår og som har lyst til å utvikle
          karrieren sin videre i et spennende fagmiljø.
        </p>

        <ul class="mt-4 text-text-secondary">
          <li class="flex items-center gap-2">
            <CheckIcon class="size-4" />
            <p class="text-sm-fluid">Fleksibilitet og frihet</p>
          </li>
          <li class="flex items-center gap-2">
            <CheckIcon class="size-4" />
            <p class="text-sm-fluid">Flinke kollegaer</p>
          </li>
          <li class="flex items-center gap-2">
            <CheckIcon class="size-4" />
            <p class="text-sm-fluid">Flat struktur</p>
          </li>
        </ul>

        <div class="flex items-center mt-6 gap-grid md:mt-8">
          <Button href="https://systek.homerun.co">Se ledige stillinger</Button>
          <a
            class="link-underline text-sm-fluid"
            href="https://systek.homerun.co"
          >
            Se kontakt-siden
          </a>
        </div>
      </div>
    </div>
    <div class="mt-10 lg:col-span-2 lg:mt-0">
      <picture>
        <img
          class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </CardLayout>

  <script>
    import "../../utils/staff";
    import { filterSetup } from "../../utils/staff-filter";

    document.addEventListener("DOMContentLoaded", () => {
      const staffItems = [
        ...document.querySelectorAll(".staff-list [data-department]"),
      ] as HTMLElement[];
      const locationRadio = [
        ...document.querySelectorAll<HTMLInputElement>(
          "input[name='location']",
        ),
      ];
      const departmentRadio = [
        ...document.querySelectorAll<HTMLInputElement>(
          "input[name='department']",
        ),
      ];
      if (staffItems && locationRadio && departmentRadio) {
        filterSetup(staffItems, locationRadio, departmentRadio);
      }
    });
  </script>
  <Footer />
</Layout>
