---
import Button from "../../components/Button.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import CheckIcon from "../../assets/icons/check.svg";
import Accordion from "../../components/accordion/Accordion.astro";
import AccordionItem from "../../components/accordion/AccordionItem.astro";
import Radio from "../../components/Radio.astro";
import {
  fetchLocations,
  fetchServiceItemsAll,
  fetchStaffItems,
  fetchStaffSingleton,
} from "../../lib/sanity.queries";
import Image from "../../components/Image.astro";
import PageHeader from "../../components/PageHeader.astro";
import ImageGallery from "../../components/image/ImageGallery.astro";
import { oneFourth, oneHalf, threeFourth, vw } from "../../utils/number";

const [staffPage, staffItems, services, locations] = await Promise.all([
  fetchStaffSingleton(),
  fetchStaffItems(),
  fetchServiceItemsAll(),
  fetchLocations(),
]);

const staffByInitial = staffItems.reduce(
  (acc, item) => {
    const initial = item.name[0].toUpperCase();
    if (!acc[initial]) {
      acc[initial] = [];
    }
    acc[initial].push(item);
    return acc;
  },
  {} as { [key: string]: typeof staffItems }
);
---

<Layout title="Folka">
  <Header active="/folka" />

  <PageHeader image={staffPage.heroImage}>
    <CardLayout>
      <CardRightColumn title="Folka">
        <p
          class="max-w-[72rem] lg:max-w-[68.571vw] md:mr-20 lg:mr-[4.7619vw] font-light text-3xl-fluid"
        >
          {staffPage.title}
        </p>
      </CardRightColumn>
    </CardLayout>
  </PageHeader>

  <div
    class="grid gap-section mt-section mx-grid relative lg:pb-section lg:min-h-dvh"
  >
    <div
      class="lg:z-[var(--z-filter)] lg:absolute lg:top-0 lg:bottom-0 lg:right-[calc(75%+16px)] lg:w-auto lg:min-w-[15.298vw]"
    >
      <div class="lg:sticky lg:top-[calc(var(--height-header)+8px)]">
        <div>
          <Accordion class="lg:border-t-0">
            <AccordionItem open title="Lokasjon">
              <div class="flex flex-col gap-2">
                <Radio name="location" label="Vis alle" value="all" checked />
                {
                  locations.map((location) => (
                    <Radio
                      name="location"
                      label={location.name}
                      value={location.slug.current}
                    />
                  ))
                }
              </div>
            </AccordionItem>
            <AccordionItem open title="Avdeling">
              <div class="flex flex-col gap-2">
                <Radio name="department" label="Vis alle" value="all" checked />
                {
                  services.map((service) => (
                    <Radio
                      name="department"
                      label={service.title}
                      value={service.slug.current}
                    />
                  ))
                }
              </div>
            </AccordionItem>
          </Accordion>
        </div>
      </div>
    </div>

    {
      Object.entries(staffByInitial).map(([initial, staffList]) => (
        <div class="grid gap-gutter lg:grid-cols-4" data-letter={initial}>
          <div class="hidden lg:block">
            <p class="sticky top-[calc(var(--height-header)+8px)] text-4xl-fluid my-4">
              {initial}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-x-gutter gap-y-section lg:col-span-3 md:grid-cols-4">
            {staffList.map((item) => (
              <div
                data-location={item.location?.slug.current || "none"}
                data-department={item.serviceType?.slug.current || "none"}
                class="flex flex-col gap-2 lg:gap-4"
              >
                <picture class="aspect-square overflow-hidden">
                  <Image
                    alt={item.name}
                    class="w-full aspect-square object-cover rounded-md"
                    image={item.image}
                    mode="cover"
                    width={291}
                    height={291}
                    sizes={`(min-width: 105rem) calc(${oneFourth("lg", threeFourth("lg"))}), (min-width: 50rem) calc(${oneFourth("md")}), calc(${oneHalf("sm")})`}
                  />
                </picture>

                <div>
                  <p class="text-sm-fluid font-bold leading-snug">
                    {item.name}
                  </p>
                  <p class="text-sm-fluid leading-snug">{item.position}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <CardLayout class="mt-page mx-grid">
    <CardRightColumn>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        Vi arrangerer fellesturer, sommerfester, fagdager, sosiale samlinger,
        turneringer og spillkvelder
      </p>
    </CardRightColumn>

    <ImageGallery node={staffPage.imageGallery as unknown as any} />
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <div class="flex flex-col lg:col-span-2">
      <p class="font-bold text-sm-fluid">Ledige stillinger</p>
      <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
        <p class="mt-gap font-light text-2xl-fluid">Jobbe i Systek?</p>
        <p class="mt-grid text-md-fluid md:mt-6">
          Vi er interessert å komme i kontakt med hyggelige og kunnskapsrike
          folk som passer til profilen vår og som har lyst til å utvikle
          karrieren sin videre i et spennende fagmiljø.
        </p>

        <ul class="my-grid text-text-secondary">
          <li class="flex items-center gap-2">
            <CheckIcon class="size-4 lg:size-[0.952vw]" />
            <p class="text-sm-fluid">Fleksibilitet og frihet</p>
          </li>
          <li class="flex items-center gap-2">
            <CheckIcon class="size-4 lg:size-[0.952vw]" />
            <p class="text-sm-fluid">Flinke kollegaer</p>
          </li>
          <li class="flex items-center gap-2">
            <CheckIcon class="size-4 lg:size-[0.952vw]" />
            <p class="text-sm-fluid">Flat struktur</p>
          </li>
        </ul>

        <div class="flex items-center my-grid gap-grid">
          <Button href="https://systek.homerun.co">Se ledige stillinger</Button>
          <a
            class="link-underline text-sm-fluid"
            href="https://systek.homerun.co"
          >
            Se kontakt-siden
          </a>
        </div>
      </div>
    </div>
    <div class="mt-section-sm md:mt-section-md lg:mt-0 lg:col-span-2">
      <picture>
        <img
          class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
          src="/images/temp.png"
        />
      </picture>
    </div>
  </CardLayout>

  <Footer />
</Layout>

<script>
  import {
    setHeaderSize,
    setupRadios,
    toggleLetterVisibility,
    toggleStaffVisibility,
  } from "../../utils/staff";
  import { DOMLoaded, handleResize, widthChecker } from "../../utils/utils";

  DOMLoaded(() => {
    const header = document.querySelector("[data-header]") as HTMLElement;
    const staff = document.querySelectorAll<HTMLElement>("[data-location]");
    const letters = document.querySelectorAll<HTMLElement>("[data-letter]");
    const locationRadios = document.querySelectorAll<HTMLInputElement>(
      'input[name="location"]'
    );
    const departmentRadios = document.querySelectorAll<HTMLInputElement>(
      'input[name="department"]'
    );
    const hasViewportWidthChanged = widthChecker();
    const filterValues: { key: string; value: string }[] = [
      {
        key: "location",
        value: "all",
      },
      {
        key: "department",
        value: "all",
      },
    ];

    function consolidate() {
      staff.forEach((staffEl) => toggleStaffVisibility(staffEl, filterValues));

      letters.forEach((letter) => {
        const children =
          letter.querySelectorAll<HTMLElement>("[data-location]");
        toggleLetterVisibility(letter, children);
      });
    }

    setupRadios("location", locationRadios, filterValues, consolidate);
    setupRadios("department", departmentRadios, filterValues, consolidate);

    setHeaderSize(header);

    handleResize(() => {
      if (hasViewportWidthChanged()) {
        setHeaderSize(header);
      }
    });

    // todo: accordionItem "Avdelinger" should be closed on mobile
  });
</script>
