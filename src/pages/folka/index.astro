---
import clsx from "clsx";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Accordion from "../../components/accordion/Accordion.astro";
import AccordionItem from "../../components/accordion/AccordionItem.astro";
import Radio from "../../components/Radio.astro";
import {
  fetchLocations,
  fetchServiceItemsAll,
  fetchStaffItems,
  fetchStaffSingleton,
} from "../../lib/sanity.queries";
import Image from "../../components/Image.astro";
import PageHeader from "../../components/PageHeader.astro";
import ImageGallery from "../../components/image/ImageGallery.astro";
import WorkHere from "../../components/card/WorkHere.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";

const [staffPage, staffItems, services, locations] = await Promise.all([
  fetchStaffSingleton(),
  fetchStaffItems(),
  fetchServiceItemsAll(),
  fetchLocations(),
]);

const staffByInitial = staffItems.reduce(
  (acc, item) => {
    const initial = item.name[0].toUpperCase();
    if (!acc[initial]) {
      acc[initial] = [];
    }
    acc[initial].push(item);
    return acc;
  },
  {} as { [key: string]: typeof staffItems }
);
---

<Layout description={staffPage.title} title="Folka" image={staffPage.heroImage}>
  <Header active="/folka" />

  <PageHeader image={staffPage.heroImage}>
    <CardLayout>
      <CardRightColumn title="Folka" titleAs="h1">
        <h2
          class="text-3xl-fluid max-w-[72rem] font-light md:mr-20 lg:mr-[4.7619vw] lg:max-w-[68.571vw]"
        >
          {staffPage.title}
        </h2>
      </CardRightColumn>
    </CardLayout>
  </PageHeader>

  <div
    class="gap-section mt-section mx-grid lg:pb-section relative grid lg:min-h-dvh"
  >
    <div
      class="lg:absolute lg:top-0 lg:right-[calc(75%+16px)] lg:bottom-0 lg:z-[var(--z-filter)] lg:w-auto lg:min-w-[15.298vw]"
    >
      <div class="lg:sticky lg:top-[calc(var(--height-header)+8px)]">
        <div>
          <Accordion class="lg:border-t-0">
            <AccordionItem open title="Lokasjon">
              <div class="gap-gap flex flex-col">
                <Radio name="location" label="Vis alle" value="all" checked />
                {
                  locations.map((location) => (
                    <Radio
                      name="location"
                      label={location.name}
                      value={location.slug.current}
                    />
                  ))
                }
              </div>
            </AccordionItem>
            <AccordionItem open title="Avdeling">
              <div class="gap-gap flex flex-col">
                <Radio name="department" label="Vis alle" value="all" checked />
                {
                  services.map((service) => (
                    <Radio
                      name="department"
                      label={service.title}
                      value={service.slug.current}
                    />
                  ))
                }
              </div>
            </AccordionItem>
          </Accordion>
        </div>
      </div>
    </div>

    {
      Object.entries(staffByInitial).map(([initial, staffList]) => (
        <div class="gap-gutter grid lg:grid-cols-4" data-letter={initial}>
          <div class="hidden lg:block">
            <p class="text-4xl-fluid sticky top-[calc(var(--height-header)+8px)] my-4">
              {initial}
            </p>
          </div>

          <div class="gap-x-gutter gap-y-section grid grid-cols-2 md:grid-cols-4 lg:col-span-3">
            {staffList.map((item) => (
              <div
                data-location={item.location?.slug.current || "none"}
                data-department={item.serviceType?.slug.current || "none"}
                class="gap-gap group flex flex-col"
              >
                <picture class="aspect-square overflow-hidden">
                  <Image
                    alt=""
                    class={clsx(
                      "aspect-square w-full rounded-md",
                      item.imageSecondary && "group-hover:hidden"
                    )}
                    image={item.image}
                    width={500}
                    height={500}
                    sizes="(min-width: 105rem) 18.75vw, (min-width: 50rem) 25vw, 50vw"
                  />

                  <Image
                    alt=""
                    class="hidden aspect-square w-full rounded-md group-hover:block"
                    image={item.imageSecondary}
                    width={500}
                    height={500}
                    sizes="(min-width: 105rem) 18.75vw, (min-width: 50rem) 25vw, 50vw"
                    loading="eager"
                  />
                </picture>

                <div>
                  <p class="text-sm-fluid leading-snug font-bold">
                    {item.name}
                  </p>
                  <p class="text-sm-fluid leading-snug">{item.position}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <CardLayout class="mt-page mx-grid">
    <CardRightColumn>
      <CardTitle titleAs="h2">
        Vi arrangerer fellesturer, sommerfester, fagdager, sosiale samlinger,
        turneringer og spillkvelder
      </CardTitle>
    </CardRightColumn>

    <ImageGallery node={staffPage.imageGallery as unknown as any} />
  </CardLayout>

  {
    staffPage.workHere && (
      <WorkHere
        title={staffPage.workHere.title}
        label={staffPage.workHere.label}
        text={staffPage.workHere.description}
        points={staffPage.workHere.points}
        image={staffPage.workHere.image}
      />
    )
  }

  <Footer />
</Layout>

<script>
  import {
    setupRadios,
    toggleLetterVisibility,
    toggleStaffVisibility,
  } from "../../utils/staff";
  import { DOMLoaded } from "../../utils/utils";

  DOMLoaded(() => {
    const staff = document.querySelectorAll<HTMLElement>("[data-location]");
    const letters = document.querySelectorAll<HTMLElement>("[data-letter]");
    const locationRadios = document.querySelectorAll<HTMLInputElement>(
      'input[name="location"]'
    );
    const departmentRadios = document.querySelectorAll<HTMLInputElement>(
      'input[name="department"]'
    );
    const filterValues: { key: string; value: string }[] = [
      {
        key: "location",
        value: "all",
      },
      {
        key: "department",
        value: "all",
      },
    ];

    function callback() {
      staff.forEach((staffEl) => toggleStaffVisibility(staffEl, filterValues));

      letters.forEach((letter) => {
        const children =
          letter.querySelectorAll<HTMLElement>("[data-location]");
        toggleLetterVisibility(letter, children);
      });
    }

    setupRadios("location", locationRadios, filterValues, callback);
    setupRadios("department", departmentRadios, filterValues, callback);

    // todo: accordionItem "Avdelinger" should be closed on mobile
  });
</script>
