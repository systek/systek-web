---
import { sanityClient } from "sanity:client";
import clsx from "clsx";

import ExternalIcon from "../../assets/icons/external.svg";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import Image from "../../components/Image.astro";
import Citation from "../../components/card/Citation.astro";
import type {
  Citation as CitationType,
  Service,
  Work,
  Vacancies,
} from "../../lib/sanity.types";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import Button from "../../components/Button.astro";
import Contact from "../../components/card/Contact.astro";
import { getOGImageUrl } from "../../utils/image";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";
import Article from "../../components/Article.astro";
import { fullWidth, gutter, oneHalf, threeFourth, vw } from "../../utils/number";

type PageType = Omit<Service, "citation" | "works"> & {
  citation: CitationType;
  works?: Work[];
};

export async function getStaticPaths() {
  const services: PageType[] = await sanityClient.fetch(`*[_type == "service"] {
    _id,
    slug,
    title,
    heroImage,
    content,
    citation->,
    works[]->,
    contact,
  }`);
  return services.map((service) => ({
    params: { slug: service.slug.current },
    props: { service },
  }));
}
const { service } = Astro.props as {
  service: PageType;
};

const vacancies: Vacancies[] = await sanityClient.fetch(
  `*[_type == "vacancies" && service._ref == $serviceId]{
    title,
    date,
    location,
    description,
    href
  }`,
  { serviceId: service._id }
);
---

<Layout
  title={service.title}
  description={service.description}
  image={service.heroImage?.asset?._ref &&
    getOGImageUrl(service.heroImage.asset._ref)}
>
  <Header />

  <PageHeader image={service.heroImage} title={service.title} />

  <Article>
    <PortableText value={service.content} />
  </Article>

  {
    service.citation && (
      <Citation
        title="Tjenester"
        citation={service.citation as unknown as CitationType}
      />
    )
  }

  {
    service.works && (
      <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
        <CardRightColumn title="Arbeider">
          <p class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid">
            Relaterte arbeider innen {service.title.toLowerCase()}
          </p>
          <Button class="mt-grid" href="/arbeider">
            Se alle arbeider
          </Button>
        </CardRightColumn>

        <div />
        <div class="grid lg:col-span-3 md:grid-cols-2 gap-gutter mt-section">
          {service.works.map((item) => (
            <a class="group" href={item.slug.current}>
              <picture>
                <Image
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  image={item.image}
                  mode="cover"
                  alt={item.image.alt}
                  width={603}
                  height={452}
                  sizes={`(min-width: 105rem) calc(${oneHalf('lg', threeFourth("lg"))}), (min-width: 50rem) calc(${oneHalf("md")}), calc(${fullWidth("sm")})`}
                />
              </picture>
              <p class="mt-gap font-bold text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))}
        </div>
      </CardLayout>
    )
  }

{vacancies.length > 0 && (
  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Ledige stillinger">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        Vil du bli en del et 100% ansatteid selskap drevet av dyktige kolleger i
        et tverrfaglig miljø?
      </p>
    </CardRightColumn>

    <div class="mt-section lg:col-span-4">
      <!-- seperate markup for mobile and desktop -->
      <div
        class="flex justify-between py-4 border-b md:hidden gap-gutter border-stroke"
      >
        <p class="font-bold text-xs-fluid">Søknad</p>
        <p class="font-bold text-xs-fluid">Frist</p>
      </div>

      <div
        class="hidden grid-cols-4 py-4 border-b md:grid gap-gutter border-stroke"
      >
        <p class="font-bold text-xs-fluid">Stillingstittel</p>
        <p class="font-bold text-xs-fluid">Frist</p>
        <p class="font-bold text-xs-fluid">Sted</p>
        <p class="font-bold text-xs-fluid">Søknad</p>
      </div>
      {
        vacancies.map((item, index) => {
          const date = item.date ? new Date(item.date) : undefined;
          const formatedDate = date ? formatDate(date) : "Løpende";
          const expired = date ? date < new Date() : false;
          return (
            <div>
              <div
                class={clsx(
                  "flex md:hidden justify-between items-center py-4 border-b gap-gutter border-stroke",
                  { "line-through": expired }
                )}
              >
                <a
                  href={item.href}
                  class="flex items-center gap-1 link-underline"
                >
                  <ExternalIcon class="size-2.5 lg:size-[0.595vw]" />
                  <p class="text-xs-fluid">{item.title}</p>
                </a>

                <p class="text-xs-fluid">{formatedDate}</p>
              </div>

              <div class="hidden grid-cols-4 py-4 border-b md:grid gap-gutter border-stroke">
                <p class="text-xs-fluid">{item.title}</p>
                <p class="text-xs-fluid">{formatedDate}</p>
                <p class="text-xs-fluid">{item.location}</p>
                <p class="text-xs-fluid">
                  <Button size="sm" href={item.href}>
                    Se stillingsinstruks
                  </Button>
                </p>
              </div>
            </div>
          );
        })
      }

      <div class="hidden ml-[25%] mt-grid md:block">
        <Button href="https://systek.homerun.co">
          Se alle ledige stillinger
        </Button>
      </div>
    </div>
  </CardLayout>
  )}

  {
    service.contact && (
      <Contact
        button={`Send ${service.contact.name} en e-post`}
        email={service.contact.email}
        label="Kontakt"
        title={service.contact.title}
        text={service.contact.description}
        image={service.contact.image}
      />
    )
  }

  <Footer />
</Layout>
