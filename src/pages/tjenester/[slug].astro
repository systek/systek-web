---
import { sanityClient } from "sanity:client";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import SanityImage from "../../components/SanityImage.astro";
import Arrow from "../../components/Arrow.astro";
import type { Service } from "../../lib/sanity.types";

export async function getStaticPaths() {
  const services = await sanityClient.fetch(`*[_type == "service"] { ... }`);
  return services.map((service: any) => ({
    params: { slug: service.slug.current },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };
---

<Layout>
  <Header />

  <div class="flex flex-col m-grid gap-section">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <h1 class="font-light text-4xl-fluid hyphens-auto md:text-center">
      {service.title}
    </h1>

    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </div>

  <div class="mx-grid">
    <picture>
      <SanityImage
        class="w-full rounded-md aspect-[1.33/1] md:aspect-[2/1] object-cover"
        node={service.heroImage}
        alt={service.heroImage?.alt || service.title}
        draggable={false}
      />
    </picture>
  </div>

  <div class="mx-grid mt-section">
    <div class="mx-auto max-w-[50rem] lg:max-w-[47.6vw]">
      <PortableText value={service.content} />
    </div>
  </div>

  <Footer />
</Layout>
