---
import { sanityClient } from "sanity:client";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import Image from "../../components/Image.astro";
import Citation from "../../components/card/Citation.astro";
import type {
  Citation as CitationType,
  Service,
  Work,
  Vacancies as VacanciesType,
} from "../../lib/sanity.types";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import Button from "../../components/Button.astro";
import Contact from "../../components/card/Contact.astro";
import { getOGImageUrl } from "../../utils/image";
import PageHeader from "../../components/PageHeader.astro";
import Article from "../../components/Article.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";
import Vacancies from "../../components/Vacancies.astro";

type PageType = Omit<Service, "citation" | "works"> & {
  citation: CitationType;
  works?: Work[];
};

export async function getStaticPaths() {
  const services: PageType[] = await sanityClient.fetch(`*[_type == "service"] {
    _id,
    slug,
    title,
    heroImage,
    content,
    citation->,
    works[]->,
    contact,
  }`);
  return services.map((service) => ({
    params: { slug: service.slug.current },
    props: { service },
  }));
}
const { service } = Astro.props as {
  service: PageType;
};

const vacancies: VacanciesType[] = await sanityClient.fetch(
  `*[_type == "vacancies" && service._ref == $serviceId]{
    title,
    date,
    location,
    description,
    href
  }`,
  { serviceId: service._id }
);
---

<Layout
  title={service.title}
  description={service.description}
  image={service.heroImage?.asset?._ref &&
    getOGImageUrl(service.heroImage.asset._ref)}
>
  <Header />

  <PageHeader image={service.heroImage} title={service.title} />

  <Article>
    <PortableText value={service.content} />
  </Article>

  {
    service.citation && (
      <Citation
        title="Tjenester"
        citation={service.citation as unknown as CitationType}
      />
    )
  }

  {
    service.works && (
      <CardLayout class="mt-page mx-grid pt-grid border-t border-stroke">
        <CardRightColumn title="Arbeider">
          <CardTitle>
            Relaterte arbeider innen {service.title.toLowerCase()}
          </CardTitle>
          <Button class="mt-grid" href="/arbeider">
            Se alle arbeider
          </Button>
        </CardRightColumn>

        <div />
        <div class="gap-gutter mt-section grid md:grid-cols-2 lg:col-span-3">
          {service.works.map((item) => (
            <a class="group" href={`/arbeider/${item.slug.current}`}>
              <picture>
                <Image
                  class="aspect-[4/3] w-full rounded-md"
                  image={item.image}
                  alt={item.image.alt}
                  width={1000}
                  height={750}
                  sizes={`(min-width: 105rem) 37.5vw, (min-width: 50rem) 50vw, 100vw`}
                />
              </picture>
              <p class="mt-gap text-md-fluid group-link-underline font-bold">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))}
        </div>
      </CardLayout>
    )
  }

  {vacancies.length > 0 && <Vacancies vacancies={vacancies} />}

  {
    service.contact && (
      <Contact
        button={`Send ${service.contact.name} en e-post`}
        email={service.contact.email}
        label="Kontakt"
        title={service.contact.title}
        text={service.contact.description}
        image={service.contact.image}
      />
    )
  }

  <Footer />
</Layout>
