---
import type { InferGetStaticPropsType } from "astro";
import {
  fetchServicePages,
  fetchServiceVacancies,
} from "../../lib/sanity.queries";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import Image from "../../components/Image.astro";
import Citation from "../../components/card/Citation.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import Button from "../../components/Button.astro";
import Contact from "../../components/card/Contact.astro";
import PageHeader from "../../components/PageHeader.astro";
import Article from "../../components/Article.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";
import Vacancies from "../../components/Vacancies.astro";
import { getDescription } from "../../utils/string";

export async function getStaticPaths() {
  const services = await fetchServicePages();
  return services.map((service) => ({
    params: { slug: service.slug.current },
    props: { service },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { service } = Astro.props;

const vacancies = await fetchServiceVacancies(service._id);
---

<Layout
  title={service.title}
  description={getDescription(service.plainContent)}
  image={service.heroImage}
>
  <Header />

  <PageHeader image={service.heroImage} title={service.title} />

  <Article>
    <PortableText value={service.content} />
  </Article>

  {service.citation && (
    <Citation title="Tjenester" citation={service.citation} />
  )}

  {service.works && (
    <CardLayout class="mt-page mx-grid pt-grid border-t border-stroke">
      <CardRightColumn title="Arbeider">
        <CardTitle>
          Relaterte arbeider innen {service.title.toLowerCase()}
        </CardTitle>
        <Button class="mt-grid" href="/arbeider">
          {" "}
          Se alle arbeider{" "}
        </Button>
      </CardRightColumn>

      <div />
      <div class="gap-gutter mt-section grid md:grid-cols-2 lg:col-span-3">
        {service.works.map((item) => (
          <a class="group" href={`/arbeider/${item.slug.current}`}>
            <Image
              class="aspect-4/3 w-full rounded-md"
              image={item.image}
              alt={item.image.alt}
              width={1000}
              height={750}
              sizes="(min-width: 80rem) 37.5vw, (min-width: 50rem) 50vw, 100vw"
            />
            <h4 class="mt-gap text-md-fluid group-link-underline font-bold">
              {item.title}
            </h4>
            <p class="text-md-fluid">{item.description}</p>
          </a>
        ))}
      </div>
    </CardLayout>
  )}

  {vacancies.length > 0 && <Vacancies vacancies={vacancies} />}

  {service.contact && (
    <Contact
      button={`Send ${service.contact.name} en e-post`}
      email={service.contact.email}
      label="Kontakt"
      title={service.contact.title}
      text={service.contact.description}
      image={service.contact.image}
    />
  )}

  <Footer />
</Layout>
