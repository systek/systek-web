---
import { sanityClient } from "sanity:client";
import clsx from "clsx";

import ExternalIcon from "../../assets/icons/external.svg";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import SanityImage from "../../components/SanityImage.astro";
import Arrow from "../../components/Arrow.astro";
import type { Service, Work } from "../../lib/sanity.types";
import CardLayout from "../../components/card-layout/CardLayout.astro";
import Button from "../../components/Button.astro";
import CardHeader from "../../components/card-layout/CardHeader.astro";

export async function getStaticPaths() {
  const services = await sanityClient.fetch(`*[_type == "service"] { ... }`);
  return services.map((service: any) => ({
    params: { slug: service.slug.current },
    props: { service },
  }));
}
const { service } = Astro.props as { service: Service };

// todo update service document (schema.json): add field "work" with 2 work items
const workItems: Work[] | undefined =
  await sanityClient.fetch(`*[_type == "work" && defined(slug)] | order(order asc)[0...2] {
    _id,
    title,
    description,
    slug,
    image
  }`);

// todo: infer this when making Vacancy document
const vacancies = [
  {
    title: "UX designer",
    date: "1. september",
    location: "Grimstad",
    description:
      "We are looking for a skilled frontend developer to join our team.",
    href: "/",
  },
  {
    title: "Åpen søknad",
    date: undefined,
    location: "Oslo, Hamar, Grimstad",
    description:
      "Join us as a backend developer and work on exciting projects.",
    href: "/",
  },
];
---

<Layout>
  <Header />

  <div class="flex flex-col m-grid gap-section">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <h1 class="font-light text-4xl-fluid hyphens-auto md:text-center">
      {service.title}
    </h1>

    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </div>

  <div class="mx-grid">
    <picture>
      <SanityImage
        class="w-full rounded-md aspect-[1.33/1] md:aspect-[2/1] object-cover"
        node={service.heroImage}
        alt={service.heroImage?.alt || service.title}
        draggable={false}
      />
    </picture>
  </div>

  <div class="mx-grid mt-section">
    <div class="mx-auto max-w-[50rem] lg:max-w-[47.6vw]">
      <PortableText value={service.content} />
    </div>
  </div>

  {
    workItems && workItems.length > 0 && (
      <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
        <CardHeader title="Arbeider">
          <p class="max-w-[65rem] lg:max-w-[61.9vw] md:pr-20 font-light text-2xl-fluid">
            Relaterte arbeider innen {service.title.toLowerCase()}
          </p>
          {/* check if change sm: -> md: is correct */}
          <Button class="mt-6 sm:mt-7" href="/arbeider">
            Se alle arbeider
          </Button>
        </CardHeader>

        <div />
        <div class="grid grid-cols-1 lg:col-span-3 md:grid-cols-2 gap-gutter mt-section">
          {workItems.map((item) => (
            <a class="group" href={item.slug.current}>
              <picture>
                <SanityImage
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  node={item.image}
                  alt={item.image.alt}
                  draggable="false"
                />
              </picture>
              <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))}
        </div>
      </CardLayout>
    )
  }

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Ledige stillinger">
      <p
        class="max-w-[65rem] lg:max-w-[61.9vw] md:pr-20 font-light text-2xl-fluid"
      >
        Vil du bli en del et 100% ansatteid selskap drevet av dyktige kolleger i
        et tverrfaglig miljø?
      </p>
    </CardHeader>

    <div class="mt-section lg:col-span-4">
      <!-- seperate markup for mobile and desktop -->
      <div
        class="flex justify-between py-4 border-b md:hidden gap-gutter border-stroke"
      >
        <p class="font-bold text-xs-fluid">Søknad</p>
        <p class="font-bold text-xs-fluid">Frist</p>
      </div>

      <div
        class="hidden grid-cols-4 py-4 border-b md:grid gap-gutter border-stroke"
      >
        <p class="font-bold text-xs-fluid">Stilling</p>
        <p class="font-bold text-xs-fluid">Frist</p>
        <p class="font-bold text-xs-fluid">Sted</p>
        <p class="font-bold text-xs-fluid">Søknad</p>
      </div>
      <!-- todo: add logic for line through, format date -->
      {
        vacancies.map((item, index) => (
          <div>
            <div
              class={clsx(
                "flex md:hidden justify-between items-center py-4 border-b gap-gutter border-stroke",
                index > 1 && "line-through",
              )}
            >
              <a
                href={item.href}
                class="flex items-center gap-2 link-underline"
              >
                <ExternalIcon class="size-2.5" />
                <p class="text-xs-fluid">{item.title}</p>
              </a>

              <p class="text-xs-fluid">{item.date}</p>
            </div>

            <div class="hidden grid-cols-4 py-4 border-b md:grid gap-gutter border-stroke">
              <p class="text-xs-fluid">{item.title}</p>
              <p class="text-xs-fluid">{item.date}</p>
              <p class="text-xs-fluid">{item.location}</p>
              <p class="text-xs-fluid">
                <Button size="sm" href={item.href}>
                  Se stillingsinstruks
                </Button>
              </p>
            </div>
          </div>
        ))
      }

      <div class="hidden ml-[25%] mt-6 md:block">
        <Button href="https://systek.homerun.co">
          Se alle ledige stillinger
        </Button>
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <div class="flex flex-col lg:col-span-2">
      <p class="font-bold text-sm-fluid">Kontakt</p>
      <div class="mt-auto max-w-[37rem] lg:max-w-[35.2vw]">
        <p class="mt-2 font-light text-2xl-fluid">
          Si hei til vår avdelingsleder, Tommy!
        </p>
        <p class="mt-5 text-md-fluid md:mt-6">
          Om du er faglig dyktig, brenner for det du jobber med og har lyst til
          å være en del av et miljø hvor kunnskap, nysgjerrighet og inkludering
          er viktig, så vil vi gjerne snakke med deg!
        </p>

        <div class="flex items-center mt-6 gap-grid md:mt-8">
          <Button href="mailto:tommy.madsen@systek.no">
            Send Tommy en e-post
          </Button>
          <a
            class="link-underline text-sm-fluid"
            href="https://systek.homerun.co"
          >
            Se kontakt-siden
          </a>
        </div>
      </div>
    </div>
    <div class="mt-10 lg:col-span-2 lg:mt-0">
      <picture>
        <img
          class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </CardLayout>

  <Footer />
</Layout>
