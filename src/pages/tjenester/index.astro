---
import GridListItem from "../../components/grid-list/GridListItem.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import Citation from "../../components/card/Citation.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import {
  fetchServiceItems,
  fetchServicesSingleton,
} from "../../lib/sanity.queries";
import Contact from "../../components/card/Contact.astro";
import Image from "../../components/Image.astro";
import type { Citation as CitationType } from "../../lib/sanity.types";
import GridList from "../../components/grid-list/GridList.astro";

const [servicesInfo, serviceItems] = await Promise.all([
  fetchServicesSingleton(),
  fetchServiceItems(),
]);
---

<Layout
  description={servicesInfo.description}
  title="Tjenester"
  image={servicesInfo.heroImage}
>
  <Header active="/tjenester" />

  <div
    id="main-content"
    class="mx-grid mt-section grid scroll-mt-(--height-header) lg:grid-cols-2"
  >
    <div class="grid h-48 grid-cols-[1fr_auto_1fr] grid-rows-[0_auto_1fr] md:h-80 lg:order-2 lg:h-auto lg:grid-cols-2 lg:grid-rows-[1fr_auto_2fr]">
      <h1 class="text-4xl-fluid col-start-2 row-start-2 rounded-sm bg-yellow px-1 py-1 font-light md:px-3 md:py-2 lg:justify-self-start">
        Tjenester
      </h1>
      <div class="col-span-2 col-start-1 row-start-3 min-h-0 p-1 lg:col-span-1 lg:row-span-2 lg:row-start-2">
        <svg
          class="pointer-events-none h-full w-full stroke-blue-dark"
          viewBox="0 0 402 362"
          preserveAspectRatio="none"
        >
          <line
            x1="0"
            y1="362"
            x2="402"
            y2="0"
            stroke="inherit"
            stroke-width="2"
            vector-effect="non-scaling-stroke"
          />
        </svg>
      </div>
    </div>

    <div>
      <picture>
        <Image
          class="aspect-4/3 w-full rounded-md"
          image={servicesInfo.heroImage}
          alt={servicesInfo.heroImage.alt}
          width={2000}
          height={1500}
          sizes="(min-width: 80rem) 50vw, 100vw"
        />
      </picture>
    </div>
  </div>

  <CardLayout class="mt-section mx-grid">
    <CardRightColumn>
      <h2 class="text-2xl-fluid max-w-260 font-light md:mr-[4.7619vw] lg:max-w-[61.905vw]">
        {servicesInfo.description}
      </h2>

      <div class="mt-section">
        <picture>
          <Image
            alt={servicesInfo.secondaryImage.alt}
            class="hidden aspect-2/1 w-full rounded-md md:block lg:rounded-lg"
            image={servicesInfo.secondaryImage}
            width={2000}
            height={1000}
            sizes="(min-width: 80rem) 75vw, 100vw"
          />
          <Image
            alt={servicesInfo.secondaryImage.alt}
            class="block aspect-4/3 w-full rounded-md md:hidden"
            image={servicesInfo.secondaryImage}
            width={1000}
            height={750}
            sizes="100vw"
          />
        </picture>
      </div>

      <GridList class="mt-section">
        {serviceItems.map((item) => (
          <GridListItem
            href={`/tjenester/${item.slug.current}`}
            title={item.title}
          >
            <p class="text-sm-fluid">{item.description}</p>
          </GridListItem>
        ))}
      </GridList>
    </CardRightColumn>
  </CardLayout>

  {servicesInfo.citations && (
    <Citation
      href="/tjenester/design-og-brukeropplevelse"
      title="Tjenester"
      citation={servicesInfo.citations as unknown as CitationType}
      buttonText="Les om tjenesten"
      title="Design og brukeropplevelse"
    />
  )}

  {servicesInfo.contact && (
    <Contact
      button={`Send ${servicesInfo.contact.name} en e-post`}
      email={servicesInfo.contact.email}
      label="Kontakt"
      title={servicesInfo.contact.title}
      text={servicesInfo.contact.description}
      image={servicesInfo.contact.image}
    />
  )}

  <Footer />
</Layout>
