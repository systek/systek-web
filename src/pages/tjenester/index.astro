---
import Button from "../../components/Button.astro";
import Card from "../../components/card-layout/Card.astro";
import CardLayout from "../../components/card-layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { fetchServiceItems } from "../../lib/sanity.queries";

const serviceItems = await fetchServiceItems();
---

<Layout>
  <Header />

  <div class="grid grid-cols-1 mx-grid lg:grid-cols-2 mt-section">
    <div class="flex flex-col lg:flex-row-reverse lg:pr-35 lg:mt-46 lg:order-2">
      <p
        class="px-1 py-1 mb-auto font-light rounded-sm bg-yellow md:px-3 md:py-2 text-4xl-fluid"
      >
        Tjenester
      </p>
      <div class="p-1 lg:min-w-12">
        <svg
          class="w-full h-full pointer-events-none stroke-blue-dark"
          viewBox="0 0 402 362"
          preserveAspectRatio="none"
        >
          <line
            x1="0"
            y1="362"
            x2="402"
            y2="0"
            stroke="inherit"
            stroke-width="2"
            vector-effect="non-scaling-stroke"></line>
        </svg>
      </div>
    </div>

    <div>
      <picture>
        <img
          class="w-full rounded-md aspect-[4/3] object-cover"
          src="/images/temp.png"
          class="w-full"
          draggable="false"
        />
      </picture>
    </div>
  </div>

  <CardLayout class="mt-section">
    <div class="lg:col-span-1"></div>
    <div class="lg:col-span-3">
      <p
        class="max-w-[65rem] lg:max-w-[61.9vw] md:pr-20 font-light text-2xl-fluid"
      >
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>

      <div class="mt-section">
        <picture>
          <img
            class="w-full rounded-md aspect-[4/3] object-cover"
            src="/images/temp.png"
            class="w-full"
            draggable="false"
          />
        </picture>
      </div>

      <div class="grid grid-cols-1 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item) => (
            <Card href={`/tjenester/${item.slug.current}`} color="grey">
              <div>
                <p class="font-medium text-lg-fluid group-link-underline">
                  {item.title}
                </p>
              </div>
              <p class="text-sm-fluid">{item.description}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <div
    class="grid items-start grid-cols-1 mx-grid mt-section gap-gutter lg:grid-cols-2"
  >
    <h2 class="font-light text-4xl-fluid">Digital styrke – tett på</h2>
    <div>
      <p class="text-lg-fluid">
        Hos oss møter du fagfolk som både kan og vil. Vi utforsker, samarbeider
        og skaper muligheter som gjør en forskjell for mennesker, virksomheter
        og samfunnet.
      </p>

      <Button class="mt-8">Les om folka</Button>
    </div>
  </div>

  <div class="mt-section mx-grid">
    <picture>
      <img
        class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover rounded-md"
        src="/images/temp.png"
        class="w-full"
        draggable="false"
      />
    </picture>
  </div>

  <Footer />
</Layout>
