---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/Button.astro";
import CardLayout from "../../components/card-layout/CardLayout.astro";
import Card from "../../components/card-layout/Card.astro";
import { sanityClient } from "sanity:client";

const serviceItems =
  await sanityClient.fetch(`*[_type == "service" && defined(slug)]
  | order(order asc) {
    _id,
    title,
    description,
    "href": slug.current
  }`);

---

<Layout>
  <Header />

  <div class="grid grid-cols-1 mx-grid gap-gutter md:grid-cols-2 mt-section">
    <div>
      <picture>
        <img
          class="w-full rounded-md aspect-[4/3] object-cover"
          src="/images/temp.png"
          class="w-full"
          draggable="false"
        />
      </picture>
    </div>
    <div class="relative">
      <div class="absolute -translate-x-1/2 -translate-y-1/2 left-1/2 top-1/2">
        <p
          class="px-1 py-1 font-light rounded-sm bg-yellow sm:px-2 sm:py-3 text-4xl-fluid"
        >
          Tjenester
        </p>
      </div>
    </div>
  </div>

  <CardLayout class="mt-section">
    <div class="lg:col-span-1"></div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>

      <div class="mt-section">
        <picture>
          <img
            class="w-full rounded-md aspect-[4/3] object-cover"
            src="/images/temp.png"
            class="w-full"
            draggable="false"
          />
        </picture>
      </div>

      <div class="grid grid-cols-1 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item: { href: string; title: string; description: string; }) => (
            <Card href={item.href} color="grey">
              <p class="font-medium link-underline text-lg-fluid group-hover:no-underline">
                {item.title}
              </p>
              <p class="text-sm-fluid">{item.description}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <div
    class="grid items-start grid-cols-1 mx-grid mt-section gap-gutter lg:grid-cols-2"
  >
    <h2 class="font-light text-4xl-fluid">Digital styrke – tett på</h2>
    <div>
      <p class="text-lg-fluid">
        Hos oss møter du fagfolk som både kan og vil. Vi utforsker, samarbeider
        og skaper muligheter som gjør en forskjell for mennesker, virksomheter
        og samfunnet.
      </p>

      <Button class="mt-8">Les om folka</Button>
    </div>
  </div>

  <div class="mt-section mx-grid">
    <picture>
      <img
        class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover rounded-md"
        src="/images/temp.png"
        class="w-full"
        draggable="false"
      />
    </picture>
  </div>

  <Footer />
</Layout>
