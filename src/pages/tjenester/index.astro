---
import LinkBox from "../../components/LinkBox.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import Citation from "../../components/card/Citation.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import {
  fetchServiceItems,
  fetchServicesSingleton,
} from "../../lib/sanity.queries";
import Contact from "../../components/card/Contact.astro";
import Image from "../../components/Image.astro";
import type { Citation as CitationType } from "../../lib/sanity.types";
import { fullWidth, threeFourth } from "../../utils/number";

const [servicesInfo, serviceItems] = await Promise.all([
  fetchServicesSingleton(),
  fetchServiceItems(),
]);
---

<Layout title="Tjenester">
  <Header active="/tjenester" />

  <div
    id="main-content"
    class="grid mx-grid lg:grid-cols-2 mt-section scroll-mt-[var(--height-header)]"
  >
    <div
      class="flex flex-col lg:flex-row-reverse items-start lg:items-center justify-end lg:order-2 max-h-100 lg:max-h-none"
    >
      <p
        class="px-1 py-1 lg:-translate-y-1/2 -translate-x-1/1 ml-[80%] md:ml-[70%] lg:ml-0 lg:translate-x-0 font-light rounded-sm bg-yellow md:px-3 md:py-2 text-4xl-fluid"
      >
        Tjenester
      </p>
      <div
        class="p-1 w-8/10 md:w-7/10 lg:w-1/2 self-start h-2/5 lg:self-end lg:h-1/2"
      >
        <svg
          class="w-full h-full pointer-events-none stroke-blue-dark"
          viewBox="0 0 402 362"
          preserveAspectRatio="none"
        >
          <line
            x1="0"
            y1="362"
            x2="402"
            y2="0"
            stroke="inherit"
            stroke-width="2"
            vector-effect="non-scaling-stroke"></line>
        </svg>
      </div>
    </div>

    <div>
      <picture>
        <Image
          class="w-full rounded-md aspect-[4/3] object-cover"
          image={servicesInfo.heroImage}
          alt={servicesInfo.heroImage.alt}
          mode="cover"
          width={820}
          height={615}
          sizes={`(min-width: 105rem) calc(${fullWidth("lg")} / 2), (min-width: 50rem) calc(${fullWidth("md")}), calc(${fullWidth("sm")})`}
        />
      </picture>
    </div>
  </div>

  <CardLayout class="mt-section mx-grid">
    <CardRightColumn>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        {servicesInfo.description}
      </p>
    </CardRightColumn>
    <div></div>
    <div class="lg:col-span-3">
      <div class="mt-section">
        <picture>
          <Image
            alt={servicesInfo.secondaryImage.alt}
            class="w-full object-cover rounded-md lg:rounded-lg aspect-[4/3] lg:aspect-[2/1]"
            image={servicesInfo.secondaryImage}
            mode="cover"
            width={1225}
            height={613}
            sizes={`calc(${threeFourth("lg")}), (min-width: 50rem) calc(${fullWidth("md")}), calc(${fullWidth("sm")})`}
          />
        </picture>
      </div>

      <div class="grid lg:col-span-3 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item) => (
            <LinkBox href={`/tjenester/${item.slug.current}`} color="grey">
              <div>
                <p class="font-medium text-lg-fluid group-link-underline">
                  {item.title}
                </p>
              </div>
              <p class="text-sm-fluid">{item.description}</p>
            </LinkBox>
          ))
        }
      </div>
    </div>
  </CardLayout>

  {
    servicesInfo.citations && (
      <Citation
        title="Tjenester"
        citation={servicesInfo.citations as unknown as CitationType}
      />
    )
  }

  {
    servicesInfo.contact && (
      <Contact
        button={`Send ${servicesInfo.contact.name} en e-post`}
        email={servicesInfo.contact.email}
        label="Kontakt"
        title={servicesInfo.contact.title}
        text={servicesInfo.contact.description}
        image={servicesInfo.contact.image}
      />
    )
  }

  <Footer />
</Layout>
