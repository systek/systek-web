---
import Button from "../../components/Button.astro";
import Card from "../../components/card-layout/Card.astro";
import CardLayout from "../../components/card-layout/CardLayout.astro";
import Citation from "../../components/Citation.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { fetchServiceItems } from "../../lib/sanity.queries";

const serviceItems = await fetchServiceItems();
---

<Layout>
  <Header />

  <div class="grid grid-cols-1 mx-grid lg:grid-cols-2 mt-section">
    <div class="flex flex-col lg:flex-row-reverse lg:pr-35 lg:mt-46 lg:order-2">
      <p
        class="px-1 py-1 mb-auto font-light rounded-sm bg-yellow md:px-3 md:py-2 text-4xl-fluid"
      >
        Tjenester
      </p>
      <div class="p-1 lg:min-w-12">
        <svg
          class="w-full h-full pointer-events-none stroke-blue-dark"
          viewBox="0 0 402 362"
          preserveAspectRatio="none"
        >
          <line
            x1="0"
            y1="362"
            x2="402"
            y2="0"
            stroke="inherit"
            stroke-width="2"
            vector-effect="non-scaling-stroke"></line>
        </svg>
      </div>
    </div>

    <div>
      <picture>
        <img
          class="w-full rounded-md aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </div>

  <CardLayout class="mt-section">
    <div class="lg:col-span-1"></div>
    <div class="lg:col-span-3">
      <p
        class="max-w-[65rem] lg:max-w-[61.9vw] md:pr-20 font-light text-2xl-fluid"
      >
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>

      <div class="mt-section">
        <picture>
          <img
            class="w-full rounded-md aspect-[4/3] object-cover"
            src="/images/temp.png"
            class="w-full"
            draggable="false"
          />
        </picture>
      </div>

      <div class="grid grid-cols-1 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item) => (
            <Card href={`/tjenester/${item.slug.current}`} color="grey">
              <div>
                <p class="font-medium text-lg-fluid group-link-underline">
                  {item.title}
                </p>
              </div>
              <p class="text-sm-fluid">{item.description}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Design og brukeropplevelse</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[50rem] lg:max-w-[47.6vw] font-light text-xl-fluid">
        “Systek har levert skalerbare og brukervennlige løsninger som
        understøtter Elvias kjerneprosesser, og gir både ansatte og kunder bedre
        innsikt og mer effektiv samhandling”
      </p>
      <Citation
        class="mt-4 lg:mt-5"
        title="Eivind Lund"
        subtitle="IT Direktør, Elvia"
        image="todo"
      />
      <Button class="mt-6 sm:mt-8" href="/tjenester/design-og-brukeropplevelse"
        >Les om tjenesten</Button
      >
    </div>
  </CardLayout>

  <CardLayout
    breakpoint="md"
    class="border-t mt-page border-stroke gap-section"
  >
    <div class="flex flex-col md:col-span-2 gap-gutter">
      <p class="font-bold text-sm-fluid">Kontakt</p>

      <div class="mt-auto max-w-[37rem] lg:max-w-[35.2vw]">
        <p class="font-light text-2xl-fluid">Ta kontakt med Charlotte</p>
        <p class="mt-5 text-md-fluid md:mt-6">
          Ta kontakt med vår forretningsutvikler Charlotte dersom du lurer på
          hva vi kan hjelpe deg med.
        </p>

        <div class="flex items-center mt-6 gap-grid md:mt-8">
          <Button href="mailto:charlotte.irgens@systek.no">Send en mail</Button>
          <a class="link-underline text-sm-fluid" href="/kontakt">
            Se kontakt-siden
          </a>
        </div>
      </div>
    </div>
    <div class="md:col-span-2">
      <picture>
        <img
          class="w-full rounded-md aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </CardLayout>

  <Footer />
</Layout>
