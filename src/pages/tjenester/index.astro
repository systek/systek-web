---
import Button from "../../components/Button.astro";
import LinkBox from "../../components/LinkBox.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardHeader from "../../components/card/layout/CardHeader.astro";
import Citation from "../../components/Citation.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import { fetchServiceItems, fetchCitationItem } from "../../lib/sanity.queries";

const serviceItems = await fetchServiceItems();
const citation = await fetchCitationItem();
---

<Layout title="Tjenester">
  <Header active="/tjenester" />

  <div class="grid mx-grid lg:grid-cols-2 mt-section">
    <div
      class="flex flex-col lg:flex-row-reverse items-start lg:items-center justify-end lg:order-2 max-h-100 lg:max-h-none"
    >
      <p
        class="px-1 py-1 lg:-translate-y-1/2 -translate-x-1/1 ml-[80%] md:ml-[70%] lg:ml-0 lg:translate-x-0 font-light rounded-sm bg-yellow md:px-3 md:py-2 text-4xl-fluid"
      >
        Tjenester
      </p>
      <div
        class="p-1 w-8/10 md:w-7/10 lg:w-1/2 self-start h-2/5 lg:self-end lg:h-1/2"
      >
        <svg
          class="w-full h-full pointer-events-none stroke-blue-dark"
          viewBox="0 0 402 362"
          preserveAspectRatio="none"
        >
          <line
            x1="0"
            y1="362"
            x2="402"
            y2="0"
            stroke="inherit"
            stroke-width="2"
            vector-effect="non-scaling-stroke"></line>
        </svg>
      </div>
    </div>

    <div>
      <picture>
        <img
          class="w-full rounded-md aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </div>

  <CardLayout class="mt-section mx-grid">
    <CardHeader>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] lg:mr-20 font-light text-2xl-fluid"
      >
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>
    </CardHeader>
    <div></div>
    <div class="lg:col-span-3">
      <div class="mt-section">
        <picture>
          <img
            class="w-full object-cover rounded-md lg:rounded-lg aspect-[4/3] lg:aspect-[2/1]"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>
      </div>

      <div class="grid lg:col-span-3 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item) => (
            <LinkBox href={`/tjenester/${item.slug.current}`} color="grey">
              <div>
                <p class="font-medium text-lg-fluid group-link-underline">
                  {item.title}
                </p>
              </div>
              <p class="text-sm-fluid">{item.description}</p>
            </LinkBox>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Design og brukeropplevelse">
      <p class="max-w-[50rem] lg:max-w-[47.619vw] font-light text-xl-fluid">
        «Systek har levert skalerbare og brukervennlige løsninger som
        understøtter Elvias kjerneprosesser, og gir både ansatte og kunder bedre
        innsikt og mer effektiv samhandling»
      </p>
      <Citation
        class="mt-4 lg:mt-5"
        title={citation.name}
        subtitle={citation.position}
        image={citation.picture}
      />
      <Button class="mt-grid" href="/tjenester/design-og-brukeropplevelse">
        Les om tjenesten
      </Button>
    </CardHeader>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <div class="flex flex-col lg:col-span-2">
      <p class="font-bold text-sm-fluid">Kontakt</p>
      <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
        <p class="mt-2 font-light text-2xl-fluid">Ta kontakt med Charlotte</p>
        <p class="mt-5 text-md-fluid md:mt-6">
          Ta kontakt med vår forretningsutvikler Charlotte dersom du lurer på
          hva vi kan hjelpe deg med.
        </p>

        <div class="flex items-center mt-grid gap-grid">
          <Button href="mailto:charlotte.irgens@systek.no">
            Send Charlotte en e-post
          </Button>
          <a
            class="link-underline text-sm-fluid"
            href="https://systek.homerun.co"
          >
            Se kontakt-siden
          </a>
        </div>
      </div>
    </div>
    <div class="mt-10 lg:col-span-2 lg:mt-0">
      <picture>
        <img
          class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </CardLayout>

  <Footer />
</Layout>
