---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import Article from "../components/Article.astro";
---

<Layout>
  <Header />

  <PageHeader title="Oisann, dette var ikke meningen ..." />

  <Article>
    <h2 class="my-grid text-lg-fluid">500 Internal Server Error</h2>
    <p class="my-grid text-md-fluid">
      Det er ikke din skyld, dette er en feil vi ikke håndterer. Den kan være
      midlertidig, så prøv gjerne igjen.
    </p>
    <Button data-refresh-button class="my-grid">Last siden på nytt</Button>
  </Article>
  <Footer />
</Layout>

<script>
  import { DOMLoaded } from "../utils/utils";

  DOMLoaded(() => {
    const button = document.querySelector(
      "[data-refresh-button]"
    ) as HTMLButtonElement;
    button.addEventListener("click", () => {
      window.location.reload();
    });
  });
</script>
