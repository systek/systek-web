---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";

const arrows = [
  "top-0 left-0 rotate-[-90deg]",
  "top-0 right-0",
  "bottom-0 left-0 rotate-[180deg]",
  "bottom-0 right-0 rotate-[90deg]",
];
---

<Layout title="Systek">
  <Header />

  <div class="px-5">
    <div
      class="relative h-[66vh] max-h-[50vw] min-h-[200px] w-full flex items-center justify-center bg-off-white"
    >
      <p class="text-9xl">:)</p>
      {
        arrows.map((arrow) => (
          <img
            src="/images/systek-arrow.svg"
            class={`pointer-events-none absolute ${arrow}`}
          />
        ))
      }
    </div>

    <div
      class="grid grid-cols-1 gap-2 items-start sm:gap-0 sm:grid-cols-2 my-12"
    >
      <h2 class="text-4xl font-light sm:text-[4.5vw] sm:leading-none">
        Vi bygger bro mellom folk og teknologi
      </h2>
      <p class="text-xl tracking-tight sm:text-[2.2vw] sm:leading-tight">
        Introtext fusce dapibus, tellus ac cursus commodo, tortor mauris
        condimentum nibh ut fermentum massa justo amet.
      </p>
    </div>

    <img src="/images/temp.png" class="pointer-events-none w-full" />
  </div>
</Layout>
