---
import clsx from "clsx";
import { format } from "date-fns";
import { nb } from "date-fns/locale";
import { SanityImage } from "sanity-image";

import ExternalIcon from "../assets/icons/external.svg";
import Button from "../components/Button.astro";
import CardLayout from "../components/card/layout/CardLayout.astro";
import Connections from "../components/Connections.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import {
  fetchActivityItems,
  fetchBlogItems,
  fetchLogoItems,
  fetchNewsItems,
  fetchServiceItems,
  fetchWorkItems,
} from "../lib/sanity.queries";
import CardHeader from "../components/card/layout/CardHeader.astro";
import Accordion from "../components/accordion/Accordion.astro";
import AccordionItem from "../components/accordion/AccordionItem.astro";
import LinkBox from "../components/LinkBox.astro";

const [
  serviceItems,
  newsItems,
  workItems,
  activityItems,
  blogItems,
  logoItems,
] = await Promise.all([
  fetchServiceItems(),
  fetchNewsItems(2),
  fetchWorkItems(3),
  fetchActivityItems(5),
  fetchBlogItems(),
  fetchLogoItems(),
]);

const index = Math.ceil(logoItems.length / 2);
const logoTopItems = logoItems.slice(0, index);
const logoBottomItems = logoItems.slice(index);
---

<Layout bodyStyle="--color-background: var(--color-blue);">
  <Connections />

  <Header />

  <div class="grid items-start mx-grid mt-section gap-gutter lg:grid-cols-2">
    <h2 class="font-light text-4xl-fluid">Digital styrke – tett på</h2>
    <div>
      <p class="text-lg-fluid">
        Hos oss møter du fagfolk som både kan og vil. Vi utforsker, samarbeider
        og skaper muligheter som gjør en forskjell for mennesker, virksomheter
        og samfunnet.
      </p>

      <Button class="mt-8" href="/folka">Les om folka</Button>
    </div>
  </div>

  <div class="mt-section mx-grid">
    <picture>
      <img
        class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover rounded-md lg:rounded-lg"
        src="/images/temp.png"
        draggable="false"
      />
    </picture>
  </div>

  <CardLayout class="border-t mt-section border-stroke mx-grid pt-grid">
    <CardHeader title="Tjenester">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>

      <Button href="/tjenester" class="mt-grid">Se våre tjenester</Button>
    </CardHeader>
    <div></div>
    <div class="grid lg:col-span-3 gap-gutter mt-section md:grid-cols-3">
      {
        serviceItems.map((item) => (
          <LinkBox href={`/tjenester/${item.slug.current}`} color="grey">
            <div>
              <p class="font-medium text-lg-fluid group-link-underline">
                {item.title}
              </p>
            </div>
            <p class="text-sm-fluid">{item.description}</p>
          </LinkBox>
        ))
      }
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Nyheter">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Siste nytt fra Systek
      </p>

      <Button class="mt-grid" href="/nyheter">Se alle nyheter</Button>
    </CardHeader>

    <div></div>
    <div class="border-t border-stroke mt-section lg:col-span-3">
      <!-- todo: time element does not match figma on desktop -->
      {
        newsItems.map((item) => (
          <div class="flex justify-between py-grid border-b gap-gutter border-stroke">
            <a
              class="flex items-center gap-1 link-underline"
              href={`/nyheter/${item.slug.current}`}
            >
              <ExternalIcon class="size-2.5 lg:size-[0.595vw]" />
              <p class="text-xs-fluid">{item.title}</p>
            </a>
            <p class="md:pr-64 text-xs-fluid">
              {format(new Date(item.publishedAt), "d. MMMM", {
                locale: nb,
              })}
            </p>
          </div>
        ))
      }
    </div>
  </CardLayout>

  <!-- todo: match with figma on mobile+tablet -->
  <CardLayout class="mt-page mx-grid">
    <div></div>
    <div class="grid gap-section md:gap-14 lg:col-span-3">
      <div
        class="grid grid-cols-2 gap-section md:gap-3 md:flex md:justify-between"
      >
        {
          logoTopItems.map((item) => (
            <SanityImage
              className="w-[128px] h-[62px] even:ml-auto md:even:ml-0"
              id={item.image.asset?._ref!}
              baseUrl="https://cdn.sanity.io/images/s9j0sgbs/production/"
              alt={item.image.alt}
              width={128}
              height={62}
            />
          ))
        }
      </div>
      <div
        class="grid grid-cols-2 gap-section md:gap-3 md:flex md:justify-between"
      >
        {
          logoBottomItems.map((item) => (
            <SanityImage
              className="w-[128px] h-[62px] even:ml-auto md:even:ml-0"
              id={item.image.asset?._ref!}
              baseUrl="https://cdn.sanity.io/images/s9j0sgbs/production/"
              alt={item.image.alt}
              width={128}
              height={62}
            />
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Arbeider">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Vi har lang erfaring med komplekse prosjekter fra ledende virksomheter
      </p>

      <Button class="mt-grid" href="/arbeider">Se alle arbeider</Button>
    </CardHeader>

    <div
      class="grid grid-cols-2 lg:col-span-4 md:grid-cols-4 gap-gutter mt-section"
    >
      {
        workItems.map((item, index) => (
          <div class={clsx("group", index % 3 === 0 && "col-span-2")}>
            <a href={`/arbeider/${item.slug.current}`}>
              <picture>
                <SanityImage
                  className={clsx(
                    "w-full rounded-md object-cover",
                    index % 3 === 2 ? "aspect-square" : "aspect-[4/3]"
                  )}
                  id={item.image.asset?._ref!}
                  baseUrl="https://cdn.sanity.io/images/s9j0sgbs/production/"
                  mode="cover"
                  alt={item.image.alt}
                  sizes={
                    index % 3 === 0
                      ? "(max-width: 384px) 100vw, 50vw"
                      : "(max-width: 384px) 50vw, 25vw"
                  }
                />
              </picture>
              <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          </div>
        ))
      }
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Foredrag og fagmøter">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Systek arrangerer både interne fagmøter samt åpne arrangementer for
        eksterne
      </p>
    </CardHeader>
    <div></div>
    <div class="lg:col-span-3">
      <div class="mt-section">
        <picture>
          <img
            class="w-full rounded-md lg:rounded-lg"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>
      </div>

      <div class="md:border-t md:border-stroke mt-section">
        <!-- seperate markup for mobile and desktop -->
        <div
          class="flex justify-between py-4 border-b md:hidden gap-gutter border-stroke"
        >
          <p class="font-bold text-xs-fluid">Hva skjer</p>
          <p class="font-bold text-xs-fluid">Dato</p>
        </div>

        <div
          class="hidden grid-cols-4 py-grid border-b md:grid gap-gutter border-stroke"
        >
          <p class="font-bold text-xs-fluid">Hva skjer</p>
          <p class="font-bold text-xs-fluid">Dato</p>
          <p class="font-bold text-xs-fluid">Sted</p>
          <p class="font-bold text-xs-fluid">Påmelding</p>
        </div>
        <!-- todo: add logic for line through, format date -->
        {
          activityItems.map((item) => {
            // TODO: move this logic into a client-side component
            // This will onlly be checked at build time
            const date = new Date(item.date);
            const formatedDate = format(date, "d. MMMM", {
              locale: nb,
            });
            const isDone = date < new Date();
            return (
              <div>
                <div
                  class={clsx(
                    "flex md:hidden justify-between items-center py-4 border-b gap-gutter border-stroke",
                    { "line-through": isDone }
                  )}
                >
                  {isDone ? (
                    <p class="text-xs-fluid">{item.title}</p>
                  ) : (
                    <a
                      href={item.slug?.current}
                      class="flex items-center gap-1 link-underline"
                    >
                      <ExternalIcon class="size-2.5 lg:size-[0.595vw]" />
                      <p class="text-xs-fluid">{item.title}</p>
                    </a>
                  )}
                  <p class="text-xs-fluid">{formatedDate}</p>
                </div>

                <div
                  class={clsx(
                    "hidden md:grid grid-cols-4 py-grid border-b gap-gutter border-stroke",
                    { "line-through": isDone }
                  )}
                >
                  <p class="text-xs-fluid">{item.title}</p>
                  <p class="text-xs-fluid">{formatedDate}</p>
                  <p class="text-xs-fluid">{item.location}</p>
                  <p class="text-xs-fluid">
                    {isDone ? (
                      "Avsluttet"
                    ) : item.slug?.current ? (
                      <Button size="sm" href={item.slug.current}>
                        Meld meg på
                      </Button>
                    ) : (
                      "Internt"
                    )}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Jobbe her?">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Bli med og bygg konsulentselskapet du selv ønsker å jobbe i
      </p>

      <Button class="mt-grid" href="https://systek.homerun.co">
        Se ledige stillinger
      </Button>
    </CardHeader>

    <Accordion class="mt-section">
      <AccordionItem bold open size="lg" title="Fleksibilitet og frihet">
        <p class="text-sm-fluid text-text-secondary max-w-[35rem]">
          Vi ser etter deg som er selvgående, løsningsorientert og faglig
          dyktig. Hos oss får du fleksibilitet til å finne arbeidshverdagen som
          passer for deg og frihet til å selv bestemme hvilke oppdrag du synes
          er spennende.
        </p>
      </AccordionItem>
      <AccordionItem bold size="lg" title="Flinke kollegaer">
        <p class="text-sm-fluid text-text-secondary max-w-[35rem]">
          ⚠️ LAG TEKST ⚠️ Vi har et sterkt fagmiljø med dyktige kollegaer som
          deler kunnskap og erfaringer. Sammen jobber vi for å skape de beste
          løsningene for våre kunder.
        </p>
      </AccordionItem>
      <AccordionItem bold size="lg" title="Flat struktur">
        <p class="text-sm-fluid text-text-secondary max-w-[35rem]">
          ⚠️ LAG TEKST ⚠️ Vi har en flat organisasjonsstruktur som fremmer
          åpenhet og samarbeid. Hos oss får du muligheten til å påvirke og bidra
          til utviklingen av selskapet.
        </p>
      </AccordionItem>
    </Accordion>

    <div class="mt-section lg:col-span-3">
      <picture>
        <img
          class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover rounded-md lg:rounded-lg"
          src="/images/temp.png"
        />
      </picture>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Blogg">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Les våre siste artikler fra fag-bloggen
      </p>

      <Button class="mt-grid">Se alle blogginnlegg</Button>
    </CardHeader>

    <div></div>
    <div class="grid lg:col-span-3 md:grid-cols-2 gap-gutter mt-section">
      {
        blogItems.map((item) => (
          <a class="group" href={item.link}>
            <picture>
              <SanityImage
                className="w-full rounded-md object-cover aspect-[4/3]"
                id={item.image.asset?._ref!}
                baseUrl="https://cdn.sanity.io/images/s9j0sgbs/production/"
                width={600}
                height={450}
                mode="cover"
                alt={item.image.alt}
                sizes="(min-width: 105rem) 25vw, (min-width: 50rem) 50vw, 50vw"
              />
            </picture>
            <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
              {item.title}
            </p>
            <p class="text-md-fluid">{item.description}</p>
            <p class="text-sm-fluid leading-snug">
              Skrevet av {item.author.name}
            </p>
          </a>
        ))
      }
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <div class="flex flex-col lg:col-span-2">
      <p class="font-bold text-sm-fluid">Kontakt</p>
      <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
        <p class="mt-2 font-light text-2xl-fluid">Nysgjerrig?</p>
        <p class="mt-grid text-md-fluid">
          Om du er faglig dyktig, brenner for det du jobber med og har lyst til
          å være en del av et miljø hvor kunnskap, nysgjerrighet og inkludering
          er viktig, så vil vi gjerne snakke med deg!
        </p>

        <div class="flex items-center mt-grid gap-grid">
          <Button href="mailto:charlotte.irgens@systek.no">Send en mail</Button>
          <a
            class="link-underline text-sm-fluid"
            href="https://systek.homerun.co"
          >
            Se kontakt-siden
          </a>
        </div>
      </div>
    </div>
    <div class="mt-10 lg:col-span-2 lg:mt-0">
      <picture>
        <img
          class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
          src="/images/temp.png"
          draggable="false"
        />
      </picture>
    </div>
  </CardLayout>

  <Footer />
</Layout>
