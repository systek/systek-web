---
import Layout from "../layouts/Layout.astro";
import BackgroundColorIsland from "../islands/BackgroundColorIsland";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConnectionsIsland from "../components/connections/Connections.astro";
import Arrow from "../components/Arrow.astro";
import Button from "../components/Button.astro";
import CardLayout from "../components/card-layout/CardLayout.astro";
import Card from "../components/card-layout/Card.astro";
import ExternalIcon from "../assets/icons/external.svg";

const serviceItems = [
  {
    title: "Utvikling og arkitektur",
    description:
      "Systek har lang erfaring med design og utvikling av bærekraftige løsninger og kritiske systemer i offentlig og privat digitalisering.",
    href: "/",
  },
  {
    title: "Test og automatisering",
    description:
      "Våre konsulenter har lang erfaring og spiss-kompetanse innen testfaget. Vi benytter standardiserte metoder og rammeverk.",
    href: "/",
  },
  {
    title: "Prosjektledelse og rådgivning",
    description:
      "Våre prosjektledere og rådgivere har teknisk bakgrunn og lang erfaring i å lede digitaliseringsprosjekter.",
    href: "/",
  },
  {
    title: "Plattform og skytjenester",
    description:
      "Vi kjenner løsningene og kan bidra med å velge, sette opp og forvalte plattformen på egne servere eller hos en tredjeparts leverandør.",
    href: "/",
  },
  {
    title: "Data og analyse",
    description:
      "Vi hjelper våre kunder med å omdanne data til smartere beslutninger, raskere innovasjon og økt konkurransekraft.",
    href: "/",
  },
  {
    title: "Design og brukeropplevelse",
    description:
      "Vi hjelper deg med å lage digitale løsninger som bidrar til å oppnå ønsket effekt for brukerne og selskapet ditt.",
    href: "/",
  },
];

const newsItems = [
  {
    title: "Opptak av summer internship",
    description:
      "Vi starter nyåret med å minne om frist for å søke på summer internship hos oss. Er deg eller noen du kjenner?",
    href: "/",
    published: "22. juni",
    updated: "3. juli",
  },
  {
    title: "Styring av strømnett",
    description:
      "Å Energi Fleksibilitet (tidligere Agder Energi) utvikler en ny verdikjede for styring av strømnettet, bestående av nettoperatørverktøyet GridTools, markedsplassen NODES og fleksibilitetstilbyderens verktøy, flextools.",
    href: "/",
    published: "12. mai",
  },
];

const logoTopItems = [
  {
    alt: "Oslo kommune",
    src: "oslo-kommune.svg",
  },
  {
    alt: "NAV",
    src: "nav.svg",
  },
  {
    alt: "Telenor",
    src: "telenor.svg",
  },
  {
    alt: "Mastercard",
    src: "mastercard.svg",
  },
];

const logoBottomItems = [
  {
    alt: "Å Energi",
    src: "a-energi.svg",
  },
  {
    alt: "Digdir",
    src: "digdir.svg",
  },
  {
    alt: "Miljødirektoratet",
    src: "miljodirektoratet.svg",
  },
  {
    alt: "Hydro",
    src: "hydro.svg",
  },
];
---

<Layout title="Systek" bodyStyle="--color-background: var(--color-blue);">
  <BackgroundColorIsland client:load />

  <div
    class="aspect-[5/8] md:aspect-[4/3] lg:aspect-[21/10] relative overflow-x-hidden"
  >
    <ConnectionsIsland />
    <Arrow position="topLeft" class="absolute top-grid left-grid" />
    <Arrow position="topRight" class="absolute top-grid right-grid" />
    <Arrow position="bottomRight" class="absolute bottom-grid right-grid" />
    <Arrow position="bottomLeft" class="absolute bottom-grid left-grid" />
  </div>

  <Header />

  <div
    class="grid items-start grid-cols-1 px-grid mt-section gap-gutter lg:grid-cols-2"
  >
    <h2 class="font-light text-4xl-fluid">Digital styrke – tett på</h2>
    <div>
      <p class="text-lg-fluid">
        Hos oss møter du fagfolk som både kan og vil. Vi utforsker, samarbeider
        og skaper muligheter som gjør en forskjell for mennesker, virksomheter
        og samfunnet.
      </p>

      <Button class="mt-8">Les om folka</Button>
    </div>
  </div>

  <div class="overflow-hidden rounded-md mt-section px-grid">
    <img
      class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover"
      src="/images/temp.png"
      class="w-full"
      draggable="false"
    />
  </div>

  <CardLayout class="border-t mt-section border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Tjenester</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-light text-2xl-fluid">
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se våre tjenester</Button>

      <div class="grid grid-cols-1 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item) => (
            <Card href={item.href} color="grey">
              <p class="font-medium text-underline text-lg-fluid group-hover:no-underline">
                {item.title}
              </p>
              <p class="text-sm-fluid">{item.description}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Nyheter</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-light text-2xl-fluid">Siste nytt fra Systek</p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se alle nyheter</Button>

      <!-- todo: use <time> -->
      <!-- todo: time element does not match figma on desktop -->
      <!-- todo: underline should wrap icon -->
      <div class="border-t border-stroke mt-section">
        {
          newsItems.map((item) => (
            <a
              class="flex justify-between py-5 border-b gap-gutter text-xs-fluid border-stroke"
              href={item.href}
            >
              <div class="flex items-center gap-2">
                <ExternalIcon class="size-2.5" />
                <p class="text-underline">{item.title}</p>
              </div>

              <p class="md:pr-64">{item.published}</p>
            </a>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <!-- todo: match with figma on mobile+tablet -->
  <CardLayout class="mt-page">
    <div class="lg:col-span-1"></div>
    <div class="lg:col-span-3">
      <div class="flex justify-between gap-3">
        {
          logoTopItems.map((item) => (
            <img
              alt={item.alt}
              class="w-[128px] h-[62px] aspect-[2/1]"
              src={`/images/logo/${item.src}`}
              draggable="false"
            />
          ))
        }
      </div>
      <div class="flex justify-between gap-3 mt-14">
        {
          logoBottomItems.map((item) => (
            <img
              alt={item.alt}
              class="w-[128px] h-[62px] aspect-[2/1]"
              src={`/images/logo/${item.src}`}
              draggable="false"
            />
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Arbeider</p>
    </div>
    <div class="lg:col-span-3">
      <p class="font-light text-2xl-fluid">
        Vi har lang erfaring med komplekse prosjekter fra ledende virksomheter
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se alle arbeider</Button>
    </div>
  </CardLayout>

  <!-- todo: check mt, should be "Section-L". Not implemented? -->
  <div class="grid grid-cols-2 gap-gutter mt-section">
    {
      newsItems.map((item) => (
        <div>
          <div>
            <p class="mb-1 text-xs-fluid">
              Publisert {item.published}{" "}
              {item.updated && `· Oppdatert ${item.updated}`}
            </p>
            <p class="font-medium text-underline text-lg-fluid group-hover:no-underline">
              {item.title}
            </p>
          </div>
          <p class="text-sm-fluid">{item.description}</p>
        </div>
      ))
    }
  </div>

  <Footer />
</Layout>
