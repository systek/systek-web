---
import clsx from "clsx";

import Image from "../components/Image.astro";
import ExternalIcon from "../assets/icons/external.svg";
import Button from "../components/Button.astro";
import CardLayout from "../components/card/layout/CardLayout.astro";
import Connections from "../components/Connections.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import {
  fetchActivityItems,
  fetchBlogItems,
  fetchFrontPageSingleton,
  fetchLogoItems,
  fetchNewsItems,
  fetchServiceItems,
} from "../lib/sanity.queries";
import CardRightColumn from "../components/card/layout/CardRightColumn.astro";
import Accordion from "../components/accordion/Accordion.astro";
import AccordionItem from "../components/accordion/AccordionItem.astro";
import GridListItem from "../components/grid-list/GridListItem.astro";
import Contact from "../components/card/Contact.astro";
import { formatDate } from "../utils/date";
import Logos from "../components/logo/Logos.astro";
import { fullWidth, oneFourth, oneHalf, threeFourth } from "../utils/number";
import GridList from "../components/grid-list/GridList.astro";
import CardTitle from "../components/card/layout/CardTitle.astro";

const [
  frontPageData,
  serviceItems,
  newsItems,
  activityItems,
  blogItems,
  logoItems,
] = await Promise.all([
  fetchFrontPageSingleton(),
  fetchServiceItems(),
  fetchNewsItems(2),
  fetchActivityItems(5),
  fetchBlogItems(),
  fetchLogoItems(12),
]);
---

<Layout bodyStyle="--color-background: var(--color-blue);">
  <Connections />

  <Header />

  <div
    id="main-content"
    class="grid items-start mx-grid mt-section gap-gutter lg:grid-cols-2 scroll-mt-[var(--height-header)]"
  >
    <h2 class="font-light text-4xl-fluid">{frontPageData.title}</h2>
    <div>
      <p class="text-lg-fluid">
        {frontPageData.topDescription}
      </p>

      <Button class="mt-8" href="/folka">Les om folka</Button>
    </div>
  </div>

  <div class="mt-section mx-grid">
    <picture>
      <Image
        alt={frontPageData.heroImage.alt}
        class="w-full rounded-md aspect-[4/3] md:aspect-[2/1] object-cover"
        image={frontPageData.heroImage}
        loading="eager"
        mode="cover"
        width={1640}
        height={820}
        sizes={`(min-width: 105rem) calc(${fullWidth("lg")}), (min-width: 50rem) calc(${fullWidth("md")}), calc(${fullWidth("sm")})`}
      />
    </picture>
  </div>

  <CardLayout class="border-t mt-section border-stroke mx-grid pt-grid">
    <CardRightColumn title="Tjenester">
      <CardTitle>
        {frontPageData.servicesTitle}
      </CardTitle>

      <Button href="/tjenester" class="mt-grid">Se våre tjenester</Button>

      <GridList class="mt-section">
        {
          serviceItems.map((item) => (
            <GridListItem
              href={`/tjenester/${item.slug.current}`}
              title={item.title}
            >
              <p class="text-sm-fluid">{item.description}</p>
            </GridListItem>
          ))
        }
      </GridList>
    </CardRightColumn>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Arbeider">
      <CardTitle>
        {frontPageData.workTitle}
      </CardTitle>

      <Button class="mt-grid" href="/arbeider">Se alle arbeider</Button>
    </CardRightColumn>
  </CardLayout>

  <div
    class="mx-grid grid grid-cols-2 gap-x-gutter gap-y-grid mt-section md:grid-cols-4"
  >
    {
      frontPageData.selectedWorks.map((item, index) => (
        <div class={clsx("group", index % 3 === 0 && "col-span-2")}>
          <a href={`/arbeider/${item.slug.current}`}>
            <picture>
              <Image
                class={clsx(
                  "w-full rounded-md object-cover",
                  index % 3 === 2 ? "aspect-square" : "aspect-[4/3]"
                )}
                image={item.image}
                mode="cover"
                alt={item.image.alt}
                width={index % 3 === 0 ? 810 : 395}
                height={index === 0 ? 608 : index === 1 ? 296 : 395}
                sizes={
                  index % 3 === 0
                    ? `(min-width: 105rem) calc(${oneHalf("lg")}), (min-width: 50rem) calc(${oneHalf("md")}), calc(${fullWidth("sm")})`
                    : `(min-width: 105rem) calc(${oneFourth("lg")}), (min-width: 50rem) calc(${oneFourth("md")}), calc(${oneHalf("sm")})`
                }
              />
            </picture>
            <p class="mt-gap font-bold text-md-fluid hyphens-auto group-link-underline">
              {item.title}
            </p>
            <p class="text-md-fluid">{item.description}</p>
          </a>
        </div>
      ))
    }
  </div>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Foredrag og fagmøter">
      <CardTitle>
        {frontPageData.activityTitle}
      </CardTitle>

      <div class="mt-section">
        <picture>
          <Image
            alt={frontPageData.activityImage.alt}
            class="w-full object-cover rounded-md lg:rounded-lg aspect-[4/3] lg:aspect-[2/1]"
            image={frontPageData.activityImage}
            mode="cover"
            width={1225}
            height={613}
            sizes={`calc(${threeFourth("lg")}), (min-width: 50rem) calc(${fullWidth("md")}), calc(${fullWidth("sm")})`}
          />
        </picture>
      </div>

      <div class="md:border-t md:border-stroke mt-section">
        <!-- seperate markup for mobile and desktop -->
        <div
          class="flex justify-between py-4 border-b md:hidden gap-gutter border-stroke"
        >
          <p class="font-bold text-xs-fluid">Hva skjer</p>
          <p class="font-bold text-xs-fluid">Dato</p>
        </div>

        <div
          class="hidden grid-cols-5 py-grid border-b md:grid gap-gutter border-stroke"
        >
          <p class="font-bold text-xs-fluid col-span-2">Hva skjer</p>
          <p class="font-bold text-xs-fluid">Dato</p>
          <p class="font-bold text-xs-fluid">Sted</p>
          <p class="font-bold text-xs-fluid">Påmelding</p>
        </div>
        <!-- todo: add logic for line through, format date -->
        {
          activityItems.map((item) => {
            // TODO: move this logic into a client-side component
            // This will onlly be checked at build time
            const date = new Date(item.date);
            const formatedDate = formatDate(date);
            const mobileFormatDate = formatDate(date, "d. MMM");
            const isDone = date < new Date();
            return (
              <div>
                <div
                  class={clsx(
                    "flex md:hidden justify-between items-center py-4 border-b gap-gutter border-stroke",
                    { "line-through": isDone }
                  )}
                >
                  {isDone ? (
                    <p class="text-xs-fluid">{item.title}</p>
                  ) : (
                    <a
                      href={item.slug?.current}
                      class="flex items-center gap-1 link-underline"
                    >
                      <ExternalIcon class="size-2.5 lg:size-[0.595vw]" />
                      <p class="text-xs-fluid">{item.title}</p>
                    </a>
                  )}
                  <p class="text-xs-fluid whitespace-nowrap">{mobileFormatDate}</p>
                </div>

                <div
                  class={clsx(
                    "hidden md:grid grid-cols-5 py-grid border-b gap-gutter border-stroke",
                    { "line-through": isDone }
                  )}
                >
                  <p class="text-xs-fluid col-span-2">{item.title}</p>
                  <p class="text-xs-fluid">{formatedDate}</p>
                  <p class="text-xs-fluid">{item.location}</p>
                  <p class="text-xs-fluid">
                    {isDone ? (
                      "Avsluttet"
                    ) : item.slug?.current ? (
                      <Button size="sm" href={item.slug.current}>
                        Meld meg på
                      </Button>
                    ) : (
                      "Internt"
                    )}
                  </p>
                </div>
              </div>
            );
          })
        }
      </div>
    </CardRightColumn>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Jobbe her?">
      <CardTitle>
        {frontPageData.vacanciesTitle}
      </CardTitle>

      <Button class="mt-grid" href="/jobbe-her"> Se ledige stillinger </Button>
    </CardRightColumn>
  </CardLayout>

  <CardLayout class="mx-grid mt-section gap-y-section">
    <Accordion class="order-1 lg:order-none">
      {
        frontPageData.vacanciesPoints.map((point, index) => (
          <AccordionItem bold open={index === 0} size="lg" title={point.title}>
            <p class="text-sm-fluid text-text-secondary max-w-[35rem]">
              {point.description}
            </p>
          </AccordionItem>
        ))
      }
    </Accordion>

    <div class="lg:col-span-3">
      <picture>
        <Image
          alt={frontPageData.vacanciesImage.alt}
          class="w-full object-cover rounded-md lg:rounded-lg aspect-[4/3] lg:aspect-[2/1]"
          image={frontPageData.vacanciesImage}
          mode="cover"
          width={1225}
          height={613}
          sizes={`calc(${threeFourth("lg")}), (min-width: 50rem) calc(${fullWidth("md")}), calc(${fullWidth("sm")})`}
        />
      </picture>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Nyheter">
      <CardTitle>Siste nytt fra Systek</CardTitle>

      <Button class="mt-grid" href="/nyheter">Se alle nyheter</Button>

      <div class="border-t border-stroke mt-section">
        <!-- todo: time element does not match figma on desktop -->
        {
          newsItems.map((item) => (
            <div class="flex justify-between py-grid border-b gap-gutter border-stroke">
              <a
                class="flex items-center gap-1 link-underline"
                href={`/nyheter/${item.slug.current}`}
              >
                <ExternalIcon class="size-2.5 lg:size-[0.595vw]" />
                <p class="text-xs-fluid">{item.title}</p>
              </a>
              <p class="md:pr-64 text-xs-fluid">
                {formatDate(item.publishedAt)}
              </p>
            </div>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>

  <Logos class="my-page" logos={logoItems} />

  <CardLayout class="border-t my-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Blogg">
      <CardTitle>Les våre siste artikler fra fag-bloggen</CardTitle>

      <Button class="mt-grid" href="https://medium.com/systek">
        Se alle blogginnlegg
      </Button>

      <div class="grid md:grid-cols-2 gap-gutter mt-section">
        {
          blogItems.map((item) => (
            <a class="group" href={item.link}>
              <picture>
                <Image
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  image={item.image}
                  mode="cover"
                  alt={item.image.alt}
                  width={603}
                  height={452}
                  sizes={`(min-width: 105rem) calc(${oneHalf("lg", threeFourth("lg"))}), (min-width: 50rem) calc(${oneHalf("md")}), calc(${fullWidth("sm")})`}
                />
              </picture>
              <p class="mt-gap font-bold text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
              <p class="text-sm-fluid leading-snug">
                Skrevet av {item.author.name}
              </p>
            </a>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>

  {
    frontPageData.contact && (
      <Contact
        button="Send en mail"
        email={frontPageData.contact.email}
        label="Kontakt"
        title={frontPageData.contact.title}
        text={frontPageData.contact.description}
        image={frontPageData.contact.image}
      />
    )
  }

  <Footer />
</Layout>
