---
import clsx from "clsx";
import ExternalIcon from "../assets/icons/external.svg";
import Button from "../components/Button.astro";
import Card from "../components/card-layout/Card.astro";
import CardLayout from "../components/card-layout/CardLayout.astro";
import Connections from "../components/Connections.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import { fetchServiceItems } from "../queries/sanity.queries";

const serviceItems = await fetchServiceItems();

const newsItems = [
  {
    title: "Opptak av summer internship",
    description:
      "Vi starter nyåret med å minne om frist for å søke på summer internship hos oss. Er deg eller noen du kjenner?",
    href: "/",
    published: "22. juni",
    updated: "3. juli",
  },
  {
    title: "Styring av strømnett",
    description:
      "Å Energi Fleksibilitet (tidligere Agder Energi) utvikler en ny verdikjede for styring av strømnettet, bestående av nettoperatørverktøyet GridTools, markedsplassen NODES og fleksibilitetstilbyderens verktøy, flextools.",
    href: "/",
    published: "12. mai",
  },
];

const logoTopItems = [
  {
    alt: "Oslo kommune",
    src: "/images/logo/oslo-kommune.svg",
  },
  {
    alt: "NAV",
    src: "/images/logo/nav.svg",
  },
  {
    alt: "Telenor",
    src: "/images/logo/telenor.svg",
  },
  {
    alt: "Mastercard",
    src: "/images/logo/mastercard.svg",
  },
];

const logoBottomItems = [
  {
    alt: "Å Energi",
    src: "/images/logo/a-energi.svg",
  },
  {
    alt: "Digdir",
    src: "/images/logo/digdir.svg",
  },
  {
    alt: "Miljødirektoratet",
    src: "/images/logo/miljodirektoratet.svg",
  },
  {
    alt: "Hydro",
    src: "/images/logo/hydro.svg",
  },
];

const workItems = [
  {
    title: "TechnipFMC",
    description: "En moderne og digital utviklerplattform",
    href: "/",
    image: {
      alt: "",
      src: "/images/temp.png",
    },
  },
  {
    title: "Elvia",
    description: "Digitalisering av Norges største nettselskap",
    href: "/",
    image: {
      alt: "",
      src: "/images/temp.png",
    },
  },
  {
    title: "LO Favør",
    description: "Utvikling og arkitektur",
    href: "/",
    image: {
      alt: "",
      src: "/images/temp.png",
    },
  },
];

const activityItems = [
  {
    title: "Fagmøte: Lag din egen iPhone app",
    date: "17. juni",
    location: "Oslo",
    href: undefined,
  },
  {
    title: "Frokost og fag: Kafka",
    date: "28. mai",
    location: "Oslo",
    href: "/",
  },
  {
    title: "Faggruppemøte: Hjemmebygget Tastatur",
    date: "27. mai",
    location: "Oslo",
    href: undefined,
  },
  {
    title: "Faggruppemøte: Lag din egen iPhone app",
    date: "17. juni",
    location: "Oslo",
    href: undefined,
  },
  {
    title: "Fagmøte: Hvordan bli en (bedre) leder",
    date: "20. juni",
    location: "Oslo",
    href: undefined,
  },
];

const blogItems = [
  {
    title: "Del 2: Designsystem",
    description: "Fra zero til hero — brukeropplevelse",
    author: "Skrevet av Johan Magne Haugland",
    href: "/",
    image: {
      alt: "",
      src: "/images/temp.png",
    },
  },
  {
    title: "Del 1: Designsystem",
    description: "Fra zero til hero",
    author: "Skrevet av Johan Magne Haugland",
    href: "/",
    image: {
      alt: "",
      src: "/images/temp.png",
    },
  },
];
---

<Layout bodyStyle="--color-background: var(--color-blue);">
  <Connections />

  <Header />

  <div
    class="grid items-start grid-cols-1 mx-grid mt-section gap-gutter lg:grid-cols-2"
  >
    <h2 class="font-light text-4xl-fluid">Digital styrke – tett på</h2>
    <div>
      <p class="text-lg-fluid">
        Hos oss møter du fagfolk som både kan og vil. Vi utforsker, samarbeider
        og skaper muligheter som gjør en forskjell for mennesker, virksomheter
        og samfunnet.
      </p>

      <Button class="mt-8">Les om folka</Button>
    </div>
  </div>

  <div class="mt-section mx-grid">
    <picture>
      <img
        class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover rounded-md"
        src="/images/temp.png"
        class="w-full"
        draggable="false"
      />
    </picture>
  </div>

  <CardLayout class="border-t mt-section border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Tjenester</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button href="/tjenester" class="mt-6 sm:mt-7">Se våre tjenester</Button>

      <div class="grid grid-cols-1 gap-gutter mt-section md:grid-cols-3">
        {
          serviceItems.map((item) => (
            item.slug?.current &&
            <Card href={item.slug?.current} color="grey">
              <div>
                <p class="font-medium text-lg-fluid group-link-underline">
                  {item.title}
                </p>
              </div>
              <p class="text-sm-fluid">{item.description}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Nyheter</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Siste nytt fra Systek
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se alle nyheter</Button>

      <!-- todo: use <time> -->
      <!-- todo: time element does not match figma on desktop -->
      <!-- todo: underline should wrap icon -->
      <div class="border-t border-stroke mt-section">
        {
          newsItems.map((item) => (
            <div class="flex justify-between py-5 border-b gap-gutter border-stroke">
              <a
                class="flex items-center gap-2 link-underline"
                href={item.href}
              >
                <ExternalIcon class="size-2.5" />
                <p class="text-xs-fluid">{item.title}</p>
              </a>

              <p class="md:pr-64 text-xs-fluid">{item.published}</p>
            </div>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <!-- todo: match with figma on mobile+tablet -->
  <CardLayout class="mt-page">
    <div class="lg:col-span-1"></div>
    <div class="lg:col-span-3">
      <div class="flex justify-between gap-3">
        {
          logoTopItems.map((item) => (
            <img
              alt={item.alt}
              class="w-[128px] h-[62px] aspect-[2/1]"
              src={item.src}
              draggable="false"
            />
          ))
        }
      </div>
      <div class="flex justify-between gap-3 mt-14">
        {
          logoBottomItems.map((item) => (
            <img
              alt={item.alt}
              class="w-[128px] h-[62px] aspect-[2/1]"
              src={item.src}
              draggable="false"
            />
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Arbeider</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Vi har lang erfaring med komplekse prosjekter fra ledende virksomheter
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se alle arbeider</Button>
    </div>
  </CardLayout>

  <!-- todo: make CardLayout with 1 column below for this -->
  <!-- todo: check mt, should be "Section-L". Not implemented? -->
  <div class="grid grid-cols-2 mx-grid md:grid-cols-4 gap-gutter mt-section">
    {
      workItems.map((item, index) => (
        <a
          href={item.href}
          class={clsx("group", index % 3 === 0 ? "col-span-2" : "col-span-1")}
        >
          <picture>
            <img
              class={clsx(
                "w-full rounded-md object-cover",
                index % 3 === 2 ? "aspect-[1/1]" : "aspect-[4/3]",
              )}
              src={item.image.src}
              alt={item.image.alt}
              draggable="false"
            />
          </picture>
          <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
            {item.title}
          </p>
          <p class="text-md-fluid">{item.description}</p>
        </a>
      ))
    }
  </div>

  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Foredrag og fagmøter</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Systek arrangerer både interne fagmøter samt åpne arrangementer for
        eksterne
      </p>

      <div class="mt-section">
        <picture>
          <img
            class="w-full rounded-md"
            src="/images/temp.png"
            class="w-full"
            draggable="false"
          />
        </picture>
      </div>

      <div class="md:border-t md:border-stroke mt-section">
        <!-- seperate markup for mobile and desktop -->
        <div
          class="flex justify-between py-5 border-b md:hidden gap-gutter border-stroke"
        >
          <p class="font-bold text-xs-fluid">Hva skjer</p>
          <p class="font-bold text-xs-fluid">Dato</p>
        </div>

        <div
          class="hidden grid-cols-4 py-5 border-b md:grid gap-gutter border-stroke"
        >
          <p class="font-bold text-xs-fluid">Hva skjer</p>
          <p class="font-bold text-xs-fluid">Dato</p>
          <p class="font-bold text-xs-fluid">Sted</p>
          <p class="font-bold text-xs-fluid">Påmelding</p>
        </div>
        {
          activityItems.map((item, index) => (
            <div>
              <div
                class={clsx(
                  "flex md:hidden justify-between items-center py-5 border-b gap-gutter border-stroke",
                  index > 1 && "line-through",
                )}
              >
                {index <= 1 && item.href ? (
                  <a href={item.href} class="flex items-center gap-2">
                    <ExternalIcon class="size-2.5" />
                    <p class="link-underline text-xs-fluid">{item.title}</p>
                  </a>
                ) : (
                  <p class="text-xs-fluid">{item.title}</p>
                )}
                <p class="text-xs-fluid">{item.date}</p>
              </div>

              <div
                class={clsx(
                  "hidden md:grid grid-cols-4 py-5 border-b gap-gutter border-stroke",
                  index > 1 && "line-through",
                )}
              >
                <p class="text-xs-fluid">{item.title}</p>
                <p class="text-xs-fluid">{item.date}</p>
                <p class="text-xs-fluid">{item.location}</p>
                <p class="text-xs-fluid">
                  {index > 1 ? (
                    "Avsluttet"
                  ) : item.href ? (
                    <Button size="sm">Meld meg på</Button>
                  ) : (
                    "Internt"
                  )}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <!-- todo: need to refactor columns of CardLayout to fix this -->
  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Jobbe her?</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Bli med og bygg konsulentselskapet du selv ønsker å jobbe i
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se ledige stillinger</Button>

      <div class="mt-section">
        <picture>
          <img
            class="w-full aspect-[4:3] lg:aspect-[2/1] object-cover rounded-md"
            src="/images/temp.png"
            class="w-full"
            draggable="false"
          />
        </picture>
      </div>
    </div>
  </CardLayout>

  <!-- todo: need to refactor columns of CardLayout to fix this -->
  <CardLayout class="border-t mt-page border-stroke">
    <div class="lg:col-span-1">
      <p class="font-bold text-sm-fluid">Blogg</p>
    </div>
    <div class="lg:col-span-3">
      <p class="max-w-[65rem] md:pr-20 font-light text-2xl-fluid">
        Les våre siste artikler fra fag-bloggen
      </p>
      <!-- check if change sm: -> md: is correct -->
      <Button class="mt-6 sm:mt-7">Se alle blogginnlegg</Button>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter mt-section">
        {
          blogItems.map((item) => (
            <a class="group" href={item.href}>
              <picture>
                <img
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  src={item.image.src}
                  alt={item.image.alt}
                  draggable="false"
                />
              </picture>
              <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
              <p class="text-sm-fluid">{item.author}</p>
            </a>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout
    breakpoint="md"
    class="border-t mt-page border-stroke gap-section"
  >
    <div class="flex flex-col md:col-span-2 gap-gutter">
      <p class="font-bold text-sm-fluid">Kontakt</p>

      <div class="mt-auto">
        <p class="font-light text-2xl-fluid">Nysjerrig?</p>
        <p class="mt-5 text-md-fluid md:mt-6">
          Om du er faglig dyktig, brenner for det du jobber med og har lyst til
          å være en del av et miljø hvor kunnskap, nysgjerrighet og inkludering
          er viktig, så vil vi gjerne snakke med deg!
        </p>

        <div class="flex items-center mt-6 gap-grid md:mt-8">
          <Button>Send en mail</Button>
          <!-- typo -->
          <a class="link-underline text-sm-fluid" href="/">Se kontakt siden</a>
        </div>
      </div>
    </div>
    <div class="md:col-span-2">
      <picture>
        <img
          class="w-full rounded-md aspect-[4/3] object-cover"
          src="/images/temp.png"
          class="w-full"
          draggable="false"
        />
      </picture>
    </div>
  </CardLayout>

  <Footer />
</Layout>
