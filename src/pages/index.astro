---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConnectionsIsland from "../components/connections/Connections.astro";
import Arrow from "../components/Arrow.astro";
import Button from "../components/Button.astro";
---

<Layout title="Systek">
  <div class="bg-blue">
    <div class="container-fluid h-[calc(100vh-32rem)] min-h-[50vh] relative">
      <ConnectionsIsland />
      <Arrow position="topLeft" class="absolute top-5 left-5" />
      <Arrow position="topRight" class="absolute top-5 right-5" />
      <Arrow position="bottomRight" class="absolute bottom-5 right-5" />
      <Arrow position="bottomLeft" class="absolute bottom-5 left-5" />
    </div>

    <Header />

    <div
      class="container-fluid grid py-16 grid-cols-1 gap-2 items-start sm:gap-5 sm:grid-cols-2"
    >
      <h2 class="text-4xl-fluid font-light">Digital styrke – tett på</h2>
      <div>
        <p class="text-lg-fluid">
          Hos oss møter du fagfolk som både kan og vil. Vi utforsker,
          samarbeider og skaper muligheter som gjør en forskjell for mennesker,
          virksomheter og samfunnet.
        </p>

        <Button class="mt-8">Les om folka</Button>
      </div>
    </div>
  </div>

  <div class="bg-linear-to-t from-off-white to-blue">
    <div class="container-fluid py-5 bg-linear-to-t from-off-white to-blue">
      <img
        class="relative w-full"
        src="/images/temp.png"
        class="pointer-events-none w-full"
      />
    </div>
  </div>

  <Footer />
</Layout>
