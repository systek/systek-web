---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import {
  fetchWorkhereSingleton,
  fetchVacantPositions,
} from "../lib/sanity.queries";
import CardLayout from "../components/card/layout/CardLayout.astro";
import CardRightColumn from "../components/card/layout/CardRightColumn.astro";
import Article from "../components/Article.astro";
import PortableText from "../components/PortableText.astro";
import Citation from "../components/card/Citation.astro";
import LinkBox from "../components/LinkBox.astro";
import Footer from "../components/Footer.astro";
import ContactTwo, {
  type ContactImage,
} from "../components/card/ContactTwo.astro";
import Faq, { type FaqItem } from "../components/card/Faq.astro";

const workhereData = await fetchWorkhereSingleton();
const vacantPositions = await fetchVacantPositions();
---

<Layout title="Jobbe her">
  <Header />
  <PageHeader image={workhereData.heroImage}>
    <CardLayout>
      <CardRightColumn title={workhereData.topLabel}>
        <h1
          class="max-w-[72rem] lg:max-w-[68.571vw] md:mr-20 lg:mr-[4.7619vw] font-light text-3xl-fluid"
        >
          {workhereData.title}
        </h1>
      </CardRightColumn>
    </CardLayout>
  </PageHeader>

  <Article>
    <PortableText value={workhereData.introText} />
  </Article>

  {
    workhereData.citation && (
      <Citation citation={workhereData.citation} class="mt-page" />
    )
  }

  <CardLayout class="mt-section mx-grid">
    <CardRightColumn>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        {workhereData.vacanciesTitle}
      </p>

      <div class="grid gap-gutter mt-section md:grid-cols-3">
        {
          vacantPositions.map((item) => (
            <LinkBox href={item.href} color="grey">
              <div>
                <p class="font-medium text-lg-fluid group-link-underline">
                  {item.title}
                </p>
              </div>
              <p class="text-sm-fluid">{item.description}</p>
              <div>
                <span>{item.location}</span>
              </div>
            </LinkBox>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>

  <CardLayout class="border-t border-stroke mt-section mx-grid">
    <CardRightColumn>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-[4.7619vw] font-light text-2xl-fluid pt-gutter"
      >
        {workhereData.contentTitel}
      </p>
    </CardRightColumn>
    <div></div>
    <div class="lg:col-span-2">
      <PortableText value={workhereData.content} />
    </div>
  </CardLayout>

  {
    workhereData.contactTwo && (
      <ContactTwo
        label={workhereData.contactTwo.label}
        title={workhereData.contactTwo.title}
        text={workhereData.contactTwo.text}
        contacts={workhereData.contactTwo.contacts as ContactImage[]}
      />
    )
  }

  <CardLayout class="border-t border-stroke mt-section mx-grid">
    <CardRightColumn title={workhereData.faqLabel}>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-[4.7619vw] font-light text-2xl-fluid pt-gutter"
      >
        {workhereData.faqTitle}
      </p>
      <Faq class="mt-section" items={workhereData.faqList as FaqItem[]} />
    </CardRightColumn>
  </CardLayout>

  {
    workhereData.tldrText && (
      <CardLayout class="mt-section mx-grid">
        <CardRightColumn>
          <p class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-[4.7619vw] font-light text-2xl-fluid">
            {workhereData.tldrTitle}
          </p>
        </CardRightColumn>
        <div />
        <div class="lg:col-span-2">
          <PortableText value={workhereData.tldrText} />
        </div>
      </CardLayout>
    )
  }

  <Footer />
</Layout>
