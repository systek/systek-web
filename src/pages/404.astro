---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout>
  <Header />

  <PageHeader title="Beklager, her var det tomt!" />

  <div class="mx-grid mt-section">
    <div
      class="mx-auto max-w-[50rem] lg:max-w-[47.619vw] flex flex-col gap-gutter"
    >
      <h2 class="text-lg-fluid">404 Not Found</h2>
      <p>
        Siden du prøvde å nå kan være slettet eller flyttet, eller det kan være
        er en feil i lenken.
      </p>
      <Button class="mt-grid" href="/">Ta meg til forsiden</Button>
    </div>
  </div>

  <Footer />
</Layout>
