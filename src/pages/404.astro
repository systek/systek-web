---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import PageHeader from "../components/PageHeader.astro";
import Article from "../components/Article.astro";
import PortableBlock from "../components/portable/PortableBlock.astro";
---

<Layout>
  <Header />

  <PageHeader title="Beklager, her var det tomt!" />

  <Article>
    <h2 class="my-grid text-lg-fluid">404 Not Found</h2>
    <p class="my-grid text-md-fluid">
      Siden du prøvde å nå kan være slettet eller flyttet, eller det kan være er
      en feil i lenken.
    </p>
    <Button class="my-grid" href="/">Ta meg til forsiden</Button>
  </Article>

  <Footer />
</Layout>
