---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Arrow from "../components/Arrow.astro";
---

<Layout>
  <Header />

  <div class="flex flex-col m-grid gap-section">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <h1 class="font-light text-4xl-fluid hyphens-auto md:text-center">
      Beklager, her var det tomt!
    </h1>

    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </div>

  <div class="mx-grid mt-section">
    <div
      class="mx-auto max-w-[50rem] lg:max-w-[47.619vw] flex flex-col gap-gutter"
    >
      <h2 class="text-lg-fluid">404 Not Found</h2>
      <p>
        Siden du prøvde å nå kan være slettet eller flyttet, eller det kan være
        er en feil i lenken.
      </p>
      <Button class="mt-grid" href="/">Ta meg til forsiden</Button>
    </div>
  </div>

  <Footer />
</Layout>
