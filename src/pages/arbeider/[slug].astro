---
import { sanityClient } from "sanity:client";
import { format } from "date-fns";
import { nb } from "date-fns/locale";

import type {
  Citation as CitationType,
  Service,
  Work,
} from "../../lib/sanity.types";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Arrow from "../../components/Arrow.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardHeader from "../../components/card/layout/CardHeader.astro";
import Button from "../../components/Button.astro";
import PortableText from "../../components/PortableText.astro";
import Citation from "../../components/card/Citation.astro";

export async function getStaticPaths() {
  const works = await sanityClient.fetch(`*[_type == "work"] { 
    slug,
    title,
    startDate,
    endDate,
    description,
    content,
    stats,
    technologies,
    citation->,
    services[]->,
  }`);
  return works.map(
    (
      work: Omit<Work, "citation" | "services"> & {
        citation: CitationType;
        services: Service[];
      }
    ) => ({
      params: { slug: work.slug.current },
      props: { work },
    })
  );
}

const { work } = Astro.props as {
  work: Omit<Work, "citation" | "services"> & {
    citation: CitationType;
    services: Service[];
  };
};
---

<Layout>
  <Header />

  <div class="flex flex-col m-grid gap-section">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <div class="grid md:grid-cols-3 gap-gutter">
      <div class="md:col-span-2 col-span-1">
        <h1 class="font-light text-3xl-fluid hyphens-auto">
          {work.description}
        </h1>
      </div>
      <div class="col-span-1 flex flex-row gap-gutter">
        <dl>
          <dt class="font-bold text-sm-fluid">Kunde</dt>
          <dd class="text-sm-fluid">{work.title}</dd>
          {
            work.startDate && (
              <>
                <dt class="font-bold text-sm-fluid mt-gutter">Periode</dt>
                <dd class="text-sm-fluid">
                  {work.startDate &&
                    format(new Date(work.startDate), "MMM yyyy", {
                      locale: nb,
                    })}
                  {work.startDate && work.endDate ? " - " : ""}
                  {work.endDate &&
                    format(new Date(work.endDate), "MMM yyyy", {
                      locale: nb,
                    })}
                </dd>
              </>
            )
          }
        </dl>
        <div class="flex flex-col items-start gap-gutter">
          {
            work.services.map((item) => (
              <span class="text-xs-fluid bg-grey-91 rounded-lg px-4">
                {item.title}
              </span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="flex justify-between">
      <Arrow position="middleLeft" />
      <Arrow position="middleRight" />
    </div>

    <picture>
      <img
        class="w-full rounded-md aspect-[4/3] lg:aspect-[2/1] object-cover my-section"
        src="/images/temp.png"
        draggable="false"
      />
    </picture>

    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </div>

  <div class="mx-grid mt-section">
    <div class="mx-auto max-w-[50rem] lg:max-w-[47.619vw]">
      <PortableText value={work.content} />
    </div>
  </div>

  {
    work.stats && (
      <div class="mx-grid grid  md:grid-cols-4 mt-section bg-yellow rounded-lg p-6">
        <div />
        <div class="col-span-3">
          <h2 class="mb-section text-2xl-fluid font-light">
            {work.stats.title}
          </h2>
          <div class="grid  md:grid-cols-3 gap-gutter">
            {work.stats.items?.map((item) => (
              <div class="flex flex-col justify-between bg-white p-4 rounded-lg h-[290px] w-full">
                <span class="text-2xl-fluid font-bold">{item.value}</span>
                <span class="text-sm-fluid">{item.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }

  {
    work.technologies !== undefined && work.technologies.length > 0 && (
      <div class="mx-grid mt-section grid  md:grid-cols-4 gap-gutter">
        <div />
        <div class="col-span-3">
          <h2 class="font-bold text-sm-fluid">
            Teknologier brukt gjennom arbeidet
          </h2>
          <div class="flex flex-row gap-2 text-sm-fluid">
            {work.technologies.map((item, index) => (
              <>
                <span>{item}</span>
                {index < work.technologies!.length - 1 && <span>·</span>}
              </>
            ))}
          </div>
        </div>
      </div>
    )
  }

  <div class="mx-grid mt-section grid md:grid-cols-4 gap-gutter">
    <div></div>
    <div class="col-span-3">
      <h2 class="font-bold text-sm-fluid">Likte du artikkelen?</h2>
      <p class="text-sm-fluid mb-[16px]">Del den med noen andre!</p>
      <Button class="_copy-link">Kopier lenke</Button>
    </div>
  </div>

  {
    work.citation && (
      <Citation title="Design og brukeropplevelse" citation={work.citation} />
    )
  }

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Kontakt">
      <p class="text-2xl-fluid font-light">
        Om du er faglig dyktig og brenner for det du jobber med så vil vi gjerne
        snakke med deg!
      </p>
      <Button class="mt-6 sm:mt-8 mb-section" href="/kontakt">
        Kontakt oss
      </Button>

      <div class="flex gap-gutter mb-[20px]">
        <picture>
          <img
            class="w-[160px] h-[160px] aspect-[1/1] object-cover"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>
        <div class="flex flex-col items-start">
          <p class="text-md-fluid font-bold">Mikael Rino Solstad</p>
          <p class="text-md-fluid">Utvikler og avdelingsleder</p>
          <span class="grow"></span>
          <a href="mailto:mikael@systek.no" class="link-underline text-xs-fluid"
            >Send Mikael en mail</a
          >
        </div>
      </div>
      <hr class="border-stroke" />
      <div class="flex gap-gutter mt-[20px]">
        <picture>
          <img
            class="w-[160px] h-[160px] aspect-[1/1] object-cover"
            src="/images/temp.png"
            draggable="false"
          />
        </picture>
        <div class="flex flex-col items-start">
          <p class="text-md-fluid font-bold">Anders Hefre</p>
          <p class="text-md-fluid">Teamleder og avdelingsleder</p>
          <span class="grow"></span>
          <a href="mailto:anders@systek.no" class="link-underline text-xs-fluid"
            >Send Mikael en mail</a
          >
        </div>
      </div>
    </CardHeader>
  </CardLayout>

  <script>
    document.querySelectorAll("._copy-link").forEach((el) => {
      el.addEventListener("click", () => {
        navigator.clipboard.writeText(window.location.href);
      });
    });
  </script>
  <Footer />
</Layout>
