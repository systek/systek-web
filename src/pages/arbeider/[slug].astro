---
import { sanityClient } from "sanity:client";
import clsx from "clsx";

import type {
  Citation as CitationType,
  Service,
  Staff,
  Work,
} from "../../lib/sanity.types";
import { fetchWorkItems } from "../../lib/sanity.queries";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import Button from "../../components/Button.astro";
import PortableText from "../../components/PortableText.astro";
import Citation from "../../components/card/Citation.astro";
import Image from "../../components/Image.astro";
import Stats from "../../components/portable/Stats.astro";
import Technologies from "../../components/portable/Technologies.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";
import Article from "../../components/Article.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";
import { vw } from "../../utils/number";
import Copy from "../../components/Copy.astro";
import { getDescription } from "../../utils/string";

type WorkExtended = Omit<Work, "citation" | "services"> & {
  citation: CitationType;
  services: Service[];
  contactTwo: Omit<Work["contactTwo"], "contacts"> & { contacts: Staff[] };
  plainContent: string;
};

export async function getStaticPaths() {
  const works = await sanityClient.fetch(`*[_type == "work"] {
    slug,
    title,
    image,
    startDate,
    endDate,
    description,
    content,
    stats,
    technologiesTitle,
    technologies,
    "plainContent": pt::text(content),
    citation->,
    services[]->,
    contactTwo{
      label,
      title,
      contacts[]->
    },
  }`);
  return works.map((work: WorkExtended) => ({
    params: { slug: work.slug.current },
    props: { work },
  }));
}

const { work } = Astro.props as {
  work: WorkExtended;
};

const _workItems = await fetchWorkItems(4);
const workItems = _workItems
  .filter((item) => item.slug.current !== work.slug.current)
  .slice(0, 3);
---

<Layout
  description={getDescription(work.plainContent)}
  image={work.image}
  title={work.description}
>
  <Header />

  <PageHeader>
    <div class="gap-section grid md:grid-cols-3">
      <div class="md:col-span-2">
        <h1 class="text-3xl-fluid font-light hyphens-auto">
          {work.description}
        </h1>
      </div>
      <div class="gap-grid grid lg:grid-cols-2">
        <div class="gap-grid grid grid-cols-2 lg:grid-cols-1">
          <div>
            <p class="text-sm-fluid font-bold">Kunde</p>
            <p class="text-sm-fluid">{work.title}</p>
          </div>
          {
            work.startDate && (
              <div>
                <p class="text-sm-fluid font-bold">Periode</p>
                <p class="text-sm-fluid">
                  {work.startDate && formatDate(work.startDate, "MMM yyyy")}
                  {work.startDate && work.endDate ? " - " : ""}
                  {work.endDate && formatDate(work.endDate, "MMM yyyy")}
                </p>
              </div>
            )
          }
        </div>
        <div class="gap-gap flex flex-col items-start">
          {
            work.services.map((item) => (
              <Button
                color="grey"
                href={`/tjenester/${item.slug.current}`}
                size="sm"
              >
                {item.title}
              </Button>
            ))
          }
        </div>
      </div>
    </div>
  </PageHeader>

  <Article>
    <PortableText value={work.content} />

    {work.stats && <Stats stats={work.stats} />}

    <Technologies
      title={work.technologiesTitle}
      technologies={work.technologies}
    />

    <Copy class="my-section" />
  </Article>

  {work.citation && <Citation title="Tjenester" citation={work.citation} />}

  {
    work.contactTwo && (
      <CardLayout class="mt-page mx-grid pt-grid border-t border-stroke">
        <CardRightColumn title={work.contactTwo.label}>
          <CardTitle>{work.contactTwo.title}</CardTitle>
          <div class="gap-gutter mt-section grid">
            {work.contactTwo.contacts.map((item: Staff, index) => (
              <>
                <div class="gap-gutter flex">
                  <picture>
                    <Image
                      class="aspect-square size-28 rounded-md md:size-40 lg:size-[9.5238vw]"
                      alt=""
                      width={400}
                      height={400}
                      image={item.image}
                      sizes={`(min-width: 105rem) ${vw(10)}, 10rem`}
                    />
                  </picture>
                  <div class="flex flex-col items-start">
                    <p class="text-md-fluid font-bold">{item.name}</p>
                    <p class="text-md-fluid">{item.position}</p>
                    {item.email && (
                      <a
                        href={`mailto:${item.email}`}
                        class="text-xs-fluid link-underline mt-auto"
                      >
                        Send {item.name.split(" ")[0]} en e-post
                      </a>
                    )}
                  </div>
                </div>
                {index < work.contactTwo.contacts.length - 1 && (
                  <hr class="border-stroke" />
                )}
              </>
            ))}
          </div>
        </CardRightColumn>
      </CardLayout>
    )
  }

  <CardLayout class="mt-page mx-grid pt-grid border-t border-stroke">
    <CardRightColumn title="Arbeider">
      <CardTitle>
        Les om hvordan vi har bistått kunder med vår kompetanse
      </CardTitle>

      <Button class="mt-grid" href="/arbeider">Se alle arbeider</Button>
    </CardRightColumn>
  </CardLayout>

  <div
    class="mx-grid gap-x-gutter gap-y-section mt-section grid grid-cols-2 items-start md:grid-cols-4"
  >
    {
      workItems.map((item, index) => (
        <a
          class={clsx("group", index % 3 === 0 && "col-span-2")}
          href={`/arbeider/${item.slug.current}`}
        >
          <picture>
            <Image
              class={clsx(
                "w-full rounded-md",
                index % 3 === 2 ? "aspect-square" : "aspect-[4/3]"
              )}
              image={item.image}
              alt={item.image.alt}
              width={index % 3 === 0 ? 2000 : 1000}
              height={index === 0 ? 1500 : index === 1 ? 750 : 1000}
              sizes={
                index % 3 === 0
                  ? `(min-width: 50rem) 50vw, 100vw`
                  : `(min-width: 50rem) 25vw, 50vw`
              }
            />
          </picture>
          <p class="mt-gap text-md-fluid group-link-underline font-bold hyphens-auto">
            {item.title}
          </p>
          <p class="text-md-fluid">{item.description}</p>
        </a>
      ))
    }
  </div>

  <Footer />
</Layout>
