---
import { sanityClient } from "sanity:client";
import clsx from "clsx";

import type {
  Citation as CitationType,
  Service,
  Work,
} from "../../lib/sanity.types";
import { fetchWorkItems } from "../../lib/sanity.queries";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import CardHeader from "../../components/card/layout/CardHeader.astro";
import Button from "../../components/Button.astro";
import PortableText from "../../components/PortableText.astro";
import Citation from "../../components/card/Citation.astro";
import Image from "../../components/Image.astro";
import Stats from "../../components/portable/Stats.astro";
import Technologies from "../../components/portable/Technologies.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";
import Article from "../../components/Article.astro";

export async function getStaticPaths() {
  const works = await sanityClient.fetch(`*[_type == "work"] { 
    slug,
    title,
    startDate,
    endDate,
    description,
    content,
    stats,
    technologies,
    citation->,
    services[]->,
  }`);
  return works.map(
    (
      work: Omit<Work, "citation" | "services"> & {
        citation: CitationType;
        services: Service[];
      }
    ) => ({
      params: { slug: work.slug.current },
      props: { work },
    })
  );
}

const { work } = Astro.props as {
  work: Omit<Work, "citation" | "services"> & {
    citation: CitationType;
    services: Service[];
  };
};

const _workItems = await fetchWorkItems(4);
const workItems = _workItems
  .filter((item) => item.slug.current !== work.slug.current)
  .slice(0, 3);

const contactItems = [
  {
    name: "Mikael Solstad",
    role: "Prosjektleder",
    email: "mikael.solstad@systek.com",
    image: "/images/temp.png",
  },
  {
    name: "Anders Hefre",
    role: "Utvikler",
    email: "anders.hefre@systek.no",
    image: "/images/temp.png",
  },
];
---

<Layout title={work.description}>
  <Header />

  <PageHeader image={work.image}>
    <div class="grid md:grid-cols-3 gap-gutter">
      <div class="md:col-span-2">
        <h1 class="font-light text-3xl-fluid hyphens-auto">
          {work.description}
        </h1>
      </div>
      <div class="flex flex-row gap-gutter">
        <dl>
          <dt class="font-bold text-sm-fluid">Kunde</dt>
          <dd class="text-sm-fluid">{work.title}</dd>
          {
            work.startDate && (
              <>
                <dt class="font-bold text-sm-fluid mt-gutter">Periode</dt>
                <dd class="text-sm-fluid">
                  {work.startDate && formatDate(work.startDate, "MMM yyyy")}
                  {work.startDate && work.endDate ? " - " : ""}
                  {work.endDate && formatDate(work.endDate, "MMM yyyy")}
                </dd>
              </>
            )
          }
        </dl>
        <div class="flex flex-col items-start gap-gutter">
          {
            work.services.map((item) => (
              <span class="text-xs-fluid bg-grey-91 rounded-lg px-4">
                {item.title}
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </PageHeader>

  <Article>
    <PortableText value={work.content} />

    <Stats stats={work.stats} />

    <Technologies technologies={work.technologies} />

    <div class="my-section">
      <p class="font-bold text-sm-fluid">Likte du artikkelen?</p>
      <p class="text-sm-fluid">Del den med noen andre!</p>
      <Button data-copy-link-button class="mt-grid">Kopier lenke</Button>
    </div>
  </Article>

  {work.citation && <Citation title="Tjenester" citation={work.citation} />}

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Kontakt">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        Om du er faglig dyktig og brenner for det du jobber med så vil vi gjerne
        snakke med deg!
      </p>
      <Button class="mt-grid" href="/kontakt">Kontakt oss</Button>

      <div class="grid gap-gutter mt-section">
        {
          contactItems.map((item, index) => (
            <>
              <div class="flex gap-gutter">
                <picture>
                  <img
                    class="w-[160px] h-[160px] rounded-md aspect-square object-cover"
                    src={item.image}
                    draggable="false"
                  />
                </picture>
                <div class="flex flex-col items-start">
                  <p class="text-md-fluid font-bold">{item.name}</p>
                  <p class="text-md-fluid">{item.role}</p>
                  <a
                    href={`mailto:${item.email}`}
                    class="link-underline text-xs-fluid mt-auto"
                  >
                    Send {item.name.split(" ")[0]} en mail
                  </a>
                </div>
              </div>
              {index < contactItems.length - 1 && <hr class="border-stroke" />}
            </>
          ))
        }
      </div>
    </CardHeader>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Arbeider">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        Les om hvordan vi har bistått kunder med vår kompetanse
      </p>

      <Button class="mt-grid" href="/arbeider">Se alle arbeider</Button>
    </CardHeader>

    <div
      class="grid grid-cols-2 lg:col-span-4 md:grid-cols-4 gap-gutter mt-section"
    >
      {
        workItems.map((item, index) => (
          <div class={clsx("group", index % 3 === 0 && "col-span-2")}>
            <a href={`/arbeider/${item.slug.current}`}>
              <picture>
                <Image
                  class={clsx(
                    "w-full rounded-md object-cover",
                    index % 3 === 2 ? "aspect-square" : "aspect-[4/3]"
                  )}
                  image={item.image}
                  alt={item.image.alt}
                  sizes={
                    index % 3 === 0
                      ? "(max-width: 384px) 100vw, 50vw"
                      : "(max-width: 384px) 50vw, 25vw"
                  }
                />
              </picture>
              <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          </div>
        ))
      }
    </div>
  </CardLayout>

  <script>
    import { DOMLoaded } from "../../utils/utils";

    DOMLoaded(() => {
      const copyLinkButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-copy-link-button]"
      );
      copyLinkButtons.forEach((button) => {
        button.addEventListener("click", () => {
          navigator.clipboard.writeText(window.location.href);
        });
      });
    });
  </script>

  <Footer />
</Layout>
