---
import CardHeader from "../../components/card/layout/CardHeader.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Contact from "../../components/card/Contact.astro";
import {
  fetchWorkerSingleton,
  fetchLogoItems,
  fetchWorkItems,
  fetchServiceItems,
} from "../../lib/sanity.queries";
import Button from "../../components/Button.astro";
import LinkBox from "../../components/LinkBox.astro";
import Image from "../../components/Image.astro";
import PageHeader from "../../components/PageHeader.astro";
import { baseWidth, oneHalf, threeFourth, vw } from "../../utils/number";

const [workersInfo, logoItems, workItems, serviceItems] = await Promise.all([
  fetchWorkerSingleton(),
  fetchLogoItems(),
  fetchWorkItems(),
  fetchServiceItems(),
]);

const index = Math.ceil(logoItems.length / 2);
const logoTopItems = logoItems.slice(0, index);
const logoBottomItems = logoItems.slice(index);
---

<Layout title="Arbeider">
  <Header active="/arbeider" />

  <PageHeader image={workersInfo.heroImage}>
    <CardLayout>
      <CardHeader title="Arbeider">
        <p
          class="max-w-[72rem] lg:max-w-[68.571vw] md:mr-20 lg:mr-[4.7619vw] font-light text-3xl-fluid"
        >
          {workersInfo.title}
        </p>
      </CardHeader>
    </CardLayout>
  </PageHeader>

  <CardLayout class="mt-section mx-grid">
    <CardHeader>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        {workersInfo.logoTitle}
      </p>
    </CardHeader>
  </CardLayout>

  <CardLayout class="mt-section mx-grid">
    <CardHeader>
      <div></div>
      <div class="grid gap-section lg:col-span-3">
        <div class="grid grid-cols-2 gap-section md:flex md:justify-between">
          {
            logoTopItems.map((item) => (
              <Image
                class="w-[128px] h-[62px] even:ml-auto md:even:ml-0"
                image={item.image}
                mode="cover"
                alt={item.image.alt}
                width={128}
                height={62}
              />
            ))
          }
        </div>
        <div class="grid grid-cols-2 gap-section md:flex md:justify-between">
          {
            logoBottomItems.map((item) => (
              <Image
                class="w-[128px] h-[62px] even:ml-auto md:even:ml-0"
                image={item.image}
                alt={item.image.alt}
                mode="cover"
                width={128}
                height={62}
              />
            ))
          }
        </div>
      </div>
    </CardHeader>
  </CardLayout>

  <CardLayout class="mt-page mx-grid">
    <CardHeader>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        {workersInfo.listTitle}
      </p>

      <div
        class="grid md:grid-cols-2 gap-x-gutter mt-section gap-y-grid-lg md:gap-y-section-md lg:gap-y-section-lg"
      >
        {
          workItems.map((item) => (
            <a class="group" href={`/arbeider/${item.slug.current}`}>
              <picture>
                <Image
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  image={item.image}
                  mode="cover"
                  alt={item.image.alt}
                  width={603}
                  height={452}
                  sizes={`(min-width: 105rem) calc(${oneHalf("lg", threeFourth("lg"))}), (min-width: 50rem) calc(${oneHalf("md")}), calc(${baseWidth("sm")}`}
                />
              </picture>
              <p class="mt-2 font-bold text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))
        }
      </div>
    </CardHeader>
  </CardLayout>
</Layout>

<CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
  <CardHeader title="Tjenester">
    <p
      class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
    >
      {workersInfo.servicesTitle}
    </p>

    <Button href="/tjenester" class="mt-grid">Se våre tjenester</Button>
  </CardHeader>
  <div></div>
  <div class="grid lg:col-span-3 gap-gutter mt-section md:grid-cols-3">
    {
      serviceItems.map((item) => (
        <LinkBox href={`/tjenester/${item.slug.current}`} color="grey">
          <div>
            <p class="font-medium text-lg-fluid group-link-underline">
              {item.title}
            </p>
          </div>
          <p class="text-sm-fluid">{item.description}</p>
        </LinkBox>
      ))
    }
  </div>
</CardLayout>

{
  workersInfo.contact && (
    <Contact
      button={`Send ${workersInfo.contact.name} en e-post`}
      email={workersInfo.contact.email}
      label="Kontakt"
      title={workersInfo.contact.title}
      text={workersInfo.contact.description}
      image={workersInfo.contact.image}
    />
  )
}

<Footer />
