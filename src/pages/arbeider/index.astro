---
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Contact from "../../components/card/Contact.astro";
import {
  fetchWorkerSingleton,
  fetchLogoItems,
  fetchWorkItems,
  fetchServiceItems,
} from "../../lib/sanity.queries";
import Button from "../../components/Button.astro";
import LinkBox from "../../components/LinkBox.astro";
import Image from "../../components/Image.astro";
import PageHeader from "../../components/PageHeader.astro";
import { fullWidth, oneHalf, threeFourth } from "../../utils/number";
import Logos from "../../components/logo/Logos.astro";

const [workersInfo, logoItems, workItems, serviceItems] = await Promise.all([
  fetchWorkerSingleton(),
  fetchLogoItems(12),
  fetchWorkItems(),
  fetchServiceItems(),
]);
---

<Layout title="Arbeider">
  <Header active="/arbeider" />

  <PageHeader image={workersInfo.heroImage}>
    <CardLayout>
      <CardRightColumn title="Arbeider">
        <p
          class="max-w-[72rem] lg:max-w-[68.571vw] md:mr-20 lg:mr-[4.7619vw] font-light text-3xl-fluid"
        >
          {workersInfo.title}
        </p>
      </CardRightColumn>
    </CardLayout>
  </PageHeader>

  <CardLayout class="mt-section mx-grid">
    <CardRightColumn>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        {workersInfo.logoTitle}
      </p>
    </CardRightColumn>
  </CardLayout>

  <Logos class="mt-section mb-page" logos={logoItems} />

  <CardLayout class="mt-page mx-grid">
    <CardRightColumn>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
      >
        {workersInfo.listTitle}
      </p>

      <div
        class="grid md:grid-cols-2 gap-x-gutter mt-section gap-y-grid-lg md:gap-y-section-md lg:gap-y-section-lg"
      >
        {
          workItems.map((item) => (
            <a class="group" href={`/arbeider/${item.slug.current}`}>
              <picture>
                <Image
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  image={item.image}
                  mode="cover"
                  alt={item.image.alt}
                  width={603}
                  height={452}
                  sizes={`(min-width: 105rem) calc(${oneHalf("lg", threeFourth("lg"))}), (min-width: 50rem) calc(${oneHalf("md")}), calc(${fullWidth("sm")})`}
                />
              </picture>
              <p class="mt-gap font-bold text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>
</Layout>

<CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
  <CardRightColumn title="Tjenester">
    <p
      class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 lg:mr-[4.7619vw] font-light text-2xl-fluid"
    >
      {workersInfo.servicesTitle}
    </p>

    <Button href="/tjenester" class="mt-grid">Se våre tjenester</Button>

    <div class="grid gap-gutter mt-section md:grid-cols-3">
      {
        serviceItems.map((item) => (
          <LinkBox href={`/tjenester/${item.slug.current}`} color="grey">
            <div>
              <p class="font-medium text-lg-fluid group-link-underline">
                {item.title}
              </p>
            </div>
            <p class="text-sm-fluid">{item.description}</p>
          </LinkBox>
        ))
      }
    </div>
  </CardRightColumn>
</CardLayout>

{
  workersInfo.contact && (
    <Contact
      button={`Send ${workersInfo.contact.name} en e-post`}
      email={workersInfo.contact.email}
      label="Kontakt"
      title={workersInfo.contact.title}
      text={workersInfo.contact.description}
      image={workersInfo.contact.image}
    />
  )
}

<Footer />
