---
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import Contact from "../../components/card/Contact.astro";
import {
  fetchWorkerSingleton,
  fetchLogoItems,
  fetchWorkItems,
  fetchServiceItems,
} from "../../lib/sanity.queries";
import Button from "../../components/Button.astro";
import GridListItem from "../../components/grid-list/GridListItem.astro";
import Image from "../../components/Image.astro";
import PageHeader from "../../components/PageHeader.astro";
import Logos from "../../components/logo/Logos.astro";
import GridList from "../../components/grid-list/GridList.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";

const [workersInfo, logoItems, workItems, serviceItems] = await Promise.all([
  fetchWorkerSingleton(),
  fetchLogoItems(12),
  fetchWorkItems(),
  fetchServiceItems(),
]);
---

<Layout
  description={workersInfo.title}
  title="Arbeider"
  image={workersInfo.heroImage}
>
  <Header active="/arbeider" />

  <PageHeader image={workersInfo.heroImage}>
    <CardLayout>
      <CardRightColumn title="Arbeider" titleAs="h1">
        <h2
          class="text-3xl-fluid max-w-[72rem] font-light md:mr-20 lg:mr-[4.7619vw] lg:max-w-[68.571vw]"
        >
          {workersInfo.title}
        </h2>
      </CardRightColumn>
    </CardLayout>
  </PageHeader>

  <CardLayout class="mt-section mx-grid">
    <CardRightColumn>
      <CardTitle titleAs="h2">
        {workersInfo.logoTitle}
      </CardTitle>

      <Logos class="mt-section" logos={logoItems} />

      <CardTitle titleAs="h2" class="mt-page">
        {workersInfo.listTitle}
      </CardTitle>

      <div
        class="gap-x-gutter mt-section gap-y-section grid items-start md:grid-cols-2"
      >
        {
          workItems.map((item) => (
            <a class="group" href={`/arbeider/${item.slug.current}`}>
              <picture>
                <Image
                  class="aspect-[4/3] w-full rounded-md"
                  image={item.image}
                  alt={item.image.alt}
                  width={1000}
                  height={750}
                  sizes="(min-width: 105rem) 37.5vw, (min-width: 50rem) 50vw, 100vw"
                />
              </picture>
              <p class="mt-gap text-md-fluid group-link-underline font-bold">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>
</Layout>

<CardLayout class="mt-page mx-grid pt-grid border-t border-stroke">
  <CardRightColumn title="Tjenester">
    <CardTitle>
      {workersInfo.servicesTitle}
    </CardTitle>

    <Button href="/tjenester" class="mt-grid">Se våre tjenester</Button>

    <GridList class="mt-section">
      {
        serviceItems.map((item) => (
          <GridListItem
            href={`/tjenester/${item.slug.current}`}
            title={item.title}
          >
            <p class="text-sm-fluid">{item.description}</p>
          </GridListItem>
        ))
      }
    </GridList>
  </CardRightColumn>
</CardLayout>

{
  workersInfo.contact && (
    <Contact
      button={`Send ${workersInfo.contact.name} en e-post`}
      email={workersInfo.contact.email}
      label="Kontakt"
      title={workersInfo.contact.title}
      text={workersInfo.contact.description}
      image={workersInfo.contact.image}
    />
  )
}

<Footer />
