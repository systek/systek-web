---
import Arrow from "../../components/Arrow.astro";
import CardHeader from "../../components/card-layout/CardHeader.astro";
import CardLayout from "../../components/card-layout/CardLayout.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import Layout from "../../layouts/Layout.astro";
import ContactCard from "../../components/ContactCard.astro";
import {
  fetchLogoItems,
  fetchWorkItems,
  fetchServiceItems,
} from "../../lib/sanity.queries";
import Button from "../../components/Button.astro";
import LinkBox from "../../components/LinkBox.astro";
import Image from "../../components/Image.astro";

const [logoItems, workItems, serviceItems] = await Promise.all([
  fetchLogoItems(),
  fetchWorkItems(),
  fetchServiceItems(),
]);

const index = Math.ceil(logoItems.length / 2);
const logoTopItems = logoItems.slice(0, index);
const logoBottomItems = logoItems.slice(index);
---

<Layout>
  <Header active="/arbeider" />

  <div class="flex flex-col m-grid gap-section">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <CardLayout>
      <CardHeader title="Arbeider">
        <p
          class="max-w-[72rem] lg:max-w-[68.571vw] md:mr-20 font-light text-3xl-fluid"
        >
          Se hvordan vi har løst utfordringer og skapt smarte digitale
          muligheter for kunder i ulike bransjer
        </p>
      </CardHeader>
    </CardLayout>

    <div class="flex justify-between">
      <Arrow position="middleLeft" />
      <Arrow position="middleRight" />
    </div>

    <picture>
      <img
        class="w-full rounded-md aspect-[4/3] lg:aspect-[2/1] object-cover"
        src="/images/temp.png"
        draggable="false"
      />
    </picture>
    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </div>

  <CardLayout class="mt-section mx-grid">
    <CardHeader>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Vi har lang erfaring med komplekse IT-prosjekter fra ledende
        virksomheter fra offentlig og privat sektor
      </p>
    </CardHeader>
  </CardLayout>

  <CardLayout class="mt-section mx-grid">
    <CardHeader>
      <div></div>
      <div class="grid gap-section md:gap-14 lg:col-span-3">
        <div
          class="grid grid-cols-2 gap-section md:gap-3 md:flex md:justify-between"
        >
          {
            logoTopItems.map((item) => (
              <Image
                class="w-[128px] h-[62px] even:ml-auto md:even:ml-0"
                image={item.image}
                alt={item.image.alt}
                width={128}
                height={62}
              />
            ))
          }
        </div>
        <div
          class="grid grid-cols-2 gap-section md:gap-3 md:flex md:justify-between"
        >
          {
            logoBottomItems.map((item) => (
              <Image
                class="w-[128px] h-[62px] even:ml-auto md:even:ml-0"
                image={item.image}
                alt={item.image.alt}
                width={128}
                height={62}
              />
            ))
          }
        </div>
      </div>
    </CardHeader>
  </CardLayout>

  <CardLayout class="mt-page mx-grid">
    <CardHeader>
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Les om hvordan vi har bistått noen av våre kunder med vår kompetanse
      </p>
    </CardHeader>

    <div></div>
    <div class="lg:col-span-3">
      <div
        class="grid md:grid-cols-2 gap-x-gutter mt-section gap-y-5 md:gap-y-section-md lg:gap-y-section-lg"
      >
        {
          workItems.map((item, index) => (
            <a href={`/arbeider/${item.slug.current}`}>
              <picture>
                <Image
                  class="w-full rounded-md object-cover aspect-[4/3]"
                  image={item.image}
                  alt={item.image.alt}
                />
              </picture>
              <p class="mt-3 font-bold sm:mt-4 text-md-fluid group-link-underline">
                {item.title}
              </p>
              <p class="text-md-fluid">{item.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </CardLayout>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardHeader title="Tjenester">
      <p
        class="max-w-[65rem] lg:max-w-[61.905vw] md:mr-20 font-light text-2xl-fluid"
      >
        Vi hjelper deg fra idé til drift og videreutvikling av digitale
        løsninger
      </p>

      <!-- check if change sm: -> md: is correct -->
      <Button href="/tjenester" class="mt-6 sm:mt-7">Se våre tjenester</Button>
    </CardHeader>
    <div></div>
    <div class="grid lg:col-span-3 gap-gutter mt-section md:grid-cols-3">
      {
        serviceItems.map((item) => (
          <LinkBox href={`/tjenester/${item.slug.current}`} color="grey">
            <div>
              <p class="font-medium text-lg-fluid group-link-underline">
                {item.title}
              </p>
            </div>
            <p class="text-sm-fluid">{item.description}</p>
          </LinkBox>
        ))
      }
    </div>
  </CardLayout>

  <ContactCard
    title="Har du et prosjekt hvor du trenger dyktige fagfolk?"
    email="charlotte@systek.no"
    text="Hvis du trenger bistand på et prosjekt eller bare lurer på hva vi kan hjelpe deg med, ta kontakt med vår forretningsutvikler Charlotte."
    name="Charlotte"
  />

  <Footer />
</Layout>
