---
import { sanityClient } from "sanity:client";
import type { Page } from "../lib/sanity.types";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PortableText from "../components/PortableText.astro";
import { getOGImageUrl } from "../utils/image";
import PageHeader from "../components/PageHeader.astro";

export async function getStaticPaths() {
  const pages = await sanityClient.fetch(`*[_type == "page"] { 
    slug,
    title,
    heroImage,
    content[]{
      ...,
      _type == "file" => {
        ...,
        asset->
      }
    }
  }`);
  return pages.map((page: Page) => ({
    params: { slug: page.slug.current },
    props: { page },
  }));
}

const { page } = Astro.props as { page: Page };
---

<Layout
  title={page.title}
  image={page.heroImage?.asset?._ref &&
    getOGImageUrl(page.heroImage.asset._ref)}
>
  <Header />

  <PageHeader image={page.heroImage} title={page.title} />

  <div class="mx-grid mt-section">
    <div class="mx-auto max-w-[50rem] lg:max-w-[47.619vw]">
      <PortableText value={page.content} />
    </div>
  </div>

  <Footer />
</Layout>
