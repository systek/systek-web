---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ExternalIcon from "../../assets/icons/external.svg";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import { fetchNewsItems } from "../../lib/sanity.queries";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";

// Todo make more pages?
const newsItems = await fetchNewsItems(10, 0);
---

<Layout description="Siste nytt fra Systek" title="Nyheter">
  <Header />

  <PageHeader title="Siste nytt fra Systek" />

  <CardLayout class="mt-page mx-grid pt-grid">
    <CardRightColumn title="Nyheter">
      {
        newsItems.map((item) => (
          <div class="py-grid gap-gutter flex justify-between border-b border-stroke">
            <a
              class="link-underline flex items-center gap-1"
              href={`/nyheter/${item.slug.current}`}
            >
              <ExternalIcon class="size-2.5 shrink-0 lg:size-[0.595vw]" />
              <p class="text-xs-fluid">{item.title}</p>
            </a>
            <p class="text-xs-fluid whitespace-nowrap md:pr-64">
              {formatDate(item.publishedAt)}
            </p>
          </div>
        ))
      }
    </CardRightColumn>
  </CardLayout>

  <Footer />
</Layout>
