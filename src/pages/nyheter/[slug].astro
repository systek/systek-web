---
import { sanityClient } from "sanity:client";

import type { News, Staff } from "../../lib/sanity.types";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import ExternalIcon from "../../assets/icons/external.svg";
import Button from "../../components/Button.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";
import Article from "../../components/Article.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";
import Copy from "../../components/Copy.astro";

type NewsExtended = Omit<News, "author"> & { author?: Staff };

export async function getStaticPaths() {
  const newsItems = await sanityClient.fetch<
    NewsExtended[]
  >(`*[_type == "news"] { 
    ...,
    author->,
  }`);
  return newsItems.map((news) => ({
    params: { slug: news.slug.current },
    props: {
      news,
      otherNews: newsItems.filter((on) => on._id !== news._id).slice(0, 5),
    },
  }));
}

const { news, otherNews } = Astro.props as {
  news: NewsExtended;
  otherNews: NewsExtended[];
};
---

<Layout title={news.title}>
  <Header />

  <PageHeader>
    <div class="gap-section grid md:grid-cols-3">
      <div class="md:col-span-2">
        <h1 class="text-3xl-fluid font-light hyphens-auto">
          {news.title}
        </h1>
      </div>
      <div class="gap-grid grid lg:grid-cols-2">
        <div class="gap-grid grid grid-cols-2 lg:grid-cols-1">
          {
            news.author && (
              <div>
                <p class="text-sm-fluid font-bold">Skrevet av</p>
                <p class="text-sm-fluid">{news.author.name}</p>
              </div>
            )
          }
          <div>
            <p class="text-sm-fluid font-bold">Publisert</p>
            <p class="text-sm-fluid">
              {formatDate(news.publishedAt, "d. MMMM yyyy")}
            </p>
          </div>
        </div>
        {
          news.tags && news.tags?.length > 0 && (
            <div class="gap-gap flex flex-col items-start">
              {news.tags?.map((item) => (
                <span class="px-gap text-xs-fluid rounded-full border border-grey-91 bg-grey-91 py-0 text-text">
                  {item}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </PageHeader>

  <Article>
    <PortableText value={news.content} />

    <Copy class="my-section" />
  </Article>

  <CardLayout class="mt-page mx-grid pt-grid border-t border-stroke">
    <CardRightColumn title="Nyheter">
      <CardTitle>Siste nytt fra Systek</CardTitle>

      <Button class="mt-grid" href="/nyheter">Se alle nyheter</Button>

      <div class="mt-section border-t border-stroke">
        {
          otherNews.map((item) => (
            <div class="py-grid gap-gutter flex justify-between border-b border-stroke">
              <a
                class="link-underline flex items-center gap-1"
                href={`/nyheter/${item.slug.current}`}
              >
                <ExternalIcon class="size-2.5 shrink-0 lg:size-[0.595vw]" />
                <p class="text-xs-fluid whitespace-nowrap">{item.title}</p>
              </a>
              <p class="text-xs-fluid hidden whitespace-nowrap md:block">
                {formatDate(item.publishedAt)}
              </p>
              <p class="text-xs-fluid block whitespace-nowrap md:hidden">
                {formatDate(item.publishedAt, "d. MMM")}
              </p>
            </div>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>

  <Footer />
</Layout>
