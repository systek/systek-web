---
import { sanityClient } from "sanity:client";

import type { News, Staff } from "../../lib/sanity.types";
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PortableText from "../../components/PortableText.astro";
import ExternalIcon from "../../assets/icons/external.svg";
import Button from "../../components/Button.astro";
import CardRightColumn from "../../components/card/layout/CardRightColumn.astro";
import CardLayout from "../../components/card/layout/CardLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { formatDate } from "../../utils/date";
import Article from "../../components/Article.astro";
import CardTitle from "../../components/card/layout/CardTitle.astro";

type NewsExtended = Omit<News, "author"> & { author?: Staff };

export async function getStaticPaths() {
  const newsItems = await sanityClient.fetch<
    NewsExtended[]
  >(`*[_type == "news"] { 
    ...,
    author->,
  }`);
  return newsItems.map((news) => ({
    params: { slug: news.slug.current },
    props: {
      news,
      otherNews: newsItems.filter((on) => on._id !== news._id).slice(0, 5),
    },
  }));
}

const { news, otherNews } = Astro.props as {
  news: NewsExtended;
  otherNews: NewsExtended[];
};
---

<Layout title={news.title}>
  <Header />

  <PageHeader>
    <div class="grid md:grid-cols-3 gap-gutter">
      <div class="md:col-span-2">
        <h1 class="font-light text-3xl-fluid hyphens-auto">
          {news.title}
        </h1>
      </div>
      <div class="flex flex-row gap-gutter">
        <dl class="w-1/2">
          {
            news.author && (
              <>
                <dt class="font-bold text-sm-fluid">Skrevet av</dt>
                <dd class="text-sm-fluid">{news.author.name}</dd>
              </>
            )
          }

          <dt class="font-bold text-sm-fluid">Publisert</dt>
          <dd class="text-sm-fluid">
            {formatDate(news.publishedAt, "d. MMMM yyyy")}
          </dd>
        </dl>
        {
          news.tags && news.tags?.length > 0 && (
            <div class="flex flex-col items-start gap-gutter w-1/2">
              {news.tags?.map((item) => (
                <span class="text-xs-fluid bg-grey-91 rounded-lg px-4">
                  {item}
                </span>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </PageHeader>

  <Article>
    <PortableText value={news.content} />
  </Article>

  <CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
    <CardRightColumn title="Nyheter">
      <CardTitle>Siste nytt fra Systek</CardTitle>

      <Button class="mt-grid" href="/nyheter">Se alle nyheter</Button>

      <div class="border-t border-stroke mt-section">
        <!-- todo: time element does not match figma on desktop -->
        {
          otherNews.map((item) => (
            <div class="flex justify-between py-grid border-b gap-gutter border-stroke">
              <a
                class="flex items-center gap-1 link-underline"
                href={`/nyheter/${item.slug.current}`}
              >
                <ExternalIcon class="size-2.5 lg:size-[0.595vw]" />
                <p class="text-xs-fluid">{item.title}</p>
              </a>
              <p class="md:pr-64 text-xs-fluid">
                {formatDate(item.publishedAt)}
              </p>
            </div>
          ))
        }
      </div>
    </CardRightColumn>
  </CardLayout>

  <Footer />
</Layout>
