---
import Arrow from "./Arrow.astro";
---

<div class="h-[calc(100svh-var(--height-header))] relative">
  <Arrow color="black" position="topLeft" class="absolute top-grid left-grid" />
  <Arrow
    color="black"
    position="topRight"
    class="absolute top-grid right-grid"
  />
  <Arrow
    color="black"
    position="bottomRight"
    class="absolute bottom-grid right-grid"
  />
  <Arrow
    color="black"
    position="bottomLeft"
    class="absolute bottom-grid left-grid"
  />
  <div
    role="img"
    aria-label="Bra folk, smarte løsninger"
    data-connections-canvas
    class="absolute inset-0 overflow-hidden pointer-events-none"
  >
  </div>
</div>

<script>
  import { DOMLoaded, handleResize, widthChecker } from "../utils/utils";
  import { setupConnections, setupObserver } from "../utils/connections";

  DOMLoaded(() => {
    const canvas = document.querySelector(
      "[data-connections-canvas]"
    ) as HTMLDivElement;
    const hasViewportWidthChanged = widthChecker();

    setupConnections(canvas);
    setupObserver(canvas);

    handleResize(() => {
      if (hasViewportWidthChanged()) {
        setupConnections(canvas);
      }
    });
  });
</script>
