---
import Arrow from "./Arrow.astro";
---

<div class="relative h-[calc(100svh-var(--height-header))]">
  <Arrow color="black" position="topLeft" class="top-grid left-grid absolute" />
  <Arrow
    color="black"
    position="topRight"
    class="top-grid right-grid absolute"
  />
  <Arrow
    color="black"
    position="bottomRight"
    class="bottom-grid right-grid absolute"
  />
  <Arrow
    color="black"
    position="bottomLeft"
    class="bottom-grid left-grid absolute"
  />
  <div
    role="img"
    aria-label="Bra folk, smarte løsninger"
    data-connections-canvas
    class="pointer-events-none absolute inset-0 overflow-hidden"
  >
  </div>
</div>

<script>
  import { DOMLoaded, handleResize, widthChecker } from "../utils/utils";
  import { setupConnections, setupObserver } from "../utils/connections";

  DOMLoaded(() => {
    const canvas = document.querySelector(
      "[data-connections-canvas]",
    ) as HTMLDivElement;
    const hasViewportWidthChanged = widthChecker();

    setupConnections(canvas);
    setupObserver(canvas);

    handleResize(() => {
      if (hasViewportWidthChanged()) {
        setupConnections(canvas);
      }
    });
  });
</script>
