---
import Arrow from "./Arrow.astro";
---

<div class="relative h-[calc(100svh-var(--height-header))]">
  <Arrow color="black" position="topLeft" class="top-grid left-grid absolute" />
  <Arrow
    color="black"
    position="topRight"
    class="top-grid right-grid absolute"
  />
  <Arrow
    color="black"
    position="bottomRight"
    class="bottom-grid right-grid absolute"
  />
  <Arrow
    color="black"
    position="bottomLeft"
    class="bottom-grid left-grid absolute"
  />
  <div
    role="img"
    aria-label="Bra folk, smarte løsninger"
    data-connections-canvas
    class="absolute inset-0 overflow-hidden select-none [-webkit-touch-callout:none]"
  />
</div>

<script>
  import { onWidthChange } from "../utils/utils";
  import { setupConnections, setupObserver } from "../utils/connections";

  const canvas = document.querySelector<HTMLDivElement>(
    "[data-connections-canvas]",
  )!;

  setupObserver(canvas);
  // Text is measured when the boxes are created, so wait for the web font
  document.fonts.ready.then(() => setupConnections(canvas));
  onWidthChange(() => setupConnections(canvas));
</script>
