---
interface Props {
  class?: string;
  href: string;
  title: string;
}

const { class: className, href, title } = Astro.props;
---

<a
  class:list={[
    "gap-section group flex flex-col justify-between rounded-lg p-5",
    "md:p-6 lg:aspect-4/3 lg:p-[1.4286vw]",
    "bg-grey-91 transition-colors duration-250 hover:bg-orange",
    className,
  ]}
  href={href}
>
  <div>
    <p class="text-lg-fluid group-link-underline font-medium">{title}</p>
  </div>

  <slot />
</a>
