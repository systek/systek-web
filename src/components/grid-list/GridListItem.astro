---
interface Props {
  class?: string;
  href: string;
  title: string;
}

const { class: className, href, title } = Astro.props;
---

<a
  class:list={[
    "flex flex-col justify-between gap-section p-5 rounded-lg group",
    "md:p-6 lg:p-[1.4286vw] lg:aspect-[4/3]",
    "duration-250 transition-colors bg-grey-91 hover:bg-orange",
    className,
  ]}
  href={href}
>
  <div>
    <p class="font-medium text-lg-fluid group-link-underline">{title}</p>
  </div>

  <slot />
</a>
