---
import TitleAs from "../TitleAs.astro";

interface Props {
  class?: string;
  href: string;
  title: string;
  titleAs: "h2" | "h3" | "h4" | "h5" | "h6";
}

const { class: className, href, title, titleAs } = Astro.props;
---

<a
  class:list={[
    "gap-section group flex flex-col justify-between rounded-lg p-5",
    "md:p-6 lg:aspect-4/3 lg:p-[1.4286vw]",
    "bg-grey-91 transition-colors duration-250 hover:bg-orange",
    className,
  ]}
  href={href}
>
  <div>
    <TitleAs
      as={titleAs}
      class="text-lg-fluid group-link-underline font-medium"
    >
      {title}
    </TitleAs>
  </div>

  <slot />
</a>
