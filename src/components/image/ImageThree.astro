---
import type {
  ImagesThreeFirst,
  ImagesThreeSecond,
  ImagesThreeThird,
} from "../../lib/sanity.types";
import Image from "../Image.astro";

interface Props {
  node?: {
    first: ImagesThreeFirst;
    second: ImagesThreeSecond;
    third: ImagesThreeThird;
  };
}

const { node } = Astro.props;

if (!node?.first || !node.second || !node.third) {
  throw new Error("All three images must be provided");
}

const { first, second, third } = node;
---

<div class="mt-section gap-gutter grid grid-cols-2 lg:col-span-4 lg:grid-cols-2">
  <div class="gap-gutter flex flex-col lg:flex-row">
    <picture>
      <Image
        image={first}
        alt={first.alt ?? ""}
        class="aspect-square w-full rounded-md"
      />
    </picture>

    <picture>
      <Image
        image={second}
        alt={second.alt ?? ""}
        class="aspect-square w-full rounded-md lg:aspect-4/5"
      />
    </picture>
  </div>

  <div class="gap-gutter flex flex-col lg:flex-row">
    <picture>
      <Image
        image={third}
        alt={third.alt ?? ""}
        class="aspect-4/5 w-full rounded-md lg:aspect-4/3"
      />
    </picture>
  </div>
</div>
