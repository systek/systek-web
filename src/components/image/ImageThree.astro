---
import type { Image as SanityImage } from "sanity";
import Image from "../Image.astro";

type ImageWithAlt = SanityImage & {
  alt: string;
};

interface Props {
  node?: {
    first: ImageWithAlt;
    second: ImageWithAlt;
    third: ImageWithAlt;
  };
}

const { node } = Astro.props;

if (!node?.first || !node.second || !node.third) {
  throw new Error("All three images must be provided");
}

const { first, second, third } = node;
/*
todo: test this component, set width/height/sizes
*/
---

<div
  class="mt-section grid grid-cols-2 gap-gutter lg:grid-cols-2 lg:col-span-4"
>
  <div class="flex flex-col gap-gutter lg:flex-row">
    <picture>
      <Image
        image={first}
        alt={first.alt}
        class="w-full rounded-md aspect-square"
      />
    </picture>

    <picture>
      <Image
        image={second}
        alt={second.alt}
        class="w-full rounded-md aspect-square lg:aspect-[4/5]"
      />
    </picture>
  </div>

  <div class="flex flex-col gap-gutter lg:flex-row">
    <picture>
      <Image
        image={third}
        alt={third.alt}
        class="w-full rounded-md aspect-[4/5] lg:aspect-[4/3]"
      />
    </picture>
  </div>
</div>
