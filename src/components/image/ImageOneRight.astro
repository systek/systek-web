---
import type { Image as SanityImage } from "sanity";
import { fullWidth, vw } from "../../utils/number";
import Image from "../Image.astro";

interface Props {
  node: SanityImage & { caption: string };
}

const { node } = Astro.props;
---

<div class="my-section md:mr-[calc(50%-50vw+(var(--width-scrollbar)/2)))]">
  <figure class="md:mr-grid-md lg:mr-grid-lg">
    <Image
      class="w-full rounded-lg aspect-[2/1] hidden md:block"
      image={node}
      width={2000}
      height={1000}
      sizes={`75vw`}
    />

    <Image
      class="w-full rounded-md aspect-[4/3] block md:hidden"
      image={node}
      width={1000}
      height={750}
      sizes={`100vw`}
    />

    <figcaption class="mt-gutter text-xs-fluid">
      {node.caption}
    </figcaption>
  </figure>
</div>
