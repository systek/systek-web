---
import type { Image as SanityImage } from "sanity";
import { baseWidth, vw } from "../../utils/number";
import Image from "../Image.astro";

interface Props {
  node: SanityImage & { caption: string };
}

const { node } = Astro.props;
---

<div class="my-section md:mr-[calc(50%-50vw+(var(--width-scrollbar)/2)))]">
  <figure class="md:mr-grid-md lg:mr-grid-lg">
    <Image
      class="w-full object-cover rounded-md md:rounded-lg aspect-[4/3] md:aspect-[2/1]"
      mode="cover"
      image={node}
      width={1220}
      height={610}
      sizes={`(min-width: 105rem) calc(${vw(50)} + (100vw - ${vw(50)} + var(--width-scrollbar)) / 2 - ${vw(1.25)}), (min-width: 50rem) calc(50rem + (100vw - 50rem + var(--width-scrollbar)) / 2 - 1.25rem), calc(${baseWidth("sm")})`}
    />
    <figcaption class="mt-gutter text-xs-fluid">
      {node.caption}
    </figcaption>
  </figure>
</div>
