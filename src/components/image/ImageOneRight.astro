---
import type { Image as SanityImage } from "sanity";

import Image from "../Image.astro";

interface Props {
  node: SanityImage & { caption: string };
}

const { node } = Astro.props;
---

<div class="my-section md:mr-[calc(50%-50vw+(var(--width-scrollbar)/2))]">
  <figure class="md:mr-grid-md lg:mr-grid-lg">
    <Image
      class="hidden aspect-2/1 w-full rounded-lg md:block"
      image={node}
      alt={node.alt}
      width={2000}
      height={1000}
      sizes="75vw"
    />

    <Image
      class="block aspect-4/3 w-full rounded-md md:hidden"
      image={node}
      alt={node.alt}
      width={1000}
      height={750}
      sizes="100vw"
    />

    {
      node.caption && (
        <figcaption class="mt-gap text-xs-fluid">{node.caption}</figcaption>
      )
    }
  </figure>
</div>
