---
import type { Image as SanityImage } from "sanity";
import { vw } from "../../utils/number";
import Image from "../Image.astro";

interface Props {
  node: SanityImage & { caption: string };
}

const { node } = Astro.props;
---

<div class="my-section md:mx-[calc(50%-50vw+(var(--width-scrollbar)/2)))]">
  <div class="md:mx-grid-md">
    <figure class="md:mx-auto md:max-w-[68rem] lg:max-w-[64.7619vw]">
      <Image
        class="w-full rounded-lg aspect-[2/1] hidden md:block"
        image={node}
        width={2000}
        height={1000}
        sizes={`(min-width: 105rem) ${vw(68)}, 68rem`}
      />
      <Image
        class="w-full rounded-md aspect-[4/3] block md:hidden"
        image={node}
        width={1000}
        height={750}
        sizes={`100vw`}
      />
      <figcaption class="mt-gutter text-xs-fluid">
        {node.caption}
      </figcaption>
    </figure>
  </div>
</div>
