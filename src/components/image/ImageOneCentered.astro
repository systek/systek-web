---
import Image from "../Image.astro";

// todo: infer type from sanity schema
interface Props {
  node: {
    _key: string;
    _type: "image";
    alt?: string;
    asset: {
      _ref: string;
      _type: "reference";
    };
    caption?: string;
  };
}

const { node } = Astro.props;
---

<div class="my-section md:mx-[calc(50%-50vw+(var(--width-scrollbar)/2)))]">
  <div class="md:mx-grid-md">
    <figure class="md:mx-auto md:max-w-[68rem] lg:max-w-[64.7619vw]">
      <Image
        class="w-full object-cover rounded-md md:rounded-lg aspect-[4/3] md:aspect-[2/1]"
        mode="cover"
        image={node}
        sizes="(min-width: 105rem) 64.7619vw, (min-width: 50rem) 68rem, calc(100vw - 2rem)"
      />
      <figcaption class="mt-gutter text-xs-fluid">
        {node.caption}
      </figcaption>
    </figure>
  </div>
</div>
