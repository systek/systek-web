---
import type { Image as SanityImage } from "sanity";
import { vw } from "../../utils/number";
import ParallaxImage from "../ParallaxImage.astro";

interface Props {
  node: SanityImage & { caption: string };
}

const { node } = Astro.props;
---

<div class="my-section md:mx-[calc(50%-50vw+(var(--width-scrollbar)/2))]">
  <div class="md:mx-5">
    <figure class="md:mx-auto md:max-w-272 lg:max-w-[64.7619vw]">
      <ParallaxImage
        class="hidden aspect-2/1 w-full rounded-lg md:block"
        image={node}
        alt={node.alt}
        width={2000}
        height={1000}
        sizes={`(min-width: 80rem) ${vw(68)}, 68rem`}
      />
      <ParallaxImage
        class="block aspect-4/3 w-full rounded-md md:hidden"
        image={node}
        alt={node.alt}
        width={1000}
        height={750}
        sizes="100vw"
      />
      {node.caption && (
        <figcaption class="mt-gap text-xs-fluid">{node.caption}</figcaption>
      )}
    </figure>
  </div>
</div>
