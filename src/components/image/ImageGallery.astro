---
import type { Image as SanityImage } from "sanity";
import Image from "../Image.astro";

export type ImageWithAlt = SanityImage & {
  alt: string;
};

interface Props {
  node?: {
    first: ImageWithAlt;
    second: ImageWithAlt;
    third: ImageWithAlt;
    fourth: ImageWithAlt;
  };
}

const { node } = Astro.props;

if (!node?.first || !node.second || !node.third || !node.fourth) {
  throw new Error("All four images must be provided");
}

const { first, second, third, fourth } = node;
---

<div
  class="mt-section grid grid-cols-2 gap-gutter lg:grid-cols-2 lg:col-span-4"
>
  <div class="flex flex-col gap-gutter lg:flex-row">
    <picture>
      <Image
        class="w-full rounded-md aspect-square"
        image={first}
        alt={first.alt}
        width={2000}
        height={2000}
        sizes={`(min-width: 105rem) 25vw, 50vw`}
      />
    </picture>

    <picture>
      <Image
        image={second}
        alt={second.alt}
        width={2000}
        height={2500}
        class="w-full rounded-md aspect-[4/5] hidden lg:block"
        sizes={`(min-width: 105rem) 25vw, 50vw`}
      />
      <Image
        image={fourth}
        alt={fourth.alt}
        width={1000}
        height={1000}
        class="w-full rounded-md aspect-square block lg:hidden"
        sizes={`50vw`}
      />
    </picture>
  </div>

  <div class="flex flex-col gap-gutter lg:flex-row">
    <picture>
      <Image
        image={third}
        alt={third.alt}
        width={2000}
        height={1500}
        class="w-full rounded-md aspect-[4/3] hidden lg:block"
        sizes={`(min-width: 105rem) 25vw, 50vw`}
      />
      <Image
        image={second}
        alt={second.alt}
        width={1000}
        height={1250}
        class="w-full rounded-md aspect-[4/5] block lg:hidden"
        sizes={`50vw`}
      />
    </picture>

    <picture>
      <Image
        image={fourth}
        alt={fourth.alt}
        width={2000}
        height={2000}
        class="w-full rounded-md aspect-square hidden lg:block"
        sizes={`(min-width: 105rem) 25vw, 50vw`}
      />
      <Image
        image={third}
        alt={third.alt}
        width={1000}
        height={750}
        class="w-full rounded-md aspect-[4/3] block lg:hidden"
        sizes={`50vw`}
      />
    </picture>
  </div>
</div>
