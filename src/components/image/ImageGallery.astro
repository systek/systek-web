---
import Image from "../Image.astro";

// todo: infer type from sanity schema
interface Image {
  _type: "image";
  asset: {
    _ref: string;
    _type: "reference";
  };
  alt: string;
}

interface Props {
  node?: {
    first: any;
    second: any;
    third: any;
    fourth: any;
  };
}

const { node } = Astro.props;

const { first, second, third, fourth } = node ?? {};

// todo: reorder images with flex-order instead of changing aspect on md:
---

<div
  class="my-section grid grid-cols-2 gap-gutter lg:grid-cols-2 lg:col-span-4"
>
  <div class="flex flex-col gap-gutter lg:flex-row">
    <picture>
      <Image
        image={first}
        alt={first.alt}
        class="w-full object-cover rounded-md aspect-square"
      />
    </picture>

    <picture>
      <Image
        image={second}
        alt={second.alt}
        class="w-full object-cover rounded-md aspect-square lg:aspect-[4/5]"
      />
    </picture>
  </div>

  <div class="flex flex-col gap-gutter lg:flex-row">
    <picture>
      <Image
        image={third}
        alt={third.alt}
        class="w-full object-cover rounded-md aspect-[4/5] lg:aspect-[4/3]"
      />
    </picture>

    <picture>
      <Image
        image={fourth}
        alt={fourth.alt}
        class="w-full object-cover rounded-md aspect-[4/3] lg:aspect-square"
      />
    </picture>
  </div>
</div>
