---
import Image from "../Image.astro";

// todo: infer type from sanity schema
interface ImageType {
  _type: "image";
  asset: {
    _ref: string;
    _type: "reference";
  };
  alt: string;
  caption: string;
}

interface Props {
  node: {
    first: ImageType;
    second: ImageType;
  };
}

const { first, second } = Astro.props.node;
---

<div class="my-section md:mx-[calc(50%-50vw+(var(--width-scrollbar)/2))]">
  <div class="grid gap-section md:grid-cols-2 md:mx-grid-md lg:mx-grid-lg">
    <figure class="md:mx-section-md md:mt-page-md lg:mx-page-lg lg:mt-page-lg">
      <Image
        image={first}
        alt={first.alt}
        class="w-full rounded-md aspect-[4/5] lg:rounded-lg"
        width={2000}
        height={2500}
        sizes={`(min-width: 50rem) 25vw, 100vw`}
      />
      <figcaption class="text-xs-fluid mt-gutter">{first.caption}</figcaption>
    </figure>

    <figure>
      <Image
        image={second}
        alt={second.alt}
        width={2000}
        height={1500}
        class="w-full rounded-md aspect-[4/3] lg:rounded-lg"
        sizes={`(min-width: 50rem) 50vw, 100vw`}
      />
      <figcaption class="text-xs-fluid mt-gutter">{second.caption}</figcaption>
    </figure>
  </div>
</div>
