---
import type { ImageTwoFirst, ImageTwoSecond } from "../../lib/sanity.types";
import Image from "../Image.astro";

interface Props {
  node: {
    first: ImageTwoFirst;
    second: ImageTwoSecond;
  };
}

const { first, second } = Astro.props.node;
---

<div class="my-section md:mx-[calc(50%-50vw+(var(--width-scrollbar)/2))]">
  <div class="gap-section grid md:mx-grid md:grid-cols-2">
    <figure class="md:mx-section md:mt-page lg:mx-page">
      <Image
        image={first}
        alt={first.alt ?? ""}
        class="aspect-4/5 w-full rounded-md lg:rounded-lg"
        width={2000}
        height={2500}
        sizes="(min-width: 50rem) 25vw, 100vw"
      />
      <figcaption class="text-xs-fluid mt-gap">{first.caption}</figcaption>
    </figure>

    <figure>
      <Image
        image={second}
        alt={second.alt ?? ""}
        width={2000}
        height={1500}
        class="aspect-4/3 w-full rounded-md lg:rounded-lg"
        sizes="(min-width: 50rem) 50vw, 100vw"
      />
      <figcaption class="text-xs-fluid mt-gap">{second.caption}</figcaption>
    </figure>
  </div>
</div>
