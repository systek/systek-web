---
import SanityImage from "../SanityImage.astro";

// todo: infer type from sanity schema
interface Props {
  node: {
    _key: string;
    _type: "image";
    alt?: string;
    asset: {
      _ref: string;
      _type: "reference";
    };
    caption?: string;
  };
}

const { node } = Astro.props;
---

<figure class="my-section md:mr-[calc(50%-47.619vw)]">
  <SanityImage
    node={node}
    class="w-full object-cover rounded-md md:rounded-lg aspect-[4/3] md:aspect-[2/1]"
  />
  <figcaption class="mt-gutter text-xs-fluid">
    {node.caption}
  </figcaption>
</figure>
