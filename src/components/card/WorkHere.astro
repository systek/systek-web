---
import type { Image as SanityImage } from "sanity";
import CardLayout from "./layout/CardLayout.astro";
import CheckIcon from "../../assets/icons/check.svg";
import Button from "../Button.astro";
import Image from "../Image.astro";

interface Props {
  label: string;
  title: string;
  text: string;
  points?: string[];
  image: SanityImage;
}

const { label, title, text, image, points } = Astro.props as Props;
---

<CardLayout
  class="mt-page mx-grid pt-grid gap-y-section border-t border-stroke"
>
  <div class="flex flex-col lg:col-span-2">
    <h2 class="text-sm-fluid font-bold">{label}</h2>
    <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
      <h3 class="my-gap text-2xl-fluid font-light">{title}</h3>
      <p class="my-grid text-md-fluid md:mt-6">
        {text}
      </p>

      {
        points?.length && (
          <ul class="my-grid text-text-secondary">
            {points.map((point) => (
              <li class="gap-gap flex items-center">
                <CheckIcon class="size-4 shrink-0 lg:size-[0.952vw]" />
                <p class="text-sm-fluid">{point}</p>
              </li>
            ))}
          </ul>
        )
      }

      <div class="mt-grid gap-grid flex items-center">
        <Button href="/jobbe-her">Se ledige stillinger</Button>
        <a class="text-sm-fluid link-underline" href="/om-oss">Les om oss</a>
      </div>
    </div>
  </div>
  <div class="lg:col-span-2">
    <picture>
      <Image
        class="hidden aspect-[4/3] w-full rounded-md md:block"
        image={image}
        alt={image.alt}
        width={1000}
        height={750}
        sizes="(min-width: 105rem) 50vw, 100vw"
      />
      <Image
        class="block aspect-square w-full rounded-md md:hidden"
        image={image}
        alt={image.alt}
        width={1000}
        height={1000}
        sizes="100vw"
      />
    </picture>
  </div>
</CardLayout>
