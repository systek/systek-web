---
import type { Image as SanityImage } from "sanity";
import CardLayout from "./layout/CardLayout.astro";
import CheckIcon from "../../assets/icons/check.svg";
import Button from "../Button.astro";
import Image from "../Image.astro";

interface Props {
  label: string;
  title: string;
  text: string;
  points?: string[];
  image: SanityImage;
}

const { label, title, text, image, points } = Astro.props as Props;
---

<CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
  <div class="flex flex-col lg:col-span-2">
    <p class="font-bold text-sm-fluid">{label}</p>
    <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
      <p class="mt-gap font-light text-2xl-fluid">{title}</p>
      <p class="mt-grid text-md-fluid md:mt-6">
        {text}
      </p>

      {
        points?.length && (
          <ul class="my-grid text-text-secondary">
            {points.map((point) => (
              <li class="flex items-center gap-2">
                <CheckIcon class="size-4 lg:size-[0.952vw]" />
                <p class="text-sm-fluid">{point}</p>
              </li>
            ))}
          </ul>
        )
      }

      <div class="flex items-center my-grid gap-grid">
        <Button href="/jobbe-her">Se ledige stillinger</Button>
        <a class="link-underline text-sm-fluid" href="/om-oss">Les om oss</a>
      </div>
    </div>
  </div>
  <div class="mt-section-sm md:mt-section-md lg:mt-0 lg:col-span-2">
    <picture>
      <Image
        class="w-full rounded-md aspect-[4/3] hidden md:block"
        image={image}
        alt={image.alt}
        width={2000}
        height={1500}
        sizes={`(min-width: 105rem) 50vw, 100vw`}
      />
      <Image
        class="w-full rounded-md aspect-square block md:hidden"
        image={image}
        alt={image.alt}
        width={1000}
        height={1000}
        sizes={`100vw`}
      />
    </picture>
  </div>
</CardLayout>
