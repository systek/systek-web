---
import { vw } from "../../utils/number";
import Button from "../Button.astro";
import Image from "../Image.astro";
import CardLayout from "./layout/CardLayout.astro";

interface Props {
  button: string;
  email: string;
  label: string;
  text: string;
  title: string;
  image: any;
}

const { button, label, title, email, text, image } = Astro.props;
---

<CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
  <div class="flex flex-col lg:col-span-2">
    <p class="font-bold text-sm-fluid">{label}</p>
    <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
      <p class="mt-2 font-light text-2xl-fluid">
        {title}
      </p>
      <p class="mt-grid text-md-fluid">
        {text}
      </p>

      <div class="flex items-center mt-grid gap-grid">
        <Button href={`mailto:${email}`}>
          {button}
        </Button>
        <a
          class="link-underline text-sm-fluid"
          href="https://systek.homerun.co"
        >
          Se kontakt-siden
        </a>
      </div>
    </div>
  </div>
  <div class="mt-section-sm md:mt-section-md lg:mt-0 lg:col-span-2">
    <picture>
      <Image
        class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
        mode="cover"
        image={image}
        alt={image.alt}
        width={810}
        height={608}
        sizes={`(min-width: 105rem) calc(50vw - calc(3 * ${vw(1.25)})), (min-width: 50rem) calc(100vw - 2.5rem), calc(100vw - 2rem)`}
      />
    </picture>
  </div>
</CardLayout>
