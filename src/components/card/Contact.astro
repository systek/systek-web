---
import type { Image as SanityImage } from "sanity";
import Button from "../Button.astro";
import Image from "../Image.astro";
import CardLayout from "./layout/CardLayout.astro";

interface Props {
  button: string;
  email: string;
  label: string;
  text: string;
  title: string;
  image: SanityImage;
}

const { button, label, title, email, text, image } = Astro.props;
---

<CardLayout
  class="mt-page mx-grid pt-grid gap-y-section border-t border-stroke"
>
  <div class="flex flex-col lg:col-span-2">
    <h2 class="text-sm-fluid font-bold">{label}</h2>
    <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
      <h3 class="my-gap text-2xl-fluid font-light">{title}</h3>
      <p class="my-grid text-md-fluid">
        {text}
      </p>

      <div class="mt-grid gap-grid flex items-center">
        <Button href={`mailto:${email}`}>
          {button}
        </Button>
        <a class="text-sm-fluid link-underline" href="/om-oss">Les om oss</a>
      </div>
    </div>
  </div>
  <div class="lg:col-span-2">
    <picture>
      <Image
        class="hidden aspect-[4/3] w-full rounded-md md:block"
        image={image}
        alt={image.alt}
        width={1000}
        height={750}
        sizes={`(min-width: 105rem) 50vw, 100vw`}
      />
      <Image
        class="block aspect-square w-full rounded-md md:hidden"
        image={image}
        alt={image.alt}
        width={1000}
        height={1000}
        sizes={`100vw`}
      />
    </picture>
  </div>
</CardLayout>
