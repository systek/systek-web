---
import clsx from "clsx";
import TitleAs from "../../TitleAs.astro";

interface Props {
  class?: string;
  titleAs?: "h1" | "h2" | "h3" | "p";
}

const { class: className, titleAs = "h3" } = Astro.props;
---

<TitleAs
  as={titleAs}
  class={clsx(
    "text-2xl-fluid font-light",
    "max-w-[65rem] md:mr-20 lg:mr-[4.7619vw] lg:max-w-[61.905vw]",
    className,
  )}
>
  <slot />
</TitleAs>
