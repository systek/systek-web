---
import type { Image as ImageType } from "sanity";
import { fullWidth, oneHalf, vw } from "../../utils/number";
import Image from "../Image.astro";
import CardLayout from "./layout/CardLayout.astro";

export type ContactImage = ImageType & {
  alt: string;
  name?: string;
  position?: string;
  email?: string;
  phone?: string;
};

interface Props {
  label: string;
  title: string;
  text: string;
  contacts: ContactImage[];
}

const { label, title, text, contacts } = Astro.props;
---

<CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
  <div class="flex flex-col lg:col-span-2">
    <p class="font-bold text-sm-fluid">{label}</p>
    <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
      <p class="mt-gap font-light text-2xl-fluid">
        {title}
      </p>
      <p class="my-grid text-md-fluid">
        {text}
      </p>
    </div>
  </div>
  {
    contacts.map((contact) => (
      <div class="mt-section-sm md:mt-section-md lg:mt-0">
        <picture>
          <Image
            class="w-full rounded-md aspect-square md:aspect-[4/3] object-cover"
            mode="cover"
            image={contact}
            alt={contact.alt}
            width={810}
            height={608}
            sizes={`(min-width: 105rem) calc(${oneHalf("lg")}), (min-width: 50rem) calc(${fullWidth("md")}), calc(${fullWidth("sm")})`}
          />
        </picture>
        <p>{contact.name}</p>
        <p>{contact.position}</p>
        <p>
          {contact.phone} · {contact.email}
        </p>
      </div>
    ))
  }
</CardLayout>
