---
import type { Image as ImageType } from "sanity";
import { fullWidth, oneFourth, oneHalf, vw } from "../../utils/number";
import Image from "../Image.astro";
import CardLayout from "./layout/CardLayout.astro";

export type ContactImage = ImageType & {
  alt: string;
  name?: string;
  position?: string;
  email?: string;
  phone?: string;
};

interface Props {
  label: string;
  title: string;
  text: string;
  contacts: ContactImage[];
}

const { label, title, text, contacts } = Astro.props;
---

<CardLayout class="border-t mt-page border-stroke mx-grid pt-grid">
  <div class="flex flex-col lg:col-span-2">
    <p class="font-bold text-sm-fluid">{label}</p>
    <div class="mt-auto max-w-[37rem] lg:max-w-[35.238vw]">
      <p class="mt-gap font-light text-2xl-fluid">
        {title}
      </p>
      <p class="mt-grid text-md-fluid">
        {text}
      </p>
    </div>
  </div>
  <div class="grid md:grid-cols-2 gap-gutter lg:col-span-2">
    {
      contacts.map((contact) => (
        <div class="mt-section-sm md:mt-section-md lg:mt-0">
          <picture>
            <Image
              class="w-full rounded-md aspect-square"
              image={contact}
              alt={contact.alt}
              width={1000}
              height={1000}
              sizes={`(min-width: 105rem) 25vw, (min-width: 50rem) 50vw, 100vw`}
            />
          </picture>
          <p class="mt-gap font-bold text-md-fluid">{contact.name}</p>
          <p class="text-md-fluid">{contact.position}</p>
          <p class="text-sm-fluid">
            {contact.phone} · <a class="link-underline" href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        </div>
      ))
    }
  </div>
</CardLayout>
