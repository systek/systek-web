---
import type { Citation as CitationType } from "../../lib/sanity.types";

import Button from "../Button.astro";
import CardRightColumn from "./layout/CardRightColumn.astro";
import CardLayout from "./layout/CardLayout.astro";
import CitationSub from "./CitationSub.astro";

interface Props {
  buttonText?: string;
  citation: CitationType;
  class?: string;
  href?: string;
  title?: string;
}

const { buttonText, citation, class: className, href, title } = Astro.props;
---

<CardLayout
  class:list={["border-t mt-page border-stroke mx-grid pt-grid", className]}
>
  <CardRightColumn title={title}>
    <p class="max-w-[50rem] lg:max-w-[47.619vw] font-light text-xl-fluid">
      «{citation.text}»
    </p>
    <CitationSub
      class="my-grid"
      title={citation.name}
      subtitle={citation.position}
      image={citation.picture}
    />
    {
      href && buttonText && (
        <Button class="my-grid" href={href}>
          {buttonText}
        </Button>
      )
    }
  </CardRightColumn>
</CardLayout>
