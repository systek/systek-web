---
import type { Citation } from "../../lib/sanity.types";
import { vw } from "../../utils/number";
import Image from "../Image.astro";

interface Props {
  title: string;
  subtitle: string;
  image: Citation["picture"];
  class?: string;
}

const { title, subtitle, image, class: className } = Astro.props;
---

<div class:list={["flex gap-3", className]}>
  <div class="size-10 lg:size-[2.381vw]">
    <Image
      class="aspect-square w-full rounded-full"
      image={image}
      alt=""
      width={80}
      height={80}
      sizes={`(min-width: 80rem) ${vw(5)}, 5rem`}
    />
  </div>

  <div>
    <p class="text-sm-fluid leading-tight font-bold text-text-secondary">
      {title}
    </p>
    <p class="text-sm-fluid leading-tight text-text-secondary">{subtitle}</p>
  </div>
</div>
