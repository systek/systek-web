---
interface Props {
  color?: "transparent" | "grey";
  class?: string;
  href: string;
  size?: "md" | "lg";
}

const { color = "transparent", size = "md", class: className } = Astro.props;

const sizeClasses = {
  md: "min-h-72 lg:aspect-[4/3]",
  lg: "sm:min-h-[29rem]",
}[size];

const colorClasses = {
  transparent: "",
  grey: "duration-250 transition-colors bg-grey-91 hover:bg-orange",
}[color];
---

<a
  class:list={[
    "flex flex-col justify-between gap-gutter p-grid rounded-lg group",
    sizeClasses,
    colorClasses,
    className,
  ]}
  href={Astro.props.href}
>
  <slot />
</a>
