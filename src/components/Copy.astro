---
import Button from "./Button.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={className}>
  <h2 class="text-sm-fluid font-bold">Likte du artikkelen?</h2>
  <p class="text-sm-fluid">Del den med noen andre!</p>

  <Button data-copy-link-button class="mt-grid">
    Kopier lenke
  </Button>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>(
    "[data-copy-link-button]",
  )!;
  const text = button.innerText;

  button.addEventListener("click", () => {
    navigator.clipboard.writeText(window.location.href);
    button.innerText = "Kopiert!";
    setTimeout(() => (button.innerText = text), 5000);
  });
</script>
