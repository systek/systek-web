---
import Button from "./Button.astro";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={className}>
  <p class="text-sm-fluid font-bold">Likte du artikkelen?</p>
  <p class="text-sm-fluid">Del den med noen andre!</p>

  <Button data-copy-link-button class="mt-grid">Kopier lenke</Button>
</div>

<script>
  import { DOMLoaded } from "../utils/utils";

  DOMLoaded(() => {
    const button = document.querySelector(
      "[data-copy-link-button]"
    ) as HTMLButtonElement;

    const initialText = button.innerText;

    button.addEventListener("click", () => {
      navigator.clipboard.writeText(window.location.href);
      button.innerText = "Kopiert!";

      setTimeout(() => {
        button.innerText = initialText;
      }, 5000);
    });
  });
</script>
