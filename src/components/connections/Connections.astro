---
import ConnectionsBox from "./ConnectionsBox.astro";
---

<div id="connections-canvas" class="absolute inset-0">
  <ConnectionsBox class="bg-yellow">Bra</ConnectionsBox>
  <ConnectionsBox class="bg-off-white">folk</ConnectionsBox>
  <ConnectionsBox class="bg-off-white">smarte</ConnectionsBox>
  <ConnectionsBox class="bg-off-white">løsninger</ConnectionsBox>

  <script>
    import Connect from "./connections.ts";
    (() => {
      const rootEl = document.getElementById("connections-canvas");
      if (!rootEl) return;

      Connect(rootEl);
    })();
  </script>
</div>
