---
import ConnectionsBox from "./ConnectionsBox.astro";
---

<div id="connections-canvas" class="absolute inset-0">
  <ConnectionsBox class="bg-yellow">Bra</ConnectionsBox>
  <ConnectionsBox class="bg-yellow">folk</ConnectionsBox>
  <ConnectionsBox class="bg-yellow">smarte</ConnectionsBox>
  <ConnectionsBox class="bg-yellow">løsninger</ConnectionsBox>

  <script>
    import Connect from "./connections.ts";
    (() => {
      const rootEl = document.getElementById(
        "connections-canvas"
      ) as HTMLDivElement;
      if (!rootEl) return;

      Connect(rootEl);
    })();
  </script>
</div>
