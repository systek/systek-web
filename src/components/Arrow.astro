---
import ArrowMobileTopLeft from "../assets/arrows/mobile/arrow-top-left.svg";
import ArrowMobileTopRight from "../assets/arrows/mobile/arrow-top-right.svg";
import ArrowMobileMiddleLeft from "../assets/arrows/mobile/arrow-middle-left.svg";
import ArrowMobileMiddleRight from "../assets/arrows/mobile/arrow-middle-right.svg";
import ArrowMobileBottomLeft from "../assets/arrows/mobile/arrow-bottom-left.svg";
import ArrowMobileBottomRight from "../assets/arrows/mobile/arrow-bottom-right.svg";
import ArrowTabletTopLeft from "../assets/arrows/tablet/arrow-top-left.svg";
import ArrowTabletTopRight from "../assets/arrows/tablet/arrow-top-right.svg";
import ArrowTabletMiddleLeft from "../assets/arrows/tablet/arrow-middle-left.svg";
import ArrowTabletMiddleRight from "../assets/arrows/tablet/arrow-middle-right.svg";
import ArrowTabletBottomLeft from "../assets/arrows/tablet/arrow-bottom-left.svg";
import ArrowTabletBottomRight from "../assets/arrows/tablet/arrow-bottom-right.svg";
import ArrowDesktopTopLeft from "../assets/arrows/desktop/arrow-top-left.svg";
import ArrowDesktopTopRight from "../assets/arrows/desktop/arrow-top-right.svg";
import ArrowDesktopMiddleLeft from "../assets/arrows/desktop/arrow-middle-left.svg";
import ArrowDesktopMiddleRight from "../assets/arrows/desktop/arrow-middle-right.svg";
import ArrowDesktopBottomLeft from "../assets/arrows/desktop/arrow-bottom-left.svg";
import ArrowDesktopBottomRight from "../assets/arrows/desktop/arrow-bottom-right.svg";

interface Props {
  class?: string;
  color?: "black" | "blue";
  position?:
    | "topLeft"
    | "topRight"
    | "middleLeft"
    | "middleRight"
    | "bottomLeft"
    | "bottomRight";
}

const icons = {
  mobile: {
    topLeft: ArrowMobileTopLeft,
    topRight: ArrowMobileTopRight,
    middleLeft: ArrowMobileMiddleLeft,
    middleRight: ArrowMobileMiddleRight,
    bottomLeft: ArrowMobileBottomLeft,
    bottomRight: ArrowMobileBottomRight,
  },
  tablet: {
    topLeft: ArrowTabletTopLeft,
    topRight: ArrowTabletTopRight,
    middleLeft: ArrowTabletMiddleLeft,
    middleRight: ArrowTabletMiddleRight,
    bottomLeft: ArrowTabletBottomLeft,
    bottomRight: ArrowTabletBottomRight,
  },
  desktop: {
    topLeft: ArrowDesktopTopLeft,
    topRight: ArrowDesktopTopRight,
    middleLeft: ArrowDesktopMiddleLeft,
    middleRight: ArrowDesktopMiddleRight,
    bottomLeft: ArrowDesktopBottomLeft,
    bottomRight: ArrowDesktopBottomRight,
  },
};

const { class: className, color = "blue", position = "topLeft" } = Astro.props;

const MobileArrow = icons.mobile[position];
const TabletArrow = icons.tablet[position];
const DesktopArrow = icons.desktop[position];

const colorClasses = {
  blue: "text-blue",
  black: "text-text",
}[color];
---

<div aria-hidden="true" class={className}>
  <MobileArrow class:list={[colorClasses, "block md:hidden"]} />
  <TabletArrow class:list={[colorClasses, "hidden md:block lg:hidden"]} />
  <DesktopArrow
    class:list={[colorClasses, "hidden w-[1.4286vw] h-auto lg:block"]}
  />
</div>
