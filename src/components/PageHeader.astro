---
import type { Image as ImageType } from "sanity";
import Image from "./Image.astro";
import Arrow from "./Arrow.astro";
import { fullWidth, vw } from "../utils/number";

interface Props {
  image?: ImageType;
  title?: string;
}

const { image, title } = Astro.props;
---

<div
  id="main-content"
  class="flex flex-col m-grid gap-section scroll-mt-[var(--height-header)]"
>
  <div class="flex justify-between">
    <Arrow position="topLeft" />
    <Arrow position="topRight" />
  </div>

  {
    title && (
      <h1 class="font-light text-4xl-fluid hyphens-auto md:text-center md:mx-auto md:max-w-[72rem] lg:max-w-[68.571vw]">
        {title}
      </h1>
    )
  }

  <slot />

  {
    image?.asset && (
      <>
        <div class="flex justify-between">
          <Arrow position="middleLeft" />
          <Arrow position="middleRight" />
        </div>

        <Image
          alt={image.alt}
          class="w-full rounded-md aspect-[2/1] hidden md:block"
          image={image}
          loading="eager"
          width={2000}
          height={1000}
          sizes={`100vw`}
        />

        <Image
          alt={image.alt}
          class="w-full rounded-md aspect-[4/3] block md:hidden"
          image={image}
          loading="eager"
          width={1000}
          height={750}
          sizes={`100vw`}
        />
      </>
    )
  }

  <div class="flex justify-between">
    <Arrow position="bottomLeft" />
    <Arrow position="bottomRight" />
  </div>
</div>
