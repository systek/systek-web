---
import type { Image as ImageType } from "sanity";
import Image from "./Image.astro";
import Arrow from "./Arrow.astro";

interface Props {
  image?: ImageType;
  title?: string;
}

const { image, title } = Astro.props;
---

<div
  id="main-content"
  class="m-grid gap-section flex scroll-mt-(--height-header) flex-col"
>
  <div class="flex justify-between">
    <Arrow position="topLeft" />
    <Arrow position="topRight" />
  </div>

  {
    title && (
      <h1 class="text-4xl-fluid font-light hyphens-auto md:mx-auto md:max-w-[72rem] md:text-center lg:max-w-[68.571vw]">
        {title}
      </h1>
    )
  }

  <slot />

  {
    image?.asset && (
      <>
        <div class="flex justify-between">
          <Arrow position="middleLeft" />
          <Arrow position="middleRight" />
        </div>

        <Image
          alt={image.alt}
          class="hidden aspect-2/1 w-full rounded-md md:block"
          image={image}
          loading="eager"
          width={2000}
          height={1000}
          sizes="100vw"
        />

        <Image
          alt={image.alt}
          class="block aspect-4/3 w-full rounded-md md:hidden"
          image={image}
          loading="eager"
          width={1000}
          height={750}
          sizes="100vw"
        />
      </>
    )
  }

  <div class="flex justify-between">
    <Arrow position="bottomLeft" />
    <Arrow position="bottomRight" />
  </div>
</div>
