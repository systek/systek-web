---
interface Props {
  class?: string;
  color?: "transparent" | "grey";
}

const { color = "transparent", class: className } = Astro.props;

const colorClasses = {
  transparent: "",
  grey: "",
}[color];
---

<div
  class:list={[
    "grid grid-cols-1 lg:gap-x-5 lg:grid-cols-4",
    colorClasses,
    className,
  ]}
>
  <slot />
</div>
