---
import clsx from "clsx";
import type { HTMLAttributes } from "astro/types";

export type CardLayoutColor = "transparent" | "grey";
type CardLayoutProps = {
  color?: CardLayoutColor;
} & HTMLAttributes<"div">;
const { color = "transparent", class: className } =
  Astro.props as CardLayoutProps;

const colors: Record<CardLayoutColor, string> = {
  transparent: "",
  grey: "",
};
---

<div
  class={clsx(
    "mx-grid pt-grid grid grid-cols-1 gap-gutter lg:grid-cols-4",
    colors[color],
    className,
  )}
>
  <slot />
</div>
