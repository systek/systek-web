---
const { node } = Astro.props;

const { items, _key: key } = node as { items?: string[]; _key: string };
---

<div class="mt-4">
  <h3 class="text-sm-fluid font-bold">Stikkord</h3>
  <ul class="flex flex-row gap-4 list-disc list-inside">
    {items?.map((item) => <li class="text-sm-fluid">{item}</li>)}
  </ul>
</div>
