---
interface Props {
  node: {
    items?: string[];
  };
}

const {
  node: { items },
} = Astro.props;
---

<div class="my-5 lg:my-7">
  <h3 class="font-bold text-sm-fluid">Stikkord</h3>
  <div class="flex flex-row gap-2 text-sm-fluid">
    {
      items?.map((item, index) => (
        <>
          <span>{item}</span>
          {index < items?.length - 1 && <span>·</span>}
        </>
      ))
    }
  </div>
</div>
