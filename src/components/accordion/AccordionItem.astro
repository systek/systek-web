---
import clsx from "clsx";
import ClosedIcon from "../../assets/icons/closed.svg";
import OpenIcon from "../../assets/icons/open.svg";

interface Props {
  bold?: boolean;
  class?: string;
  name?: string;
  open?: boolean;
  title: string;
  size?: "md" | "lg";
}

const { bold, open, title, name, class: className, size = "md" } = Astro.props;

const pyClass = {
  md: "py-4",
  lg: "py-6 lg:py-8",
}[size];

const mbClass = {
  md: "mb-4",
  lg: "mb-6 lg:mb-8",
}[size];
---

<details
  class:list={["group/details border-b border-stroke", className]}
  name={name}
  open={open}
>
  <summary
    class={clsx(
      "gap-gutter group/summary flex cursor-pointer items-center justify-between select-none",
      pyClass,
    )}
  >
    <span class={clsx("text-md-fluid", bold && "font-bold")}>{title}</span>
    <div
      class="shrink-0 rounded-full border border-transparent p-1.75 transition-colors duration-250 group-hover/summary:border-yellow-31 group-hover/summary:bg-yellow"
    >
      <ClosedIcon class="hidden group-open/details:block lg:size-[0.9523vw]" />
      <OpenIcon class="block group-open/details:hidden lg:size-[0.9523vw]" />
    </div>
  </summary>
  <div class={mbClass}>
    <slot />
  </div>
</details>
