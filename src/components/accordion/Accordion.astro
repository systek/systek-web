---
import AccordionItem from "./AccordionItem.astro";

type AccordionItemType = typeof AccordionItem;

interface Props {
  class?: string;
  children: AccordionItemType | AccordionItemType[];
}

const { class: className } = Astro.props;
---

<div class:list={["border-t border-stroke", className]}>
  <slot />
</div>
