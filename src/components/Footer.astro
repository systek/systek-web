---
import Arrow from "./Arrow.astro";

const links = [
  { text: "Følg oss på sosiale medier", href: "/" },
  { text: "Les vår fagblogg", href: "/" },
  { text: "Om systek", href: "/" },
];
---

<footer class="container-fluid">
  <div class="flex justify-between">
    <Arrow position="topLeft" class="pointer-events-none" />
    <Arrow position="topRight" class="pointer-events-none" />
  </div>

  <div class="mt-16 grid grid-cols-2 gap-2">
    <div class="grid grid-cols-2 gap-2">
      <p class="leading-5">
        Oslo<br />
        <a class="underline" href="/">Pilestredet 28</a><br />
        0166 Oslo<br />
        +47 951 30 207<br />
        <a class="underline" href="/">systek@systek.no</a>
      </p>

      <p class="leading-5">
        Hamar<br />
        <a class="underline" href="/">Brygga 20</a><br />
        2317 Hamar<br />
        +47 991 62 618<br />
        <a class="underline" href="/">hamar@systek.no</a>
      </p>
    </div>
    <div>
      <ul class="border-t border-grey-10">
        {
          links.map((link) => (
            <li class="border-b border-grey-10">
              <a
                href={link.href}
                class="hover:underline flex justify-between gap-2 py-3.75"
              >
                {link.text}
                <img
                  alt=""
                  src="/images/show-more.svg"
                  class="pr-2 pointer-events-none shrink-0"
                />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="flex justify-between mt-30">
    <Arrow position="middleLeft" class="pointer-events-none" />
    <Arrow position="middleRight" class="pointer-events-none" />
  </div>

  <img
    alt=""
    src="/images/systek-logo.svg"
    alt="Systek"
    class="w-full mt-8 pointer-events-none"
  />

  <div class="flex items-end justify-between mt-8">
    <Arrow position="bottomLeft" class="pointer-events-none" />

    <p class="text-sm">
      @{new Date().getFullYear()} Systek. All rights reserved
    </p>

    <Arrow position="bottomRight" class="pointer-events-none" />
  </div>
</footer>
