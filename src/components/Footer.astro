---
import Accordion from "./accordion/Accordion.astro";
import AccordionItem from "./accordion/AccordionItem.astro";
import Arrow from "./Arrow.astro";
---

<div class="pt-page">
  <footer class="flex flex-col mx-grid my-8 gap-section lg:mt-page-lg">
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>

    <div class="grid gap-section lg:grid-cols-2 lg:gap-grid-lg">
      <Accordion class="lg:mr-section-lg">
        <AccordionItem title="Om Systek">
          <div
            class="grid grid-cols-2 gap-gutter mr-9 max-w-[35rem] lg:max-w-[33.333vw]"
          >
            <div class="flex flex-col gap-2">
              <p class="text-text-secondary text-sm-fluid">Systek AS</p>
              <p class="text-text-secondary text-sm-fluid">
                Org.nr: 927 415 305 <span class="hidden md:inline">MVA</span>
              </p>
              <p class="text-text-secondary text-sm-fluid">
                Denne siden bruker ikke cookies
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <p class="text-sm-fluid">
                <a class="link-underline" href="/personvern"
                  >Personvernerklæring</a
                >
              </p>
              <p class="text-sm-fluid">
                <a class="link-underline" href="/barekraft">Bærekraft</a>
              </p>
            </div>
          </div>
        </AccordionItem>
        <AccordionItem title="Nyttige lenker">
          <div
            class="grid grid-cols-2 gap-gutter mr-9 max-w-[35rem] lg:max-w-[33.333vw]"
          >
            <div class="flex flex-col gap-2">
              <p class="text-sm-fluid">
                <a class="link-underline" href="/om-oss">Om oss</a>
              </p>
              <p class="text-sm-fluid">
                <a class="link-underline" href="https://systek.homerun.co">
                  Kontakt
                </a>
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <p class="text-sm-fluid">
                <a class="link-underline" href="/nyheter">Nyheter</a>
              </p>
            </div>
          </div>
        </AccordionItem>
        <AccordionItem title="Sosiale medier">
          <div
            class="grid grid-cols-2 gap-gutter mr-9 max-w-[35rem] lg:max-w-[33.333vw]"
          >
            <div class="flex flex-col gap-2">
              <p class="text-sm-fluid">
                <a
                  class="link-underline"
                  href="https://www.facebook.com/Systek.no"
                  target="_blank"
                  rel="noopener noreferrer">Facebook</a
                >
              </p>
              <p class="text-sm-fluid">
                <a
                  class="link-underline"
                  href="https://www.instagram.com/systek.no/"
                  target="_blank"
                  rel="noopener noreferrer">Instagram</a
                >
              </p>
            </div>
            <div class="flex flex-col gap-2">
              <p class="text-sm-fluid">
                <a
                  class="link-underline"
                  href="https://no.linkedin.com/company/systek-as"
                  target="_blank"
                  rel="noopener noreferrer">LinkedIn</a
                >
              </p>
              <p class="text-sm-fluid">
                <a
                  class="link-underline"
                  href="https://medium.com/systek"
                  target="_blank"
                  rel="noopener noreferrer">Medium</a
                >
              </p>
            </div>
          </div>
        </AccordionItem>
      </Accordion>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-gutter">
        <p class="text-sm-fluid">
          <span class="font-bold">Oslo</span><br />
          <a
            class="link-underline"
            href="https://maps.app.goo.gl/X3fDGjM8re9jhhtFA"
            target="_blank"
            rel="noopener noreferrer"
          >
            Pilestredet 28
          </a><br />
          0166 Oslo<br />
          +47 951 30 207<br />
          <a class="link-underline" href="mailto:systek@systek.no">
            systek@systek.no
          </a>
        </p>

        <p class="text-sm-fluid">
          <span class="font-bold">Hamar</span><br />
          <a
            class="link-underline"
            href="https://maps.app.goo.gl/vXu8mMJuHJ6Bb6Li6"
            target="_blank"
            rel="noopener noreferrer"
          >
            Brygga 20
          </a><br />
          2317 Hamar<br />
          +47 991 62 618<br />
          <a class="link-underline" href="mailto:hamar@systek.no">
            hamar@systek.no
          </a>
        </p>

        <p class="text-sm-fluid">
          <span class="font-bold">Arendal</span><br />
          <a
            class="link-underline"
            href="https://maps.app.goo.gl/81yg19V6XSJXow4o8"
            target="_blank"
            rel="noopener noreferrer"
          >
            Kystveien 14
          </a><br />
          4841 Arendal<br />
          +47 993 35 633<br />
          <a class="link-underline" href="mailto:arendal@systek.no">
            arendal@systek.no
          </a>
        </p>
      </div>
    </div>

    <div class="flex justify-between">
      <Arrow position="middleLeft" />
      <Arrow position="middleRight" />
    </div>

    <picture>
      <img
        alt="Systek"
        src="/images/systek-logo.svg"
        class="w-full"
        draggable="false"
      />
    </picture>

    <div class="flex items-end justify-between">
      <Arrow position="bottomLeft" />

      <p class="text-xs-fluid">
        @{new Date().getFullYear()} Systek. All rights reserved
      </p>

      <Arrow position="bottomRight" />
    </div>
  </footer>
</div>
