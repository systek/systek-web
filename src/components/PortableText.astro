---
import { PortableText as PortableTextInternal } from "astro-portabletext";
import InternalLink from "./portable/InternalLink.astro";
import PortableBlock from "./portable/PortableBlock.astro";
import ListGroup from "./portable/ListGroup.astro";
import TagsList from "./portable/TagsList.astro";
import PageLink from "./portable/PageLink.astro";
import ExternalLink from "./portable/ExternalLink.astro";
import FileLink from "./portable/FileLink.astro";
import List from "./portable/List.astro";
import ImageTwo from "./image/ImageTwo.astro";
import ImageOneRight from "./image/ImageOneRight.astro";
import ImageGallery from "./image/ImageGallery.astro";

const components = {
  type: {
    image: ImageOneRight,
    imageTwo: ImageTwo,
    imageGallery: ImageGallery,
    "list-group": ListGroup,
    "tags-list": TagsList,
    "internal-link": PageLink,
    "external-link": ExternalLink,
    file: FileLink,
  },
  mark: {
    internalLink: InternalLink,
  },
  block: PortableBlock,
  list: List,
};
---

<PortableTextInternal value={Astro.props.value} components={components} />
