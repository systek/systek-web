---
import { PortableText as PortableTextInternal } from "astro-portabletext";
import ImageOne from "./image/ImageOne.astro";
import InternalLink from "./InternalLink.astro";
import PortableBlock from "./PortableBlock.astro";
import ListGroup from "./ListGroup.astro";
import TagsList from "./TagsList.astro";

const components = {
  type: {
    // todo: add different image components
    image: ImageOne,
    // imageTwo: ImageTwo,
    "list-group": ListGroup,
    "tags-list": TagsList,
  },
  mark: {
    internalLink: InternalLink,
  },
  block: PortableBlock,
};
---

<PortableTextInternal value={Astro.props.value} components={components} />
