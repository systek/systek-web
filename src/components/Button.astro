---
interface Props {
  color?: "transparent" | "black" | "grey";
  href?: string;
  size?: "sm" | "md";
  class?: string;
}

const {
  href,
  color = "transparent",
  size = "md",
  class: className,
  ...props
} = Astro.props;

const sizeClasses = {
  sm: "px-gap py-0 text-xs-fluid",
  md: "px-grid py-gap text-sm-fluid",
}[size];

const colorClasses = {
  transparent:
    "bg-transparent text-text border border-grey-10 hover:bg-grey-10 hover:text-off-white",
  black:
    "bg-grey-10 text-off-white border border-grey-10 hover:bg-transparent hover:text-text",
  grey: "bg-grey-91 text-text border border-grey-91 hover:bg-grey-10 hover:text-off-white",
}[color];

const buttonClasses = [
  "block w-max rounded-full cursor-pointer transition-colors duration-250",
  "focus:outline-none focus-visible:ring-3 focus-visible:ring-grey-10 focus-visible:ring-offset-3",
  sizeClasses,
  colorClasses,
  className,
];
---

{
  href ? (
    <a class:list={buttonClasses} href={href} {...props}>
      <slot />
    </a>
  ) : (
    <button class:list={buttonClasses} {...props}>
      <slot />
    </button>
  )
}
