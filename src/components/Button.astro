---
interface Props {
  color?: "transparent" | "black";
  href?: string;
  size?: "sm" | "md";
  class?: string;
}

const {
  href,
  color = "transparent",
  size = "md",
  class: className,
  ...props
} = Astro.props;

const sizeClasses = {
  sm: "px-3 py-0 text-xs-fluid",
  md: "px-5 py-2.5 text-sm-fluid",
}[size];

const colorClasses = {
  transparent: "bg-transparent border border-grey-10",
  black: "bg-grey-10 text-off-white border border-grey-10",
}[color];

const buttonClasses = ["rounded-full", sizeClasses, colorClasses, className];
---

{
  href ? (
    <a class:list={buttonClasses} href={href} {...props}>
      <slot />
    </a>
  ) : (
    <button class:list={buttonClasses} {...props}>
      <slot />
    </button>
  )
}
