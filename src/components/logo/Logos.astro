---
import type { Logo as LogoType } from "../../lib/sanity.types";
import CardRightColumn from "../card/layout/CardRightColumn.astro";
import CardLayout from "../card/layout/CardLayout.astro";
import Logo from "./Logo.astro";

interface Props {
  class?: string;
  logos: LogoType[];
}

const { class: className, logos } = Astro.props;

const perLine = 4;
const numberOfLines = Math.ceil(logos.length / perLine);

const logoLines: LogoType[][] = [];
for (let i = 0; i < numberOfLines; i++) {
  logoLines.push(logos.slice(i * perLine, (i + 1) * perLine));
}
---

<CardLayout class:list={["mx-grid", className]}>
  <CardRightColumn>
    <div class="grid gap-section mx-auto max-w-[30rem] md:max-w-full">
      {
        logoLines.map((logoLine) => (
          <div class="grid grid-cols-2 gap-section md:flex md:justify-between">
            {logoLine.map((item) => (
              <Logo image={item.image} alt={item.image.alt} />
            ))}
          </div>
        ))
      }
    </div>
  </CardRightColumn>
</CardLayout>
