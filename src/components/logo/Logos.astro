---
import type { LogoItemsQueryResult } from "../../lib/sanity.types";
import Logo from "./Logo.astro";

interface Props {
  class?: string;
  logos: LogoItemsQueryResult;
}

const { class: className, logos } = Astro.props;

const perLine = 4;
const numberOfLines = Math.ceil(logos.length / perLine);

const logoLines: LogoItemsQueryResult[] = [];
for (let i = 0; i < numberOfLines; i++) {
  logoLines.push(logos.slice(i * perLine, (i + 1) * perLine));
}
---

<div
  class:list={["gap-section mx-auto grid max-w-120 md:max-w-full", className]}
>
  {logoLines.map((logoLine) => (
    <div class="gap-section grid grid-cols-2 md:flex md:justify-between">
      {logoLine.map((item) => (
        <Logo image={item.image} alt={item.image.alt} />
      ))}
    </div>
  ))}
</div>
