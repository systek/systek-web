---
import type { Image } from "sanity";
import { sanityClient } from "sanity:client";
import { SanityImage } from "sanity-image";

const {
  image,
  class: className,
  alt,
  loading,
  mode,
  width,
  height,
  sizes,
} = Astro.props as {
  image: Image;
  class?: string;
  alt: string;
  loading?: "eager" | "lazy";
  mode?: "cover" | "contain";
  width?: number;
  height?: number;
  sizes?: string;
};

const config = sanityClient.config();

if (image?.asset?._ref === undefined) {
  console.error(`Image asset is not defined`);
  return null;
}
---

<SanityImage
  className={className}
  id={image.asset?._ref!}
  projectId={config.projectId}
  dataset={config.dataset}
  loading={loading || "lazy"}
  hotspot={image.hotspot}
  crop={image.crop}
  alt={alt}
  mode={mode}
  width={width}
  height={height}
  sizes={sizes}
  draggable="false"
/>
