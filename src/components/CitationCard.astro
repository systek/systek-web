---
import clsx from "clsx";
import type { Citation } from "../lib/sanity.types";

import Button from "./Button.astro";
import CardHeader from "./card-layout/CardHeader.astro";
import CardLayout from "./card-layout/CardLayout.astro";
import CitationSub from "./Citation.astro";

interface Props {
  title?: string;
  citation: Citation;
  class?: string;
}

const { title, citation, class: className } = Astro.props;
---

<CardLayout
  class={clsx("border-t mt-page border-stroke mx-grid pt-grid", className)}
>
  <CardHeader title={title}>
    <p class="max-w-[50rem] lg:max-w-[47.619vw] font-light text-xl-fluid">
      “{citation.text}”
    </p>
    <CitationSub
      class="mt-4 lg:mt-5"
      title={citation.name}
      subtitle={citation.position}
      image={citation.picture}
    />
    <Button class="mt-6 sm:mt-8" href="/tjenester/design-og-brukeropplevelse">
      Les om tjenesten
    </Button>
  </CardHeader>
</CardLayout>
