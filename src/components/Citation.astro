---
interface Props {
  title: string;
  subtitle: string;
  image: "todo";
  class?: string;
}

const { title, subtitle, image, class: className } = Astro.props;
---

<div class:list={["flex gap-3", className]}>
  <div class="size-10 lg:size-[2.381vw]">
    <picture>
      <img
        alt={image}
        class="object-cover w-full rounded-full aspect-square"
        src="/images/temp.png"
        draggable="false"
      />
    </picture>
  </div>

  <div>
    <p class="font-bold leading-tight text-sm-fluid text-text-secondary">
      {title}
    </p>
    <p class="leading-tight text-sm-fluid text-text-secondary">{subtitle}</p>
  </div>

  <summary
    class="items-center justify-between hidden py-4 cursor-pointer select-none gap-gutter group/summary"
  >
    <span class="text-md-fluid">{title}</span>
    <div
      class="border border-transparent p-1.75 rounded-full duration-250 transition-colors group-hover/summary:bg-yellow group-hover/summary:border-yellow-31"
    >
    </div>
  </summary>
</div>
