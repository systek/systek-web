---
import { vw } from "../utils/number";
import Image from "./Image.astro";
import type { SanityImageSource } from "@sanity/image-url/lib/types/types";

interface Props {
  title: string;
  subtitle: string;
  image: SanityImageSource; // todo: find sanity image type
  class?: string;
}

const { title, subtitle, image, class: className } = Astro.props;
---

<div class:list={["flex gap-3", className]}>
  <div class="size-10 lg:size-[2.381vw]">
    <picture>
      <Image
        class="w-full rounded-full aspect-square"
        image={image}
        alt={title}
        mode="cover"
        width={80}
        height={80}
        sizes={`(min-width: 105rem) ${vw(5)}, 5rem`}
      />
    </picture>
  </div>

  <div>
    <p class="font-bold leading-tight text-sm-fluid text-text-secondary">
      {title}
    </p>
    <p class="leading-tight text-sm-fluid text-text-secondary">{subtitle}</p>
  </div>
</div>
