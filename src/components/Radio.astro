---
interface Props {
  checked?: boolean;
  class?: string;
  label: string;
  name?: string;
  value: string;
}

const { label, class: className, ...props } = Astro.props;
---

<label class="flex items-center gap-3">
  <input
    type="radio"
    class:list={[
      "size-6 relative rounded-full bg-transparent appearance-none transition-colors",
      "shadow-[0_0_0_1px_theme(colors.grey.10)] hover:shadow-[0_0_0_2px_theme(colors.grey.10)]",
      "checked:bg-[#FF8C45]",
      "checked:after:content-[''] checked:after:absolute checked:after:rounded-full checked:after:size-2.5 checked:after:bg-grey-10 checked:after:left-1/2 checked:after:top-1/2 checked:after:-translate-x-1/2 checked:after:-translate-y-1/2",
      className,
    ]}
    {...props}
  />
  <span class="text-sm-fluid">{label}</span>
</label>
