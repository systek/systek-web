---
const links = [
  { text: "Arbeider", href: "/" },
  { text: "Tjenester", href: "/" },
  { text: "Jobb hos oss", href: "/" },
  { text: "Folka", href: "/" },
];
---

<header class="flex items-center justify-between gap-4 p-5">
  <img src="/images/systek-logo.svg" alt="Systek" />
  <nav>
    <ul class="flex gap-8">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="hover:underline">
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a class="bg-grey-10 text-off-white rounded-full px-5 py-2" href="/">
    Kontakt
  </a>
</header>
