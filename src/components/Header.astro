---
import Button from "./Button.astro";

const links = [
  { text: "Arbeider", href: "/" },
  { text: "Tjenester", href: "/" },
  { text: "Folka", href: "/" },
];
---

<div class="container-fluid">
  <header
    class="flex items-center justify-between gap-4 border-b border-grey-10/10 py-3"
  >
    <img src="/images/systek-logo.svg" alt="Systek" class="h-7" />
    <nav>
      <ul class="flex gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="hover:underline">
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button color="black" href="/">Jobbe her?</Button>
  </header>
</div>
