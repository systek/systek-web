---
import Button from "./Button.astro";

const links = [
  { text: "Arbeider", href: "/" },
  { text: "Tjenester", href: "/tjenester" },
  { text: "Folka", href: "/" },
];
---

<div data-header-observer class="hidden h-px md:block"></div>
<div class="md:sticky md:top-0 md:bg-background md:z-[var(--z-header)] px-grid">
  <header data-header class="flex items-center justify-between gap-4 py-3">
    <img src="/images/systek-logo.svg" alt="Systek" class="h-7" />
    <nav>
      <ul class="flex gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-sm-fluid hover:underline">
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button color="black" href="/">Jobbe her?</Button>
  </header>
</div>

<script>
  import {
    DOMLoaded,
    handleResize,
    hasViewportWidthChanged,
  } from "../utils/utils";
  import { setupHeader } from "../utils/header";

  DOMLoaded(() => {
    const header = document.querySelector("[data-header]") as HTMLElement;
    const sentinel = document.querySelector(
      "[data-header-observer]",
    ) as HTMLElement;

    setupHeader(header, sentinel);

    handleResize(() => {
      if (hasViewportWidthChanged()) {
        setupHeader(header, sentinel);
      }
    });
  });
</script>
