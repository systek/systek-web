---
import clsx from "clsx";

import Arrow from "./Arrow.astro";
import Button from "./Button.astro";

interface Props {
  active?: (typeof links)[number]["href"];
}

const { active } = Astro.props;

const links = [
  { text: "Arbeider", href: "/arbeider" },
  { text: "Tjenester", href: "/tjenester" },
  { text: "Folka", href: "/folka" },
  { text: "Om oss", href: "/om-oss" },
] as const;
---

<div class="sr-only focus-within:not-sr-only">
  <a
    class="top-gap left-gap p-grid text-xl-fluid absolute z-(--z-dialog) border border-grey-10 bg-white underline underline-offset-5"
    href="#main-content"
  >
    Gå til hovedinnhold
  </a>
</div>

<div data-header-sentinel class="hidden h-px md:block"></div>
<div class="px-grid md:sticky md:top-0 md:z-(--z-header) md:bg-background">
  <header data-header class="flex items-center justify-between gap-4 py-2.5">
    <a href="/">
      <img
        src="/images/systek-logo.svg"
        alt="Systek"
        class="w-[98px] lg:w-[5.833vw]"
      />
    </a>
    <nav class="hidden md:block">
      <ul class="flex gap-8 lg:gap-[1.9048vw]">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class={clsx(
                  "text-sm-fluid",
                  active === link.href
                    ? "regular-underline"
                    : "hover:regular-underline",
                )}
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button class="hidden md:block" color="black" href="/jobbe-her">
      Jobbe her?
    </Button>

    <Button data-modal-trigger class="md:hidden" color="black" size="md">
      Meny
    </Button>
  </header>

  <dialog
    class:list={[
      "p-grid modal-animate fixed top-auto bottom-0 z-(--z-dialog) flex h-full max-h-[calc(100%-var(--height-header))] w-full max-w-full flex-col bg-off-white backdrop:bg-transparent",
      "hidden", // class is toggled with JS
    ]}
    data-modal
  >
    <div class="flex justify-between">
      <Arrow position="topLeft" />
      <Arrow position="topRight" />
    </div>
    <nav class="flex flex-1 items-center justify-center">
      <ul class="gap-section py-grid flex flex-col">
        {
          links.map((link) => (
            <li class="text-center">
              <a
                href={link.href}
                class="text-4xl font-light hover:regular-underline"
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex justify-between">
      <Arrow position="middleLeft" />
      <Arrow position="middleRight" />
    </div>

    <Button class="my-grid mx-auto" color="black" href="/jobbe-her"
      >Jobbe her?</Button
    >

    <div class="flex justify-between">
      <Arrow position="bottomLeft" />
      <Arrow position="bottomRight" />
    </div>
  </dialog>
</div>

<script>
  import { DOMLoaded, handleResize, widthChecker } from "../utils/utils";
  import { setupHeader, openModal } from "../utils/header";

  DOMLoaded(() => {
    const header = document.querySelector("[data-header]") as HTMLElement;
    const sentinel = document.querySelector(
      "[data-header-sentinel]",
    ) as HTMLElement;
    const modal = document.querySelector("[data-modal]") as HTMLDialogElement;
    const modalTrigger = document.querySelector(
      "[data-modal-trigger]",
    ) as HTMLButtonElement;
    const hasViewportWidthChanged = widthChecker();

    setupHeader(header, sentinel);

    handleResize(() => {
      if (hasViewportWidthChanged()) {
        setupHeader(header, sentinel);
      }
    });

    modalTrigger.addEventListener("click", () => openModal(modal, header));
  });
</script>
