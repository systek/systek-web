---
import type { Work } from "../../lib/sanity.types";

interface Props {
  technologies: Work["technologies"];
}

const { technologies } = Astro.props;
---

<div class="my-grid">
  <p class="font-bold text-sm-fluid">Teknologier brukt gjennom arbeidet</p>
  <div class="flex flex-row gap-x-2 text-sm-fluid">
    {
      technologies?.map((item, index) => (
        <>
          <span>{item}</span>
          {index < technologies?.length - 1 && <span>·</span>}
        </>
      ))
    }
  </div>
</div>
