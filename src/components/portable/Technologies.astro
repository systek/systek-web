---
import type { Work } from "../../lib/sanity.types";

interface Props {
  title?: string;
  technologies: Work["technologies"];
}

const { technologies, title = "Teknologier brukt gjennom arbeidet" } =
  Astro.props;
---

<div class="my-grid">
  <p class="font-bold text-sm-fluid">{title}</p>
  <div class="flex flex-row flex-wrap gap-x-2 text-sm-fluid">
    {
      technologies?.map((item, index) => (
        <>
          <span>{item}</span>
          {index < technologies?.length - 1 && <span>·</span>}
        </>
      ))
    }
  </div>
</div>
