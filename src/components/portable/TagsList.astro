---
interface Props {
  node: {
    items?: string[];
  };
}

const {
  node: { items },
} = Astro.props;
---

<div class="my-grid">
  <h2 class="text-sm-fluid font-bold">Stikkord</h2>
  <div class="text-sm-fluid flex flex-wrap gap-x-2">
    {items?.map((item, index) => (
      <>
        <span>{item}</span>
        {index < items?.length - 1 && <span>·</span>}
      </>
    ))}
  </div>
</div>
