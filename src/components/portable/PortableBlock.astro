---
import type { Block, Props as $ } from "astro-portabletext/types";
import { usePortableText } from "astro-portabletext";

export type Props = $<Block>;

const props = Astro.props;
const { node, index, isInline, ...attrs } = props;
const styleIs = (style: string) => style === node.style;

const { getUnknownComponent } = usePortableText(node);

const UnknownStyle = getUnknownComponent();
---

{
  styleIs("h1") ? (
    <h1
      class="my-grid font-light text-4xl-fluid hyphens-auto lg:my-7"
      {...attrs}
    >
      <slot />
    </h1>
  ) : styleIs("h2") ||
    styleIs("h3") ||
    styleIs("h4") ||
    styleIs("h5") ||
    styleIs("h6") ? (
    <h2
      class="mt-7 mb-grid font-medium text-lg-fluid hyphens-auto lg:mt-10"
      {...attrs}
    >
      <slot />
    </h2>
  ) : styleIs("blockquote") ? (
    <blockquote {...attrs}>
      <slot />
    </blockquote>
  ) : styleIs("normal") ? (
    <p class="my-grid text-md-fluid hyphens-auto lg:my-7" {...attrs}>
      <slot />
    </p>
  ) : styleIs("ul") ? (
    <ul class="my-grid list-disc list-inside hyphens-auto lg:my-7" {...attrs}>
      <slot />
    </ul>
  ) : (
    <UnknownStyle {...props}>
      <slot />
    </UnknownStyle>
  )
}
