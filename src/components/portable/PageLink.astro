---
import type { PageBlock } from "../../lib/sanity.queries";
import Button from "../Button.astro";

interface Props {
  node: PageBlock<"internal-link">;
}

const {
  node: { page, text },
} = Astro.props;
---

{page && (
  <Button href={`/${page.slug.current}`} class="w-full" color="black" size="md">
    {text}
  </Button>
)}
