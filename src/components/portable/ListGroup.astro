---
const { node } = Astro.props;

const {
  title,
  items,
  _key: key,
} = node as { title?: string; items?: string[]; _key: string };
---

<div class="my-grid p-grid rounded-lg border border-stroke">
  {title && <p class="text-md-fluid hyphens-auto">{title}</p>}
  <ul id={key} class="ml-4 list-inside list-disc">
    {items?.map((item) => <li class="text-md-fluid hyphens-auto">{item}</li>)}
  </ul>
</div>
