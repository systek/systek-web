---
import SanityImage from "../SanityImage.astro";

// todo: infer type from sanity schema
interface Props {
  node: {
    _key: string;
    _type: "image";
    alt?: string;
    asset: {
      _ref: string;
      _type: "reference";
    };
    caption?: string;
  };
}

const { node } = Astro.props;
---

<div class="md:mr-[calc(50%-50vw)]">
  <figure class="my-section md:mr-5">
    <SanityImage
      node={node}
      class="w-full object-cover rounded-md md:rounded-lg aspect-[4/3] md:aspect-[2/1]"
    />
    <figcaption class="mt-gutter text-xs-fluid">
      {node.caption}
    </figcaption>
  </figure>
</div>
