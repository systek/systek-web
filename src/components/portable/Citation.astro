---
import type { Citation } from "../../lib/sanity.types";
import CitationSub from "../card/CitationSub.astro";

interface Props {
  node: Citation;
}

const { node: citation } = Astro.props;
---

<div>
  <p class="text-xl-fluid max-w-[50rem] font-light lg:max-w-[47.619vw]">
    «{citation.text}»
  </p>
  <CitationSub
    class="my-grid"
    title={citation.name}
    subtitle={citation.position}
    image={citation.picture}
  />
</div>
